{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "roblox-production-toolkit run request",
  "description": "Envelope accepted by tools-roblox.py run --request and validate --request. Subset of JSON Schema supported by tools-core.py.",
  "type": "object",
  "required": [
    "capability",
    "input"
  ],
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "input": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "approve": {
          "type": "boolean"
        },
        "overwrite": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        }
      }
    }
  }
}
