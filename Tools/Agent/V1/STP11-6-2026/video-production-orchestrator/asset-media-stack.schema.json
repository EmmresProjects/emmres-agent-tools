{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-media-stack.schema.json",
  "title": "Per-file media stack policy",
  "description": "Declares which technical checks apply to each media file during 'stack' runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string" },
        "aspect": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:5", "4:3", "2:1", "21:9", "3:4", "5:4"] },
        "max_duration_seconds": { "type": "number", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1000 },
        "require_audio": { "type": "boolean" },
        "captions": { "type": "string" },
        "loudness_target_lufs": { "type": "number", "minimum": -40, "maximum": -5 },
        "max_true_peak_dbfs": { "type": "number", "minimum": -30, "maximum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["probe", "duration", "aspect", "loudness", "captions", "size", "audio_present", "interlace", "alpha"]
      }
    }
  }
}
