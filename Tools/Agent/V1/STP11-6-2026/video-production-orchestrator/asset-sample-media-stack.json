{
  "name": "social-vertical-delivery",
  "description": "Checks applied to every vertical short before it leaves the studio.",
  "delivery": {
    "platform": "reels-vertical",
    "aspect": "9:16",
    "max_duration_seconds": 90,
    "max_bytes": 50000000,
    "require_audio": true,
    "captions": "captions-en.srt",
    "loudness_target_lufs": -14,
    "max_true_peak_dbfs": -1.0
  },
  "checks": ["probe", "aspect", "duration", "audio_present", "loudness", "captions", "size", "interlace"]
}
