{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-production-plan.schema.json",
  "title": "Video production plan",
  "description": "Plan manifest produced by tools-video-orchestrator.py plan and consumed by validate and run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "umbrella_name", "goal", "deliverables", "capabilities", "gates"],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "umbrella_name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "goal": { "type": "string", "minLength": 3 },
    "audience": { "type": "string" },
    "platform": { "type": "string" },
    "duration_seconds": { "type": "number", "minimum": 1, "maximum": 86400 },
    "created_at": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "string" },
        "format": { "type": "string", "enum": ["text", "markdown", "html", "catalog"] },
        "category_count": { "type": "integer", "minimum": 0 },
        "skill_count": { "type": "integer", "minimum": 0 }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["editable-source", "review-preview", "final-master", "package", "documentation"] },
          "status": { "type": "string", "enum": ["planned", "in-progress", "ready", "approved", "blocked"] },
          "path": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "phase", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 2 },
          "category": { "type": "string" },
          "family": { "type": "string" },
          "phase": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "type": "string", "enum": ["pending", "in-progress", "done", "blocked", "skipped"] },
          "requires_approval": { "type": "boolean" },
          "owner": { "type": "string" },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "blocking"],
        "properties": {
          "id": { "type": "string" },
          "check": { "type": "string", "enum": ["schema", "technical", "qa", "rights", "approval", "sync", "loudness", "captions"] },
          "blocking": { "type": "boolean" },
          "status": { "type": "string", "enum": ["open", "pass", "fail", "waived"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warn", "fail"] },
          "message": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    }
  }
}
