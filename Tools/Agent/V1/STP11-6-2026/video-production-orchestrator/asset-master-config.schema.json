{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-master-config.schema.json",
  "title": "Master delivery configuration",
  "description": "Controls tools-video-media.py digest_master_config and the orchestrator digest command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["master", "platforms"],
  "properties": {
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "fps": { "type": "number", "minimum": 1, "maximum": 240 },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 16, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 16, "maximum": 4320 }
          }
        },
        "color_space": { "type": "string", "enum": ["bt709", "bt2020", "srgb", "p3"] },
        "loudness_target_lufs": { "type": "number", "minimum": -40, "maximum": -5 }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$" }
    },
    "captions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "duration_limits": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 1 }
    },
    "compliance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "variants": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
