{
  "version": 1,
  "limits": {
    "max_entries": 5000,
    "max_depth": 16,
    "max_input_bytes": 262144,
    "max_text_bytes": 1048576,
    "max_file_bytes": 33554432,
    "max_transfer_bytes": 536870912,
    "max_archive_bytes": 536870912,
    "max_archive_members": 2000,
    "max_command_seconds": 60,
    "max_command_output_bytes": 65536,
    "max_retries": 2,
    "max_workflow_steps": 32
  },
  "protected_prefixes": ["uploads", "inputs", "sources", "originals", "deliverables", "final"],
  "cleanup_prefixes": ["scratch", "cache", "tmp", "build"],
  "excluded_names": [".git", ".workspace-control", "node_modules", ".venv"],
  "retention_days": 7,
  "download_allow_hosts": [],
  "offline": true,
  "enable_container_adapter": false,
  "enable_vm_adapter": false,
  "trusted_profiles": {
    "python-version": {"argv": ["python3", "--version"], "timeout_seconds": 8},
    "git-status": {"argv": ["git", "status", "--short"], "timeout_seconds": 10}
  }
}
