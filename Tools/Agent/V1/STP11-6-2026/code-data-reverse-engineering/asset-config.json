{"schema": "retool.config.v1", "description": "Default configuration for the code-data-reverse-engineering skill tool. Override with --config <path> on any command. All limits are enforced before and during work.", "limits": {"max_file_bytes": 268435456, "max_read_bytes": 67108864, "max_strings": 5000, "min_string_len": 4, "max_archive_entries": 20000, "max_extract_bytes": 268435456, "max_extract_ratio": 200, "max_nesting_depth": 4, "max_disasm_instructions": 4000, "max_cfg_instructions": 20000, "max_json_depth": 200, "max_sql_rows": 1000, "max_inventory_files": 20000, "max_xor_key_len": 24, "max_fuzz_cases": 200, "max_carve_hits": 500, "command_timeout_s": 30, "external_timeout_s": 20, "retries": 1, "retry_backoff_s": 0.25}, "output": {"default_format": "json", "hash_algorithms": ["sha256", "sha1", "md5"], "timestamp_utc": true}, "safety": {"read_only_default": true, "require_approval_flag": "--approve", "never_modify_inputs": true, "allowed_purposes": ["defensive", "interoperability", "research", "preservation"], "dynamic_execution": "plan-only", "external_tools": "allowlist-read-only"}, "external_tools": {"file": {"args": ["--brief", "{input}"], "kind": "identification", "dynamic": false}, "readelf": {"args": ["-h", "-S", "-l", "{input}"], "kind": "elf", "dynamic": false}, "objdump": {"args": ["-d", "--no-show-raw-insn", "{input}"], "kind": "disassembly", "dynamic": false}, "nm": {"args": ["-C", "{input}"], "kind": "symbols", "dynamic": false}, "strings": {"args": ["-a", "-n", "6", "{input}"], "kind": "strings", "dynamic": false}, "unzip": {"args": ["-l", "{input}"], "kind": "archive", "dynamic": false}, "tar": {"args": ["-tvf", "{input}"], "kind": "archive", "dynamic": false}, "gzip": {"args": ["-t", "{input}"], "kind": "compression", "dynamic": false}, "7z": {"args": ["l", "{input}"], "kind": "archive", "dynamic": false}, "binwalk": {"args": ["{input}"], "kind": "carving", "dynamic": false}, "radare2": {"args": ["-q", "-c", "i", "-c", "q", "{input}"], "kind": "binary", "dynamic": false}, "jadx": {"args": ["--no-res", "--single-class", "nonexistent.Skip", "{input}"], "kind": "android", "dynamic": false}, "gdb": {"args": ["--version"], "kind": "debugger", "dynamic": true}, "strace": {"args": ["-V"], "kind": "tracer", "dynamic": true}, "adb": {"args": ["devices"], "kind": "android-device", "dynamic": true}}, "paths": {"workspace_hint": "case-output", "note": "All runtime paths are user-supplied at invocation; nothing here is machine-specific."}}