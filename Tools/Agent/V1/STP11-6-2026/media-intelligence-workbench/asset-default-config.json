{
  "version": "1.0.0",
  "description": "Default configuration for the Media Intelligence Workbench Skill Tool. Copy it, edit, and pass with --config. Every path is resolved relative to the process working directory; no absolute paths are baked in.",
  "paths": {
    "input_dir": "media-input",
    "output_dir": "media-output",
    "cache_dir": "media-work",
    "plan_dir": "media-plans",
    "report_dir": "media-reports",
    "catalog": "asset-capability-catalog.json",
    "policies": "asset-policy-presets.json"
  },
  "policy": {
    "preset": "standard",
    "approval_mode": "prompt",
    "allow_overwrite_outputs": false,
    "publication_claims": false
  },
  "limits": {
    "max_files": 1000,
    "max_file_bytes": 4294967296,
    "max_pixels": 80000000,
    "max_audio_seconds": 14400,
    "max_video_frames": 600,
    "max_plan_units": 250,
    "max_text_chars": 2000000,
    "max_zip_entries": 2000,
    "max_uncompressed_ratio": 200
  },
  "runtime": {
    "stage_timeout_s": 900,
    "retries": 2,
    "retry_backoff_s": 1.5,
    "sample_fps": 1.0,
    "analysis_max_side_px": 640,
    "resume": true,
    "checkpoint_file": "media-work/checkpoints.json"
  },
  "analysis": {
    "scene_cut_threshold": 0.16,
    "flash_relative_change": 0.2,
    "silence_threshold_dbfs": -45.0,
    "confidence_review_threshold": 0.7,
    "confidence_escalate_threshold": 0.45,
    "language": "en",
    "transcript_mode": "clean-read",
    "timecode_format": "hh:mm:ss.mmm"
  },
  "providers": {
    "note": "No provider is contacted by default. The workbench measures media locally and emits prompts/payload contracts for a future skill's model or connector step. Set enabled=true and fill a local adapter only if you supply your own credentials outside this package.",
    "vision": {"enabled": false, "adapter": null, "model": null, "endpoint": null},
    "speech": {"enabled": false, "adapter": null, "model": null, "endpoint": null},
    "language": {"enabled": false, "adapter": null, "model": null, "endpoint": null}
  },
  "privacy": {
    "redact_paths_in_reports": false,
    "keep_originals_read_only": true,
    "store_raw_samples": false,
    "retention_days": 90
  }
}
