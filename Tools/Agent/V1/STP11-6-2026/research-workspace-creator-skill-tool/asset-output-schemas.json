{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_bundle_version": "1.0.0",
  "schemas": {
    "capability_result_envelope": {
      "type": "object",
      "required": [
        "status",
        "skill_tool",
        "run_id",
        "timestamp_utc",
        "capability",
        "role_execution",
        "domain_result",
        "truthfulness_accounting",
        "provenance",
        "quality_evaluation",
        "artifacts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "approval_required", "validation_error", "recovered", "error"]
        },
        "skill_tool": {"type": "string"},
        "run_id": {"type": "string"},
        "timestamp_utc": {"type": "string"},
        "capability": {
          "type": "object",
          "required": ["global_id", "slug", "name", "category_id", "category_slug", "role_slug"]
        },
        "role_execution": {"type": "object"},
        "domain_result": {"type": "object"},
        "truthfulness_accounting": {
          "type": "object",
          "required": [
            "network_used",
            "searches_executed",
            "downloads_completed",
            "installations_performed",
            "files_created",
            "subprocesses_executed"
          ]
        },
        "provenance": {"type": "object"},
        "quality_evaluation": {"type": "object"},
        "artifacts": {"type": "array"}
      }
    },
    "provenance_entry": {
      "type": "object",
      "required": [
        "entry_id",
        "run_id",
        "timestamp_utc",
        "action",
        "source_refs",
        "output_refs",
        "sha256"
      ],
      "properties": {
        "entry_id": {"type": "string"},
        "run_id": {"type": "string"},
        "timestamp_utc": {"type": "string"},
        "action": {"type": "string"},
        "source_refs": {"type": "array"},
        "output_refs": {"type": "array"},
        "sha256": {"type": "string"}
      }
    },
    "workflow_definition": {
      "type": "object",
      "required": ["workflow_name", "steps"],
      "properties": {
        "workflow_name": {"type": "string"},
        "description": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step_id", "capability"],
            "properties": {
              "step_id": {"type": "string"},
              "capability": {"type": "string"},
              "depends_on": {"type": "array"},
              "params": {"type": "object"}
            }
          }
        }
      }
    },
    "quality_scorecard": {
      "type": "object",
      "required": [
        "overall_score",
        "grade",
        "dimensions",
        "passed_gate"
      ],
      "properties": {
        "overall_score": {"type": "number"},
        "grade": {"type": "string"},
        "dimensions": {"type": "object"},
        "passed_gate": {"type": "boolean"}
      }
    }
  }
}
