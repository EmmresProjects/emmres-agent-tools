{
  "schema_version": "1.0",
  "description": "Reusable bounded worker roles used by Worker Factory, team assembly, and mission scheduling. All allowed actions are local deterministic runtime operations.",
  "roles": {
    "planner": {
      "mission": "Decompose goals, expose dependencies, and produce a testable execution plan.",
      "inputs": ["goal", "constraints", "tasks"],
      "outputs": ["work-breakdown", "dependency-graph", "milestones"],
      "allowed_actions": ["normalize", "validate", "merge"],
      "quality_gates": ["acyclic-dependencies", "acceptance-criteria-present"],
      "escalation_rules": ["unknown-dependency", "conflicting-constraints"],
      "completion_criteria": ["all tasks assigned", "critical path computed"],
      "risk_tolerance": "low"
    },
    "researcher": {
      "mission": "Prepare distinct local evidence units without redundant or external collection.",
      "inputs": ["question", "source-scope", "local-fragments"],
      "outputs": ["normalized-fragments", "evidence-gaps"],
      "allowed_actions": ["normalize", "summarize", "compare"],
      "quality_gates": ["source-distinctness", "claim-traceability"],
      "escalation_rules": ["missing-evidence", "contradictory-fragments"],
      "completion_criteria": ["all assigned fragments normalized"],
      "risk_tolerance": "low"
    },
    "analyst": {
      "mission": "Compute bounded scores, comparisons, and aggregate metrics from local inputs.",
      "inputs": ["normalized-fragments", "metric-definitions"],
      "outputs": ["scores", "comparisons", "aggregate"],
      "allowed_actions": ["score", "compare", "aggregate"],
      "quality_gates": ["numeric-input-validation", "deterministic-output"],
      "escalation_rules": ["non-numeric-input", "budget-exceeded"],
      "completion_criteria": ["all metric outputs produced"],
      "risk_tolerance": "medium"
    },
    "reviewer": {
      "mission": "Verify completeness, consistency, and acceptance criteria before handoff.",
      "inputs": ["artifacts", "acceptance-criteria", "evidence"],
      "outputs": ["checks", "exceptions", "approval-recommendation"],
      "allowed_actions": ["validate", "compare"],
      "quality_gates": ["independent-from-producer", "all-checks-evidenced"],
      "escalation_rules": ["failed-check", "missing-provenance"],
      "completion_criteria": ["verification report emitted"],
      "risk_tolerance": "low"
    },
    "integrator": {
      "mission": "Merge compatible partial outputs into one coherent structured deliverable.",
      "inputs": ["dependency-results", "conflict-rules"],
      "outputs": ["unified-result", "minority-evidence"],
      "allowed_actions": ["merge", "aggregate", "validate"],
      "quality_gates": ["no-unresolved-dependency", "schema-validated-result"],
      "escalation_rules": ["incompatible-outputs", "merge-conflict"],
      "completion_criteria": ["unified result passes schema"],
      "risk_tolerance": "medium"
    },
    "safety-officer": {
      "mission": "Classify risk, enforce approval gates, and record a local audit trail.",
      "inputs": ["policy", "requested-actions", "approval-record"],
      "outputs": ["risk-classification", "approval-decision", "audit-events"],
      "allowed_actions": ["validate"],
      "quality_gates": ["no-shell", "no-network", "no-arbitrary-code"],
      "escalation_rules": ["missing-approval", "expired-approval", "scope-mismatch"],
      "completion_criteria": ["sensitive actions approved or blocked"],
      "risk_tolerance": "critical"
    }
  },
  "defaults": {
    "capacity": 2,
    "ephemeral": true,
    "memory_scope": "task-local",
    "handoff": "explicit-validated-packet"
  }
}
