{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataWebAppInteractionSchemas",
  "version": "1.0.0",
  "definitions": {
    "SkillInvocationRequest": {
      "type": "object",
      "required": ["skill"],
      "properties": {
        "skill": {
          "type": "string",
          "description": "Skill ID (e.g. cat01-01), slug (e.g. action-authorization-gatekeeper), or exact skill name."
        },
        "input_path": {
          "type": "string",
          "description": "Optional input file or directory path."
        },
        "output_path": {
          "type": "string",
          "description": "Optional output file path for structured result."
        },
        "params": {
          "type": "object",
          "description": "Capability-specific structured parameters."
        },
        "approve": {
          "type": "boolean",
          "default": false,
          "description": "Explicit human approval flag for consequential or mutating actions."
        },
        "approval_note": {
          "type": "string",
          "description": "Scope and reason attached to explicit human approval."
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "SkillResultEnvelope": {
      "type": "object",
      "required": [
        "ok",
        "status",
        "skill_id",
        "slug",
        "skill_name",
        "category_number",
        "category_name",
        "observation_mode",
        "timestamp_utc",
        "data",
        "warnings",
        "limitations",
        "provenance"
      ],
      "properties": {
        "ok": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": ["completed", "approval_required", "human_handoff_required", "validation_error", "blocked_by_policy", "failed"]
        },
        "skill_id": {"type": "string"},
        "slug": {"type": "string"},
        "skill_name": {"type": "string"},
        "category_number": {"type": "integer", "minimum": 1, "maximum": 33},
        "category_name": {"type": "string"},
        "observation_mode": {
          "type": "string",
          "enum": ["directly_observed", "tested", "simulated", "inferred", "blocked", "unverified"]
        },
        "timestamp_utc": {"type": "string"},
        "duration_ms": {"type": "number"},
        "data": {"type": "object"},
        "metrics": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "redactions_applied": {"type": "integer", "minimum": 0},
        "provenance": {
          "type": "object",
          "properties": {
            "input_path": {"type": ["string", "null"]},
            "input_sha256": {"type": ["string", "null"]},
            "config_path": {"type": "string"},
            "engine_module": {"type": "string"},
            "python_version": {"type": "string"}
          }
        }
      }
    },
    "WorkflowDefinition": {
      "type": "object",
      "required": ["workflow_name", "steps"],
      "properties": {
        "workflow_name": {"type": "string"},
        "stop_on_error": {"type": "boolean", "default": true},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["step_id", "skill"],
            "properties": {
              "step_id": {"type": "string"},
              "skill": {"type": "string"},
              "input_path": {"type": "string"},
              "params": {"type": "object"},
              "idempotent": {"type": "boolean", "default": true},
              "consequential": {"type": "boolean", "default": false}
            }
          }
        }
      }
    },
    "LedgerEntry": {
      "type": "object",
      "required": ["sequence", "timestamp_utc", "step_id", "skill_id", "observed_state", "action_taken", "resulting_state", "entry_hash"],
      "properties": {
        "sequence": {"type": "integer"},
        "timestamp_utc": {"type": "string"},
        "step_id": {"type": "string"},
        "skill_id": {"type": "string"},
        "observed_state": {"type": "string"},
        "action_taken": {"type": "string"},
        "resulting_state": {"type": "string"},
        "uncertainty": {"type": "string"},
        "next_safe_step": {"type": "string"},
        "previous_hash": {"type": "string"},
        "entry_hash": {"type": "string"}
      }
    }
  }
}
