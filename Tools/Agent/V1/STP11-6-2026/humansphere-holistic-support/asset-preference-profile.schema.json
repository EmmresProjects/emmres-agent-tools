{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "humansphere.preference-profile.schema.json",
  "title": "HumanSphere consent-based preference profile",
  "description": "Opt-in personalization record. Every field is user-stated; nothing is inferred. Validated by tools-plan-builder.py using a documented JSON Schema subset (type, required, properties, enum, items, additionalProperties, minimum, maximum, minItems, maxItems, pattern, minLength, maxLength).",
  "type": "object",
  "required": ["schema", "consent", "identity", "preferences", "memory"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^humansphere\\.preference-profile/"
    },
    "consent": {
      "type": "object",
      "required": ["granted"],
      "additionalProperties": true,
      "properties": {
        "granted": { "type": "boolean" },
        "granted_at": { "type": "string" },
        "scope": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20
        },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "description": "Only values the user explicitly supplied are stored.",
      "properties": {
        "name_used": { "type": "string", "maxLength": 120 },
        "pronouns": { "type": "string", "maxLength": 60 },
        "age_band": {
          "type": "string",
          "enum": ["", "under-13", "13-17", "18-24", "25-34", "35-49", "50-64", "65-plus", "not-stated"]
        },
        "languages": {
          "type": "array",
          "items": { "type": "string", "maxLength": 40 },
          "maxItems": 10
        },
        "roles": {
          "type": "array",
          "items": { "type": "string", "maxLength": 40 },
          "maxItems": 10
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tone": {
          "type": "string",
          "enum": ["gentle", "neutral", "direct", "energetic", "formal", "playful"]
        },
        "directness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "format": { "type": "string", "enum": ["brief", "structured", "detailed"] },
        "reading_level": { "type": "string", "enum": ["plain", "standard", "advanced"] },
        "humor": {
          "type": "string",
          "enum": ["none", "gentle", "dry", "playful", "absurd", "witty"]
        },
        "examples": { "type": "boolean" },
        "max_list_items": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "needs": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 20 },
        "sensory": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 20 },
        "reading": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 20 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "region": { "type": "string", "maxLength": 60 },
        "timezone": { "type": "string", "maxLength": 60 },
        "goals": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 20 },
        "limits": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 20 },
        "values": { "type": "array", "items": { "type": "string", "maxLength": 120 }, "maxItems": 20 }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "never_do": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 20 },
        "topics_to_avoid": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "maxItems": 20
        },
        "require_approval_for": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "maxItems": 20
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": true,
      "description": "Fictional style only. Must never assert a real identity, licence, or relationship.",
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "maxLength": 80 },
        "voice": { "type": "string", "maxLength": 200 },
        "values": { "type": "array", "items": { "type": "string", "maxLength": 120 }, "maxItems": 10 },
        "fiction_disclosure": {
          "type": "string",
          "enum": ["always", "on-request", "when-roleplay-starts"]
        }
      }
    },
    "memory": {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": true,
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "additionalProperties": true,
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 120 },
              "value": { "type": "string", "maxLength": 1000 },
              "added_at": { "type": "string" },
              "source": {
                "type": "string",
                "enum": ["user-stated", "user-corrected", "user-imported"]
              }
            }
          }
        }
      }
    }
  }
}
