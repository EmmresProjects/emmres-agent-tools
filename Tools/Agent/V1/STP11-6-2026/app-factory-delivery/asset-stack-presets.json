            "team_skill": 5,
            "performance": 4,
            "security": 4,
            "accessibility": 3,
            "maintainability": 3,
            "cost": 5,
            "ecosystem": 4
          }
        },
        {
          "key": "lit-web-components",
          "label": "Lit web components",
          "notes": "Standards-based components with reactive templates and Shadow DOM.",
          "scores": {
            "platform_fit": 4,
            "team_skill": 3,
            "performance": 5,
            "security": 4,
            "accessibility": 4,
            "maintainability": 4,
            "cost": 5,
            "ecosystem": 3
          }
        },
        {
          "key": "preact-vite",
          "label": "Preact with Vite",
          "notes": "Tiny component runtime with bundling; needs a build step.",
