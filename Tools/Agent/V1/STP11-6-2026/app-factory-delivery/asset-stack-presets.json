{
  "schema_version": "1.0",
  "name": "app-factory-delivery-presets",
  "description": "Delivery presets: toolchain expectations, artifact checks, bounded verification commands and weighted stack-selection candidates per platform family.",
  "criteria": [
    {
      "id": "platform_fit",
      "label": "Platform fit",
      "default_weight": 0.2,
      "description": "How directly the option satisfies the requested platform and delivery target."
    },
    {
      "id": "team_skill",
      "label": "Team skill",
      "default_weight": 0.15,
      "description": "Availability of the requested language and skills on the team, and learning cost."
    },
    {
      "id": "performance",
      "label": "Performance",
      "default_weight": 0.15,
      "description": "Runtime performance, startup cost, memory and bundle footprint."
    },
    {
      "id": "security",
      "label": "Security",
      "default_weight": 0.15,
      "description": "Default platform hardening, dependency surface and isolation options."
    },
    {
      "id": "accessibility",
      "label": "Accessibility",
      "default_weight": 0.1,
      "description": "Accessibility support and tooling available in the ecosystem."
    },
    {
      "id": "maintainability",
      "label": "Maintainability",
      "default_weight": 0.1,
      "description": "Typing, testing story, module boundaries and upgrade path."
    },
    {
      "id": "cost",
      "label": "Cost",
      "default_weight": 0.05,
      "description": "Hosting, licensing and build cost within limits."
    },
    {
      "id": "ecosystem",
      "label": "Ecosystem",
      "default_weight": 0.1,
      "description": "Maturity of libraries, documentation, LTS policy and hiring pool."
    }
  ],
  "presets": {
    "web-static": {
      "label": "Static web application",
      "platform": "web",
      "component_set": "web-static",
      "languages": [
        "html",
        "css",
        "javascript"
      ],
      "catalog_categories": [
        "full-stack-web-application-engineering",
        "ui-ux-accessibility-and-design-systems",
        "cloud-containers-and-platform-engineering"
      ],
      "required_executables": [
        "python3"
      ],
      "optional_executables": [
        "node"
      ],
      "artifact_checks": [
        {
          "id": "entry-html",
          "label": "HTML entry point present",
          "glob": "*.html",
          "severity": "major"
        },
        {
          "id": "readme",
          "label": "README with run instructions",
          "glob": "README*",
          "severity": "minor"
        }
      ],
      "verification": [
        {
          "id": "html-parse",
          "label": "Parse every HTML entry point",
          "command": "python3 -c \"import glob,html.parser;fs=sorted(set(glob.glob('*.html')+glob.glob('**/*.html',recursive=True)));assert fs,'no html files found';[html.parser.HTMLParser().feed(open(f,encoding='utf-8').read()) for f in fs];print('parsed',len(fs),'html files')\"",
          "required": true,
          "timeout": 60
        },
        {
          "id": "node-check",
          "label": "Syntax-check the app script",
          "command": "node --check app.js",
          "required": false,
          "timeout": 60
        }
      ],
      "candidates": [
        {
          "key": "vanilla-js",
          "label": "Vanilla HTML/CSS/JS",
          "notes": "No build step, smallest surface, works from any static host.",
          "scores": {
