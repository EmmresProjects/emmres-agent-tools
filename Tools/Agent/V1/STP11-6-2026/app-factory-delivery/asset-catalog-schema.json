{
  "$comment": "Schema for agent-skill-catalog dataset files. Validated by the built-in subset validator in tools-catalog-core.py, which supports: type, required, properties, items, pattern, minLength, minimum, enum, minItems, maxItems. Semantic checks (unique ids/slugs, category references, stats consistency) run on top of this schema.",
  "type": "object",
  "required": ["schema_version", "catalog", "categories", "skills"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "catalog": {
      "type": "object",
      "required": ["title", "stats"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "source_format": { "type": "string", "enum": ["text", "markdown", "html", ""] },
        "schema": { "type": "string" },
        "stats": {
          "type": "object",
          "required": ["categories", "skills", "appendices"],
          "properties": {
            "categories": { "type": "integer", "minimum": 0 },
            "skills": { "type": "integer", "minimum": 0 },
            "appendices": { "type": "integer", "minimum": 0 }
          }
        },
        "preamble": { "type": "array", "items": { "type": "string" } }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "slug"],
        "properties": {
          "id": { "type": "string", "pattern": "^cat-[0-9]{2,}$" },
          "number": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category_id", "number", "name", "slug", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^skill-[0-9]{3,}$" },
          "category_id": { "type": "string", "pattern": "^cat-[0-9]{2,}$" },
          "number": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "appendices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "letter", "title", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^appendix-[a-z]$" },
          "letter": { "type": "string", "pattern": "^[A-Z]$" },
          "title": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
