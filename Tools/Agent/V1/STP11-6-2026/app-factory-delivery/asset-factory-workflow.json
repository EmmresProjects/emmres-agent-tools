{
  "schema_version": "1.0",
  "name": "app-factory-delivery",
  "display_name": "App Factory Delivery Orchestrator",
  "purpose": "Catalog-driven app-factory workflow: intake, architecture, test strategy, security review, packaging and release-readiness gating for any requested language, framework, builder or delivery target.",
  "stage_order": ["requirements", "architecture", "tests", "security", "packaging", "readiness"],
  "stages": [
    {
      "id": "requirements",
      "title": "Intake: Requirements to Backlog",
      "order": 1,
      "requires": [],
      "produces": ["requirements-backlog.md", "requirements-backlog.json"],
      "catalog_skills": ["requirements-to-backlog-engineer", "multi-platform-product-planner"],
      "gate": {
        "weight": 18,
        "criteria": [
          {"id": "stories_present", "label": "At least one user story is captured", "severity": "blocker"},
          {"id": "acceptance_criteria_complete", "label": "Every story has at least two acceptance criteria", "severity": "blocker"},
          {"id": "nfr_coverage", "label": "At least three non-functional categories are addressed", "severity": "major"},
          {"id": "priorities_assigned", "label": "Every story carries a priority", "severity": "minor"},
          {"id": "assumptions_tracked", "label": "Assumptions and open questions are recorded", "severity": "minor"}
        ]
      }
    },
    {
      "id": "architecture",
      "title": "Design: Architecture and Stack Decision",
      "order": 2,
      "requires": ["requirements"],
      "produces": ["architecture-decision.md", "architecture-decision.json"],
      "catalog_skills": ["universal-app-solution-architect", "technology-stack-selector"],
      "gate": {
        "weight": 18,
        "criteria": [
          {"id": "stack_decision_ranked", "label": "Candidate stacks are scored and ranked with explicit weights", "severity": "blocker"},
          {"id": "components_defined", "label": "At least three components are defined with responsibilities", "severity": "blocker"},
          {"id": "data_and_storage", "label": "Data model and storage approach are stated", "severity": "major"},
          {"id": "deployment_target", "label": "Deployment target and runtime are stated", "severity": "major"},
          {"id": "risks_with_mitigation", "label": "At least three risks carry a mitigation", "severity": "major"},
          {"id": "adr_recorded", "label": "An architecture decision record is written", "severity": "minor"},
          {"id": "version_policy", "label": "Toolchain and version policy is recorded", "severity": "minor"}
        ]
      }
    },
    {
      "id": "tests",
      "title": "Verify: Test Strategy and Coverage Map",
      "order": 3,
      "requires": ["requirements"],
      "produces": ["test-strategy.md", "test-strategy.json"],
      "catalog_skills": ["test-strategy-architect", "unit-test-engineer", "integration-test-engineer", "end-to-end-test-engineer"],
      "gate": {
        "weight": 18,
        "criteria": [
          {"id": "criteria_mapped", "label": "Every acceptance criterion maps to at least one test case", "severity": "blocker"},
          {"id": "levels_covered", "label": "At least three test levels are planned", "severity": "major"},
          {"id": "cross_cutting_suite", "label": "Security, accessibility, performance and recovery tests are planned", "severity": "major"},
          {"id": "data_and_isolation", "label": "Test data and environment isolation are described", "severity": "minor"},
          {"id": "regression_policy", "label": "Defect-to-regression policy is stated", "severity": "minor"}
        ]
      }
    },
    {
      "id": "security",
      "title": "Verify: Security and Privacy Review",
      "order": 4,
      "requires": ["requirements"],
      "produces": ["security-review.md", "security-review.json"],
      "catalog_skills": ["threat-modeling-facilitator", "secrets-and-key-management-engineer", "privacy-by-design-engineer"],
      "gate": {
        "weight": 20,
        "criteria": [
          {"id": "no_open_critical_high", "label": "No critical or high control is failing or unevidenced", "severity": "blocker"},
          {"id": "evidence_complete", "label": "Every applicable control has recorded evidence", "severity": "major"},
          {"id": "medium_tracked", "label": "Every failing medium control carries a note or owner", "severity": "minor"},
          {"id": "privacy_disclosure", "label": "Data collected, retention and consent paths are documented", "severity": "major"},
          {"id": "secrets_hygiene", "label": "No credential material is stored in the project tree", "severity": "blocker"}
        ]
      }
    },
    {
      "id": "packaging",
      "title": "Deliver: Packaging, Provenance and Handoff",
      "order": 5,
      "requires": ["architecture"],
      "produces": ["release-manifest.json", "release-notes.md", "checksums-sha256.txt"],
      "catalog_skills": ["release-packaging-engineer", "semantic-versioning-and-changelog-manager", "artifact-handoff-and-packaging-manager"],
      "gate": {
        "weight": 16,
        "criteria": [
          {"id": "manifest_complete", "label": "Every project file within limits is hashed into the manifest", "severity": "blocker"},
          {"id": "version_valid", "label": "Release version is valid semver and consistent with the change set", "severity": "blocker"},
          {"id": "changelog_generated", "label": "Changelog lists the changes of this release", "severity": "major"},
          {"id": "sbom_written", "label": "Component inventory is written", "severity": "major"},
          {"id": "sensitive_files", "label": "No credential-like or oversize files entered the release set", "severity": "blocker"},
          {"id": "rollback_notes", "label": "Rollback or recovery notes are present", "severity": "minor"}
        ]
      }
    },
    {
      "id": "readiness",
      "title": "Operate: Release Readiness Gate",
      "order": 6,
      "requires": ["requirements", "architecture", "tests", "security", "packaging"],
      "produces": ["readiness-report.md", "readiness-report.json"],
      "catalog_skills": ["quality-gate-controller", "capability-boundary-and-escalation-manager", "app-factory-orchestrator"],
      "gate": {
        "weight": 10,
        "criteria": [
          {"id": "stages_complete", "label": "Every required stage completed with a passing gate", "severity": "blocker"},
          {"id": "artifacts_stable", "label": "Stage artifacts still match their recorded checksums", "severity": "blocker"},
          {"id": "verification_current", "label": "A verification run exists and passed for the current tree", "severity": "blocker"},
          {"id": "no_blockers", "label": "No blocker-severity criterion remains open", "severity": "blocker"},
          {"id": "advisories_reviewed", "label": "Advisory findings were reviewed and accepted", "severity": "minor"}
        ]
      }
    }
  ],
  "readiness": {
    "severity_weight": {"blocker": 5, "major": 3, "minor": 1},
    "pass_threshold": 80,
    "strict_threshold": 95,
    "verification_share": 0.15,
    "require_verification": true
  },
  "limits": {
    "max_input_bytes": 2000000,
    "max_request_chars": 8000,
    "max_stories": 400,
    "max_files_scanned": 5000,
    "max_file_bytes_hashed": 67108864,
    "max_total_bytes_hashed": 536870912,
    "max_artifacts_per_stage": 8,
    "excluded_dir_names": [".git", ".hg", ".svn", "node_modules", "venv", ".venv", "dist", "build", "out", "target", "__pycache__", ".cache", ".pytest_cache", ".gradle", "Pods", ".next", ".nuxt"],
    "sensitive_file_patterns": ["(^|/)\\.env($|\\.)", "(^|/)id_(rsa|dsa|ecdsa|ed25519)($|\\.)", "(^|/).*\\.(pem|pfx|p12|jks|keystore|key)$", "(^|/)credentials(\\.|$)", "(^|/)\\.npmrc$", "(^|/)\\.netrc$", "(^|/)secring\\.gpg$"],
    "verify": {
      "per_command_timeout_seconds": 300,
      "total_timeout_seconds": 900,
      "max_retries": 2,
      "max_commands": 12,
      "max_output_chars": 6000,
      "allowed_executables": ["python3", "python", "node", "npm", "npx", "pytest", "git", "make", "java", "javac", "gradle", "flutter", "dart", "dotnet", "cargo", "go", "gcc", "cc", "cmake", "docker", "mvn", "./gradlew", "./mvnw"]
    }
  },
  "templates": {
    "acceptance_criteria": [
      "Given {persona} is authorized for {feature}, when the primary action of \"{title}\" is performed, then the expected outcome is observable and persisted exactly once.",
      "Given invalid, empty or oversized input for {feature}, when the action of \"{title}\" is submitted, then it is rejected with a field-level error and no partial state change.",
      "Given a successful action in {feature}, when the result is reopened or re-read, then the displayed data matches the submitted data."
    ],
    "personas": ["end user", "operations staff", "administrator", "integrating developer"],
    "priority_rules": [
      {"priority": "P0", "keywords": ["must", "critical", "security", "payment", "login", "compliance", "blocker"]},
      {"priority": "P1", "keywords": ["should", "performance", "accessibility", "offline", "report"]},
      {"priority": "P2", "keywords": []}
    ],
    "nfr_keywords": {
      "security": ["security", "secure", "auth", "authentication", "authorization", "encrypt", "permission", "rbac", "token"],
      "privacy": ["privacy", "personal data", "consent", "gdpr", "retention", "anonym"],
      "performance": ["performance", "latency", "throughput", "fast", "response time", "p95", "load"],
      "accessibility": ["accessibility", "wcag", "screen reader", "keyboard", "contrast", "a11y"],
      "reliability": ["reliability", "uptime", "failover", "retry", "resilience", "recovery", "backup"],
      "observability": ["observability", "logging", "metrics", "tracing", "monitoring", "alert"],
      "scalability": ["scale", "scalable", "concurrency", "shard", "queue", "capacity"],
      "maintainability": ["maintain", "refactor", "modular", "documentation", "lint", "typing"],
      "localization": ["localization", "localisation", "i18n", "l10n", "translation", "locale"],
      "offline": ["offline", "local-first", "sync", "conflict"],
      "cost": ["cost", "budget", "pricing", "spend"],
      "compatibility": ["browser", "compatibility", "legacy", "version", "migration", "device"]
    },
    "architecture_sections": [
      "Context and drivers",
      "Chosen stack and rejected alternatives",
      "Components and responsibilities",
      "Data model and storage",
      "Interfaces and contracts",
      "Deployment and runtime",
      "Version and toolchain policy",
      "Risks and mitigations",
      "Milestones and acceptance checks"
    ],
    "rules": [
      "Never claim a project builds, runs, passes tests or is store-ready unless the corresponding check actually ran.",
      "Never mix syntax, APIs, build files or documentation from incompatible versions; resolve the target version first.",
      "Preserve user code and edits; make the smallest correct change and add regression coverage for repaired defects.",
      "Use real project files and environments; do not replace missing inputs with invented production data.",
      "Treat security, privacy, accessibility, licensing and platform policy as design constraints, not final checks."
    ],
    "test_levels": [
      {"id": "unit", "label": "Unit", "focus": "pure logic, validation rules, formatting"},
      {"id": "component", "label": "Component", "focus": "rendered or serialized unit with dependencies stubbed"},
      {"id": "integration", "label": "Integration", "focus": "real services, storage, queues and adapters"},
      {"id": "contract", "label": "Contract", "focus": "provider/consumer schema compatibility"},
      {"id": "e2e", "label": "End-to-end", "focus": "critical user journey through the delivered artifact"},
      {"id": "performance", "label": "Performance", "focus": "latency, throughput and resource ceilings"},
      {"id": "security", "label": "Security", "focus": "authorization, injection, secrets, dependency risk"},
      {"id": "accessibility", "label": "Accessibility", "focus": "keyboard, semantics, contrast, announcements"},
      {"id": "recovery", "label": "Recovery", "focus": "interrupted operations, retries, rollback, restore"}
    ]
  }
}
