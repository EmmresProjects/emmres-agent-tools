  "fallacy_patterns": [
    {
      "name": "false-dilemma",
      "pattern": "\\b(either .{1,60} or|only two (options|choices|ways))\\b",
      "severity": "medium"
    },
    {
      "name": "appeal-to-popularity",
      "pattern": "\\b(everyone|most people|everybody|nobody) (knows|agrees|says|thinks|uses)\\b",
      "severity": "medium"
    },
    {
      "name": "appeal-to-authority-without-source",
      "pattern": "\\b(experts say|scientists say|studies show|research shows)\\b(?!.*(http|\\[|source|according))",
      "severity": "medium"
    },
    {
      "name": "slippery-slope",
      "pattern": "\\b(if we (allow|let|do|start)|once we)\\b.{0,80}\\b(then|will (soon )?lead|eventually)\\b",
      "severity": "medium"
    },
    {
      "name": "correlation-as-causation",
      "pattern": "\\b(because|since|therefore|so)\\b.{0,60}\\b(correlat|associated with|linked to)\\b|\\b(correlat\\w*)\\b.{0,60}\\b(therefore|so|proves|means)\\b",
      "severity": "high"
    },
    {
      "name": "circular-reasoning",
      "pattern": "\\bbecause (it|that|this) is (true|right|correct|valid)\\b",
      "severity": "high"
    },
    {
      "name": "non-sequitur-conclusion",
      "pattern": "\\b(so|therefore|thus|hence) (it )?(must|has to|should) be (true|right|correct|best)\\b",
      "severity": "medium"
    },
    {
      "name": "appeal-to-tradition",
      "pattern": "\\b(we have always|it has always been|that's how it has always)\\b",
      "severity": "low"
    },
    {
      "name": "ad-hominem-or-motive",
      "pattern": "\\b(only (someone|a person|people) who (is|are) (stupid|lazy|biased)|they just want)\\b",
      "severity": "medium"
    }
  ],
  "pii_patterns": [
    {
      "name": "email-address",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "severity": "high"
    },
    {
      "name": "phone-number",
      "pattern": "(?<!\\d)(\\+?\\d{1,3}[ -]?)?(\\(?\\d{2,4}\\)?[ -]?)\\d{3,4}[ -]?\\d{3,4}(?!\\d)",
      "severity": "high"
    },
    {
      "name": "ipv4-address",
      "pattern": "(?<!\\d)(?:\\d{1,3}\\.){3}\\d{1,3}(?!\\d)",
      "severity": "medium"
    },
    {
      "name": "national-id-like",
      "pattern": "(?<!\\d)\\d{3}-\\d{2}-\\d{4}(?!\\d)|(?<!\\d)\\d{3}-\\d{3}-\\d{3}-\\d{3}(?!\\d)",
      "severity": "high"
    },
    {
      "name": "card-number-like",
      "pattern": "(?<!\\d)(?:\\d[ -]?){13,19}(?!\\d)",
      "severity": "high",
      "luhn": true
    },
    {
      "name": "secret-assignment",
      "pattern": "(?i)\\b(password|passwd|secret|token|api[_ -]?key|private[_ -]?key)\\b\\s*[:=]\\s*\\S+",
      "severity": "high"
    }
  ],
