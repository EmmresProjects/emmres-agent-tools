{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Work Splitter continuation state",
  "description": "Schema subset enforced by tools-workflow-engine.validate_schema on --kind state validation.",
  "type": "object",
  "required": ["schema_version", "project", "plan", "completed_stages", "current_stage", "checkpoints", "history"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["goal", "requirements"],
      "properties": {
        "goal": {"type": "string", "minLength": 3},
        "requirements": {"type": "array", "items": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}}}
      }
    },
    "plan": {
      "type": "object",
      "required": ["requested_stages", "stages"],
      "properties": {
        "requested_stages": {"type": "integer", "minimum": 1, "maximum": 24},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["number", "label"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "label": {"type": "string", "pattern": "^Stage \\d+ of \\d+$"},
              "includes_assembly_and_polish": {"type": "boolean"}
            }
          }
        }
      }
    },
    "completed_stages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "current_stage": {"type": "integer", "minimum": 1},
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage"],
        "properties": {"stage": {"type": "integer", "minimum": 1}, "at": {"type": "string"}}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string"},
          "status": {"type": "string", "enum": ["ok", "error", "blocked", "failed", "pass", "repair"]}
        }
      }
    },
    "blockers": {"type": "array"},
    "next_actions": {"type": "array"}
  }
}
