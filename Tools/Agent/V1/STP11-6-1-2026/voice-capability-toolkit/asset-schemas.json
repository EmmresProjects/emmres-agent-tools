{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-schemas.json",
  "title": "voice-capability-toolkit schemas",
  "description": "Authoritative schemas for every structured document the Skill Tool reads or writes. All tools validate against the definitions in $defs using the built-in validator in tools-runtime-common.py (no third-party dependency required).",
  "version": "1.0.0",
  "$defs": {
    "capability": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 3, "maxLength": 120},
        "description": {"type": "string", "minLength": 15, "maxLength": 1200},
        "category": {"type": "string", "maxLength": 120},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "catalog": {
      "type": "object",
      "required": ["categories"],
      "properties": {
        "catalog_version": {"type": "string"},
        "source": {"type": "string"},
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["name", "skills"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 2, "maxLength": 160},
              "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "skills": {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "items": {"$ref": "#/$defs/capability"}
              }
            }
          }
        }
      }
    },
    "pitch_target": {
      "type": "object",
      "required": ["base_hz"],
      "additionalProperties": false,
      "properties": {
        "base_hz": {"type": "number", "minimum": 50, "maximum": 500},
        "range_st": {"type": "number", "minimum": 0.5, "maximum": 36}
      }
    },
    "voice_profile": {
      "type": "object",
      "required": ["profile_id", "display_name", "origin", "design", "rights"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 2, "maxLength": 120},
        "umbrella": {"type": "string", "maxLength": 160},
        "origin": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["synthetic-original", "licensed-model", "authorized-real-person"]
            },
            "consent_id": {"type": "string"},
            "notes": {"type": "string", "maxLength": 2000}
          }
        },
        "design": {
          "type": "object",
          "required": ["pitch", "pace_wpm", "energy"],
          "properties": {
            "age_presentation": {"type": "string", "maxLength": 60},
            "gender_presentation": {
              "enum": ["feminine", "masculine", "androgynous", "neutral", "fluid"]
            },
            "pitch": {"$ref": "#/$defs/pitch_target"},
            "resonance": {"enum": ["deep", "chest", "balanced", "head", "bright"]},
            "pace_wpm": {"type": "number", "minimum": 60, "maximum": 260},
            "energy": {"type": "number", "minimum": 0, "maximum": 1},
            "texture": {"type": "array", "items": {"type": "string"}},
            "accent": {
              "type": "object",
              "properties": {
                "locale": {"type": "string"},
                "strength": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "personality": {"type": "array", "items": {"type": "string"}},
            "signature_habits": {"type": "array", "items": {"type": "string"}}
          }
        },
        "preferred_styles": {"type": "array", "items": {"type": "string"}},
        "forbidden_traits": {"type": "array", "items": {"type": "string"}},
        "evaluation": {
          "type": "object",
          "properties": {
            "sample_lines": {"type": "array", "items": {"type": "string"}},
            "criteria": {"type": "array", "items": {"type": "string"}}
          }
        },
        "rights": {
          "type": "object",
          "required": ["origin_license", "allowed_uses"],
          "properties": {
            "origin_license": {"type": "string", "minLength": 2},
            "consent_id": {"type": "string"},
            "allowed_uses": {"type": "array", "items": {"type": "string"}},
            "territories": {"type": "array", "items": {"type": "string"}},
            "expires_at": {"type": "string"},
            "disclosure_required": {"type": "boolean"},
            "revocable": {"type": "boolean"}
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "created_at": {"type": "string"},
            "created_by": {"type": "string"},
            "model_version": {"type": "string"},
            "previous_version": {"type": "string"},
            "asset_hash": {"type": "string"}
          }
        }
      }
    },
    "consent_record": {
      "type": "object",
      "required": ["consent_id", "subject", "granted_by", "scope", "signature"],
      "properties": {
        "consent_id": {"type": "string", "pattern": "^consent-[a-z0-9-]+$"},
        "subject": {
          "type": "object",
          "required": ["display_name", "relationship"],
          "properties": {
            "display_name": {"type": "string", "minLength": 2},
            "is_real_person": {"type": "boolean"},
            "relationship": {"enum": ["self", "talent", "estate", "guardian", "license-holder"]},
            "verification": {"type": "string", "maxLength": 400}
          }
        },
        "granted_by": {"type": "string", "minLength": 2},
        "granted_at": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "scope": {
          "type": "object",
          "required": ["uses", "projects", "territories", "media", "commercial"],
          "properties": {
            "uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "projects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "territories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "media": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "commercial": {"type": "boolean"},
            "duration": {"type": "string"},
            "derivatives_allowed": {"type": "boolean"},
            "sublicense_allowed": {"type": "boolean"}
          }
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "form": {"enum": ["none", "metadata", "on-screen", "audible", "both"]}
          }
        },
        "expires_at": {"type": "string"},
        "revocation": {
          "type": "object",
          "properties": {
            "revocable": {"type": "boolean"},
            "contact": {"type": "string"},
            "procedure": {"type": "string", "maxLength": 800}
          }
        },
        "signature": {
          "type": "object",
          "required": ["method", "value"],
          "properties": {
            "method": {"enum": ["sha256-body", "external-signature-file", "wet-signature-ref"]},
            "value": {"type": "string", "minLength": 8},
            "verified_at": {"type": "string"}
          }
        }
      }
    },
    "production_brief": {
      "type": "object",
      "required": ["project", "language", "segments"],
      "properties": {
        "project": {"type": "string", "minLength": 2, "maxLength": 120},
        "language": {"type": "string", "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8})*$"},
        "target_duration_seconds": {"type": "number", "minimum": 0.5, "maximum": 7200},
        "target_lufs": {"type": "number", "minimum": -40, "maximum": -5},
        "formats": {"type": "array", "items": {"type": "string"}},
        "direction": {
          "type": "object",
          "properties": {
            "emotion": {"type": "string"},
            "intensity": {"type": "number", "minimum": 0, "maximum": 1},
            "pace_wpm": {"type": "number", "minimum": 60, "maximum": 260},
            "attitude": {"type": "string"},
            "pronunciation_preset": {"type": "string"}
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "speaker": {"type": "string"},
              "text": {"type": "string", "minLength": 1, "maxLength": 8000},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "minimum": 0},
              "emotion": {"type": "string"},
              "intensity": {"type": "number", "minimum": 0, "maximum": 1},
              "notes": {"type": "string", "maxLength": 800}
            }
          }
        }
      }
    },
    "delivery_manifest": {
      "type": "object",
      "required": ["project", "generated_at", "files"],
      "properties": {
        "project": {"type": "string"},
        "generated_at": {"type": "string"},
        "voice_profile": {"type": "string"},
        "target_lufs": {"type": "number"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 3},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1},
              "sample_rate": {"type": "integer", "minimum": 8000},
              "channels": {"type": "integer", "minimum": 1, "maximum": 8},
              "duration_seconds": {"type": "number", "minimum": 0},
              "format": {"type": "string"},
              "integrated_lufs": {"type": "number"},
              "true_peak_dbtp": {"type": "number"},
              "disclosure": {"type": "string"}
            }
          }
        },
        "rights": {
          "type": "object",
          "properties": {
            "consent_id": {"type": "string"},
            "license": {"type": "string"},
            "disclosure": {"type": "string"}
          }
        }
      }
    },
    "usage_request": {
      "type": "object",
      "required": ["use", "project", "territory", "medium"],
      "properties": {
        "use": {"type": "string", "minLength": 2},
        "project": {"type": "string", "minLength": 1},
        "territory": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "commercial": {"type": "boolean"},
        "duration": {"type": "string"},
        "imitate_real_person": {"type": "boolean"},
        "target_person": {"type": "string"},
        "audience": {"type": "string"},
        "sensitive_domain": {
          "enum": ["none", "fraud", "harassment", "sexual", "minors", "emergency",
                   "politics", "finance", "medical", "identity"]
        }
      }
    },
    "pronunciation_dictionary": {
      "type": "object",
      "required": ["name", "entries"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "language": {"type": "string"},
        "version": {"type": "string"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["term", "say"],
            "properties": {
              "term": {"type": "string", "minLength": 1, "maxLength": 200},
              "say": {"type": "string", "minLength": 1, "maxLength": 400},
              "ipa": {"type": "string"},
              "stress": {"type": "string"},
              "case_sensitive": {"type": "boolean"},
              "language": {"type": "string"},
              "scope": {"enum": ["project", "character", "brand", "language", "organization"]},
              "source": {"type": "string"},
              "approved_by": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
