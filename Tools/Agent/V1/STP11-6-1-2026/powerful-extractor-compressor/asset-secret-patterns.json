{
  "$schema": "pec.secret-patterns/1",
  "description": "Detection rules for the secret and sensitive-data scanner (tools-pec-core.py scan_tree). Rules are regular expressions evaluated per text file. Severity drives reporting; confidence drives the --min-confidence filter. Matched values are always redacted in output. No rule here performs an online validation check.",
  "max_preview_chars": 40,
  "patterns": [
    {
      "id": "aws-access-key",
      "label": "AWS access key id",
      "regex": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA)[0-9A-Z]{16}\\b",
      "severity": "high",
      "confidence": "high",
      "enabled": true
    },
    {
      "id": "github-token",
      "label": "GitHub token",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b",
      "severity": "high",
      "confidence": "high",
      "enabled": true
    },
    {
      "id": "slack-token",
      "label": "Slack token",
      "regex": "\\bxox[abprs]-[A-Za-z0-9-]{10,250}\\b",
      "severity": "high",
      "confidence": "high",
      "enabled": true
    },
    {
      "id": "google-api-key",
      "label": "Google API key",
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "severity": "high",
      "confidence": "high",
      "enabled": true
    },
    {
      "id": "openai-style-key",
      "label": "OpenAI-style secret key",
      "regex": "\\bsk-[A-Za-z0-9]{20,80}(?:T3BlbkFJ[A-Za-z0-9]{10,60})?\\b",
      "severity": "high",
      "confidence": "medium",
      "enabled": true
    },
    {
      "id": "private-key-block",
      "label": "PEM private key",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----",
      "severity": "high",
      "confidence": "high",
      "enabled": true
    },
    {
      "id": "jwt",
      "label": "JSON Web Token",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
      "severity": "medium",
      "confidence": "medium",
      "enabled": true
    },
    {
      "id": "generic-assignment",
      "label": "Password or secret assignment",
      "regex": "(?i)\\b(?:password|passwd|pwd|secret|api[_-]?key|apikey|auth[_-]?token|access[_-]?token|client[_-]?secret|private[_-]?key)\\b\\s*[:=]\\s*[\"']?([A-Za-z0-9!@#$%^&*()_+\\-=\\[\\]{};:'\",.<>/?~`|\\\\]{8,})",
      "severity": "medium",
      "confidence": "low",
      "enabled": true
    },
    {
      "id": "connection-string",
      "label": "Connection string with inline credentials",
      "regex": "(?i)\\b(?:postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|amqp|mssql|ftp)://[^\\s:@/]+:[^\\s:@/]{4,}@",
      "severity": "high",
      "confidence": "medium",
      "enabled": true
    },
    {
      "id": "basic-auth-header",
      "label": "Authorization header value",
      "regex": "(?i)authorization\\s*:\\s*(?:basic|bearer)\\s+[A-Za-z0-9._~+/=-]{12,}",
      "severity": "high",
      "confidence": "medium",
      "enabled": true
    },
    {
      "id": "credit-card",
      "label": "Payment card number",
      "regex": "\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})\\b",
      "severity": "high",
      "confidence": "medium",
      "enabled": true
    },
    {
      "id": "us-ssn",
      "label": "US social security number",
      "regex": "\\b(?!000|666|9\\d{2})\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b",
      "severity": "high",
      "confidence": "low",
      "enabled": true
    },
    {
      "id": "email-address",
      "label": "Email address (personal data)",
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,24}\\b",
      "severity": "low",
      "confidence": "low",
      "enabled": true
    },
    {
      "id": "phone-number",
      "label": "Phone number (personal data)",
      "regex": "(?<!\\d)(?:\\+\\d{1,3}[ -]?)?(?:\\(\\d{2,4}\\)[ -]?)?\\d{3,4}[-. ]\\d{3,4}[-. ]\\d{3,4}(?!\\d)",
      "severity": "low",
      "confidence": "low",
      "enabled": true
    },
    {
      "id": "internal-host",
      "label": "Internal hostname or private address",
      "regex": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})\\b",
      "severity": "low",
      "confidence": "medium",
      "enabled": false
    },
    {
      "id": "azure-connection-key",
      "label": "Azure storage connection string",
      "regex": "(?i)AccountKey\\s*=\\s*[A-Za-z0-9+/=]{40,}",
      "severity": "high",
      "confidence": "high",
      "enabled": true
    }
  ]
}
