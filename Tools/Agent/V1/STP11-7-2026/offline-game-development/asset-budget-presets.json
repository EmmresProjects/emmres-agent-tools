{
 "schema_version": "1.0",
 "preset_set_id": "offline-game-development-budgets",
 "description": "Device profiles used by generated specs and by the budget gate. A ceiling is a measurement target for the team, not a promise any engine makes.",
 "default_profile": "desktop-mid",
 "selection_hint": "pick the profile of the lowest-spec device you intend to ship to; everything above it is headroom, not licence",
 "metrics": {
  "frame_time_p50_ms": {
   "unit": "ms",
   "direction": "max",
   "description": "median frame time on the target"
  },
  "frame_time_p95_ms": {
   "unit": "ms",
   "direction": "max",
   "description": "95th percentile frame time; the usual smoothness gate"
  },
  "frame_time_p99_ms": {
   "unit": "ms",
   "direction": "max",
   "description": "worst 1% of frames, excluding load hitches"
  },
  "worst_frame_ms": {
   "unit": "ms",
   "direction": "max",
   "description": "single worst frame in the measured window"
  },
  "cpu_time_p95_ms": {
   "unit": "ms",
   "direction": "max",
   "description": "game-thread CPU time per frame"
  },
  "gpu_time_p95_ms": {
   "unit": "ms",
   "direction": "max",
   "description": "GPU time per frame"
  },
  "draw_calls_per_frame": {
   "unit": "calls",
   "direction": "max",
   "description": "batches submitted per frame"
  },
  "triangles_per_frame": {
   "unit": "triangles",
   "direction": "max",
   "description": "geometry rendered per frame"
  },
  "texture_memory_mb": {
   "unit": "MB",
   "direction": "max",
   "description": "resident texture memory"
  },
  "working_set_memory_mb": {
   "unit": "MB",
   "direction": "max",
   "description": "process working set on the target"
  },
  "peak_memory_mb": {
   "unit": "MB",
   "direction": "max",
   "description": "highest resident size in the session"
  },
  "install_size_mb": {
   "unit": "MB",
   "direction": "max",
   "description": "downloaded and installed footprint"
  },
  "load_time_seconds": {
   "unit": "s",
   "direction": "max",
   "description": "cold start to interactive"
  },
  "save_write_ms_p95": {
   "unit": "ms",
   "direction": "max",
   "description": "95th percentile save write"
  },
  "crash_free_sessions_pct": {
   "unit": "%",
   "direction": "min",
   "description": "sessions without a crash or fatal error"
  },
  "audio_voice_count": {
   "unit": "voices",
   "direction": "max",
   "description": "simultaneous playing voices"
  },
  "gc_pause_ms_p95": {
   "unit": "ms",
   "direction": "max",
   "description": "95th percentile managed-heap pause"
  },
  "network_sync_rate_hz": {
   "unit": "Hz",
   "direction": "min",
   "description": "outbound state rate for a multiplayer session"
  },
  "input_latency_ms_p95": {
   "unit": "ms",
   "direction": "max",
   "description": "button press to visible response"
  },
  "battery_drain_pct_per_hour": {
   "unit": "%/h",
   "direction": "max",
   "description": "battery used per hour of play"
  },
  "reprojection_frames_pct": {
   "unit": "%",
   "direction": "max",
   "description": "frames delivered by reprojection rather than the app"
  }
 },
