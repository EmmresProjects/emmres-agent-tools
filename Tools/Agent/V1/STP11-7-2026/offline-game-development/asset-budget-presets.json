 "fallback_guidance": {
  "frame_time_p95_ms": "cut overdraw and dynamic resolution before touching gameplay code",
  "draw_calls_per_frame": "batch by material, atlas the UI, and merge static geometry",
  "triangles_per_frame": "add a lod group and cull at distance rather than simplifying globally",
  "texture_memory_mb": "compress to the platform format and drop mip levels you never sample",
  "working_set_memory_mb": "stream the level in sections and cap the asset cache",
  "install_size_mb": "strip unused locales, languages, and audio banks from the shipped build",
  "load_time_seconds": "pre-warm the asset table and defer non-critical subsystems",
  "crash_free_sessions_pct": "handle the null case at the boundary; a guard is cheaper than a crash",
  "network_sync_rate_hz": "send state on change with a floor rate; drop rarely-seen entities first",
  "reprojection_frames_pct": "treat reprojection as a warning sign: cut CPU or GPU, not resolution",
  "audio_voice_count": "prioritise by distance and importance; steal the quietest voice",
  "battery_drain_pct_per_hour": "lower the tick rate and pause simulation off-screen",
  "gc_pause_ms_p95": "pool the hot allocations and pre-size the collections",
  "input_latency_ms_p95": "move the response to the input thread and buffer one frame less",
  "save_write_ms_p95": "write the delta, compress off the game thread",
  "worst_frame_ms": "find the hitch source: shader compile, GC, or a synchronous load",
  "peak_memory_mb": "cap the cache and release what the current scene cannot reach",
  "gpu_time_p95_ms": "reduce shader complexity and shadow resolution first",
  "cpu_time_p95_ms": "profile the frame; the answer is usually a query done far too often",
  "frame_time_p50_ms": "check vsync and frame-pacing settings before optimising",
  "frame_time_p99_ms": "look for periodic work: streaming ticks, saves, and analytics flushes"
 },
 "measurement_rules": [
  "measure on a release build on the real device, never in the editor",
  "report p50, p95, and p99 separately; a mean hides a hitch",
  "record the build id, device model, OS version, and ambient conditions with the number",
  "one profile change per run, so a regression is attributable",
  "a metric the profile does not define is a warning to review, never a pass"
 ]
}
