{
  "assets_dir": "auto",
  "dataset": "asset-catalog.json",
  "archetypes": "asset-archetypes.json",
  "license_policy": "asset-license-policy.json",
  "budget_presets": "asset-budget-presets.json",
  "output_schema": "asset-output-schema.json",
  "spec_template": "asset-spec-template.md",
  "evidence_fixture": "asset-evidence-fixture.json",
  "engines": {
    "enabled": [
      "godot",
      "unity",
      "unreal",
      "roblox"
    ],
    "default": "godot"
  },
  "target": {
    "platform": "desktop",
    "device_profile": "desktop-mid",
    "region": "worldwide"
  },
  "provider": {
    "kind": "local",
    "model_id": "",
    "endpoint": "",
    "allow_network": false
  },
  "limits": {
    "max_input_mb": 64,
    "max_targets": 400,
    "timeout_seconds": 60,
    "retries": 3,
    "max_list_rows": 500,
    "walk_depth": 6
  },
  "output": {
    "format": "json",
    "dir": "",
    "timestamp": false,
    "redact_secrets": true,
    "deterministic": true
  },
  "approvals": {
    "require_for": [
      "overwrite-file",
      "delete-file",
      "replace-dataset",
      "rights-waiver",
      "publish",
      "signing",
      "monetization-change",
      "credential-access",
      "device-flash"
    ]
  },
  "offline": {
    "allow_network": false,
    "forbid_remote_urls_in_specs": true
  },
  "_comment": "Baseline configuration layer for the offline-game-development Skill Tool. tools-runtime-kit.load_config() reads this file first, then --config, then OGD_CONFIG, then command-line flags. Every key here is read by the tool; set a key to change behaviour, not to describe it."
}
