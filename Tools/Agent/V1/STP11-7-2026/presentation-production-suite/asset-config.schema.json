{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-config.schema.json",
  "title": "Presentation Production Suite configuration",
  "description": "Schema for the rules/config file merged over asset-default-rules.json. Every key is optional in a user file; the shipped defaults must contain every required key. Numeric thresholds are expressed in points (pt) unless stated otherwise.",
  "type": "object",
  "required": ["schema_version", "profile", "profiles", "align_tolerance_pt", "sensitive_patterns", "risk_weights", "limits"],
  "properties": {
    "schema_version": { "type": "string" },
    "description": { "type": "string" },
    "profile": {
      "type": "string",
      "description": "Active viewing profile; must exist in profiles."
    },
    "profiles": {
      "type": "object",
      "description": "Named threshold sets. The engine bundle resolves the active profile and applies 'overrides' on top.",
      "required": ["conference-room"],
      "properties": {
        "conference-room": { "$ref": "#/definitions/profile" },
        "classroom": { "$ref": "#/definitions/profile" },
        "desktop-review": { "$ref": "#/definitions/profile" },
        "print-handout": { "$ref": "#/definitions/profile" },
        "large-stage": { "$ref": "#/definitions/profile" }
      },
      "additionalProperties": { "$ref": "#/definitions/profile" }
    },
    "overrides": {
      "type": "object",
      "description": "Flat threshold overrides applied to the active profile.",
      "additionalProperties": true
    },
    "align_tolerance_pt": { "type": "number", "minimum": 0, "maximum": 20 },
    "overlap_min_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "overlap_ignore_area_pt2": { "type": "number", "minimum": 0 },
    "whitespace_min_gap_pt": { "type": "number", "minimum": 0 },
    "color_drift_distance": { "type": "number", "minimum": 0, "maximum": 441 },
    "title_zone_tolerance_pt": { "type": "number", "minimum": 0 },
    "spacing_tolerance_pt": { "type": "number", "minimum": 0 },
    "font_fallback_map": {
      "type": "object",
      "description": "Font name -> ordered list of metric-similar fallbacks.",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "sensitive_patterns": {
      "type": "object",
      "description": "Named regular expressions scanned against slide text and notes.",
      "additionalProperties": { "type": "string" }
    },
    "citation_required_patterns": { "type": "array", "items": { "type": "string" } },
    "citation_hint_patterns": { "type": "array", "items": { "type": "string" } },
    "allowed_link_domains": { "type": "array", "items": { "type": "string" } },
    "risk_weights": {
      "type": "object",
      "required": ["error", "warning", "info"],
      "properties": {
        "error": { "type": "number", "minimum": 0 },
        "warning": { "type": "number", "minimum": 0 },
        "info": { "type": "number", "minimum": 0 }
      }
    },
    "score_weights": {
      "type": "object",
      "description": "Dimension weights for the overall score; unlisted dimensions still report their own score.",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "dependency_checks": {
      "type": "object",
      "properties": {
        "check_fonts": { "type": "boolean" },
        "check_media": { "type": "boolean" },
        "check_links": { "type": "boolean" },
        "check_relationships": { "type": "boolean" }
      }
    },
    "brand": {
      "type": "object",
      "description": "Optional brand rules; when absent only logo geometry is checked.",
      "properties": {
        "allowed_colors": { "type": "array", "items": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" } },
        "allowed_fonts": { "type": "array", "items": { "type": "string" } },
        "logo_name_patterns": { "type": "array", "items": { "type": "string" } },
        "min_logo_clear_space_pt": { "type": "number", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_slides", "max_objects_per_slide", "max_file_bytes"],
      "properties": {
        "max_slides": { "type": "integer", "minimum": 1 },
        "max_objects_per_slide": { "type": "integer", "minimum": 1 },
        "max_file_bytes": { "type": "integer", "minimum": 1024 },
        "render_max_pixels": { "type": "integer", "minimum": 10000 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  },
  "definitions": {
    "profile": {
      "type": "object",
      "required": ["min_text_pt", "max_words_per_slide", "contrast_body", "safe_margin_pt", "target_density"],
      "properties": {
        "min_text_pt": { "type": "number", "minimum": 4 },
        "min_footer_pt": { "type": "number", "minimum": 4 },
        "max_words_per_slide": { "type": "number", "minimum": 1 },
        "max_text_objects": { "type": "number", "minimum": 1 },
        "max_type_sizes": { "type": "number", "minimum": 1 },
        "max_colors_per_slide": { "type": "number", "minimum": 1 },
        "contrast_body": { "type": "number", "minimum": 1, "maximum": 21 },
        "contrast_large": { "type": "number", "minimum": 1, "maximum": 21 },
        "large_text_pt": { "type": "number", "minimum": 4 },
        "safe_margin_pt": { "type": "number", "minimum": 0 },
        "safe_bottom_pt": { "type": "number", "minimum": 0 },
        "max_bullets": { "type": "number", "minimum": 1 },
        "max_line_chars": { "type": "number", "minimum": 10 },
        "max_outline_levels": { "type": "number", "minimum": 1 },
        "target_density": { "type": "number", "minimum": 0.01, "maximum": 1 }
      }
    }
  }
}
