{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-deck-spec.schema.json",
  "title": "Declarative deck specification",
  "description": "Input contract for 'author --spec'. Each slide is declared with a type and its content; the authoring engine validates this document before writing anything, so a bad spec never produces a partial deck. Slide types: title, content, kpi, process.",
  "type": "object",
  "required": ["slides"],
  "max_bullets": { "maximum": 8 },
  "properties": {
    "title": { "type": "string", "description": "Deck title used for the output file name and metadata." },
    "author": { "type": "string" },
    "language": { "type": "string", "description": "BCP-47 tag recorded in the report." },
    "theme": {
      "type": "object",
      "description": "Theme hints applied to authored slides.",
      "properties": {
        "accent1": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
        "font": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["type", "title"],
        "properties": {
          "type": { "type": "string", "enum": ["title", "content", "kpi", "process"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 180 },
          "subtitle": { "type": "string", "maxLength": 240 },
          "presenter": { "type": "string", "maxLength": 120 },
          "date": { "type": "string", "maxLength": 60 },
          "claim": { "type": "string", "maxLength": 240, "description": "One-sentence key message shown above the body." },
          "bullets": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 180 },
            "description": "Required for type=content."
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "maxLength": 60 },
            "description": "Required for type=process; a single row fits six steps."
          },
          "cards": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "description": "Required for type=kpi.",
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string", "maxLength": 12 },
                "unit": { "type": "string", "maxLength": 8 },
                "label": { "type": "string", "maxLength": 60 },
                "delta": { "type": "string", "maxLength": 40, "description": "Comparison text, e.g. '+12% vs Q2'." },
                "source": { "type": "string", "maxLength": 120 }
              }
            }
          },
          "footnote": { "type": "string", "maxLength": 200, "description": "Source or methodology line." },
          "notes": { "type": "string", "maxLength": 4000, "description": "Recorded as speaker notes when present." }
        }
      }
    }
  }
}
