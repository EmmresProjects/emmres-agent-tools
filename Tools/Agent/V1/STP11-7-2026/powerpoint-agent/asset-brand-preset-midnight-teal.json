{
  "name": "midnight-teal",
  "description": "Dark conference palette with teal accents for product launches, keynotes, and technical demos.",
  "fonts": {
    "heading": "Segoe UI",
    "body": "Segoe UI",
    "mono": "Consolas"
  },
  "colors": {
    "background": "#0A1417",
    "surface": "#122226",
    "primary": "#031013",
    "secondary": "#0F3B3F",
    "accent": "#26C6B4",
    "accent_soft": "#7FD9CC",
    "text": "#E8F2F1",
    "text_inverse": "#04191C",
    "muted": "#8FA9A7",
    "border": "#1F3B3F",
    "success": "#3BB273",
    "warning": "#E0A458",
    "danger": "#E0605A"
  },
  "typography": {
    "title_pt": 34,
    "subtitle_pt": 18,
    "section_pt": 42,
    "heading_pt": 20,
    "body_pt": 16,
    "small_pt": 11,
    "kpi_pt": 40,
    "quote_pt": 26,
    "line_spacing": 1.16,
    "bullet_indent_in": 0.28
  },
  "grid": {
    "margin_x_in": 0.7,
    "margin_y_in": 0.48,
    "title_top_in": 0.48,
    "content_top_in": 1.55,
    "footer_y_in": 6.92,
    "gap_in": 0.32
  },
  "art": {
    "title_band": true,
    "accent_bar": true,
    "corner_radius_in": 0.14
  },
  "table": {
    "header_fill": "secondary",
    "header_text": "text",
    "row_fill": "surface",
    "alt_row_fill": "primary",
    "border": "border",
    "body_pt": 12,
    "header_pt": 12
  },
  "chart": {
    "palette": [
      "accent",
      "accent_soft",
      "success",
      "warning",
      "danger",
      "muted"
    ],
    "gridline": "border",
    "font_pt": 11
  },
  "footer": {
    "show_slide_number": true,
    "show_footer": true,
    "show_date": false
  }
}
