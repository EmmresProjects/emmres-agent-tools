{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offline-engineering-workbench/manifest.schema.json",
  "title": "Offline Engineering Provenance Manifest",
  "description": "Schema for the JSON manifest produced by tools-workbench.py manifest and consumed by tools-workbench.py verify. Supported validator subset: type, required, properties, items, enum, minimum, maxLength, pattern.",
  "type": "object",
  "required": ["schema_version", "tool", "root", "file_count", "total_bytes", "files", "environment"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "tool": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string"},
    "root": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "deterministic": {"type": "boolean"},
    "file_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "platform"],
      "properties": {
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "executable": {"type": "string"},
        "toolchain": {"type": "object"}
      }
    }
  }
}
