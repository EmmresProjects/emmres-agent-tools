{
  "schema_version": "1.0",
  "title": "Offline Engineering Check Policy",
  "description": "Default policy for tools-workbench.py check, manifest, run, and cleanroom. Copy and edit this file to change thresholds, disabled rules, exclusions, and approval requirements. Every value is validated before use.",
  "thresholds": {
    "max_file_bytes": 52428800,
    "max_text_bytes": 2097152,
    "max_findings_per_rule": 5,
    "max_findings_total": 200,
    "run_timeout_seconds": 300,
    "run_max_output_bytes": 200000,
    "run_retries": 0
  },
  "quality_gate": {
    "fail_on": ["critical", "high"],
    "warn_on": ["medium", "low", "info"]
  },
  "exclude_dirs": [
    ".git", ".hg", ".svn", "node_modules", ".venv", "venv", "env",
    "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache",
    "dist", "build", "out", "target", ".next", ".nuxt", ".cache",
    "coverage", ".tox", ".nox", ".idea", ".vscode", ".terraform"
  ],
  "exclude_globs": [
    "*.min.js", "*.min.css", "*.map", "*.png", "*.jpg", "*.jpeg",
    "*.gif", "*.webp", "*.ico", "*.pdf", "*.zip", "*.gz", "*.tgz", "*.bz2",
    "*.xz", "*.whl", "*.so", "*.dll", "*.dylib", "*.exe", "*.bin",
    "*.parquet", "*.arrow", "*.feather", "*.npy", "*.npz", "*.pkl",
    "*.pt", "*.onnx", "*.safetensors", "*.sqlite", "*.db", "*.woff", "*.woff2"
  ],
  "disabled_rules": [],
  "allow_paths": [],
  "approval_required_patterns": [
    {
      "id": "destructive-filesystem",
      "risk": "critical",
      "pattern": "(?:^|\\s)(?:rm|rmdir|shred|mkfs(?:\\.[a-z0-9]+)?|dd|truncate|fdisk|parted)(?:\\s|$)",
      "reason": "Deletes, formats, or overwrites data and cannot be undone by the workbench."
    },
    {
      "id": "privilege-change",
      "risk": "high",
      "pattern": "(?:^|\\s)(?:sudo|su|chown|chgrp|setcap|chmod\\s+777)(?:\\s|$)",
      "reason": "Changes privileges or ownership outside the project workspace."
    },
    {
      "id": "service-control",
      "risk": "high",
      "pattern": "(?:^|\\s)(?:systemctl|service|reboot|shutdown|initctl)(?:\\s|$)",
      "reason": "Controls host services or power state."
    },
    {
      "id": "network-egress",
      "risk": "high",
      "pattern": "(?:^|\\s)(?:curl|wget|nc|netcat|ssh|scp|rsync|git\\s+push)(?:\\s|$)",
      "reason": "Reaches beyond the local machine, which breaks the offline guarantee."
    },
    {
      "id": "package-install",
      "risk": "high",
      "pattern": "(?:^|\\s)(?:pip3?|pipx|npm|pnpm|yarn|conda|mamba|apt|apt-get|dnf|yum|apk|brew|dotnet|go|cargo)(?:\\s+)(?:install|add|update|upgrade|restore|publish|push)(?:\\s|$)",
      "reason": "Installs, updates, or publishes packages and may require a network or write outside the workspace."
    },
    {
      "id": "destructive-data",
      "risk": "critical",
      "pattern": "(?:DROP\\s+TABLE|DELETE\\s+FROM|TRUNCATE\\s+TABLE|terraform\\s+apply|kubectl\\s+delete|helm\\s+uninstall)",
      "reason": "Destroys or mutates managed data or infrastructure."
    },
    {
      "id": "container-publish",
      "risk": "high",
      "pattern": "(?:docker|podman|skopeo)\\s+(?:push|rmi|system\\s+prune)",
      "reason": "Publishes or deletes container artifacts."
    }
  ],
  "environment": {
    "python_min": "3.9",
    "offline_only": true
  }
}
