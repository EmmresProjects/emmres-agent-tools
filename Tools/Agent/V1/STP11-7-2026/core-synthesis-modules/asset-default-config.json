{
  "schema_version": "1.0.0",
  "skill_tool": {
    "name": "core-synthesis-modules",
    "umbrella_category": "Core Synthesis Scripts and Modules",
    "catalog_edition": "November 2026",
    "offline_first": true
  },
  "limits": {
    "max_text_chars": 8000,
    "max_chunk_chars": 600,
    "synthesis_timeout_seconds": 120,
    "provider_retries": 1,
    "onnx_intra_op_threads": 1
  },
  "audio": {
    "sample_rate": 22050,
    "sample_width_bytes": 2,
    "channels": 1,
    "target_peak_dbfs": -1.0,
    "target_lufs": -14.0,
    "loudness_normalization": true,
    "silence_threshold_db": -45.0,
    "overwrite_requires_approval": true
  },
  "preset_default": "friendly-male-30s",
  "providers": {
    "order": ["onnx", "piper", "stub"],
    "onnx": {
      "enabled": true,
      "model_path": "asset-test-model.onnx",
      "model_name": "test-model-fixture",
      "expected_sha256": "6b4ebb1525ba7f030964315207e87969bd2d3424cef6e72d3282bda01ef98400",
      "input_tokens": 256,
      "frames_per_token": 1102
    },
    "piper": {
      "enabled": true,
      "executable": "piper",
      "allowed_executables": ["piper"],
      "model_path": "models/piper/en_US-amy-medium.onnx",
      "timeout_seconds": 60
    },
    "stub": {
      "enabled": true,
      "quality_warning": true
    }
  },
  "paths": {
    "output_dir": "output"
  }
}
