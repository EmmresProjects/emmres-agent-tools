{
  "asset": "benchmark-cases",
  "version": "1.0.0",
  "purpose": "Fixed regression cases executed by benchmark factcheck / citation / translate acceptance. Extend with project cases; keep ids stable.",
  "factcheck_cases": [
    {
      "id": "fc-chron-1",
      "type": "chronology",
      "expect_ok": true,
      "events": [
        {
          "date": "2020-03-01",
          "label": "protocol registered"
        },
        {
          "date": "2020-09-15",
          "label": "trial started"
        },
        {
          "date": "2021-06-30",
          "label": "trial ended"
        }
      ]
    },
    {
      "id": "fc-chron-2",
      "type": "chronology",
      "expect_ok": false,
      "events": [
        {
          "date": "2021-06-30",
          "label": "trial ended"
        },
        {
          "date": "2020-03-01",
          "label": "protocol registered"
        }
      ]
    },
    {
      "id": "fc-pct-1",
      "type": "percent-change",
      "old": 200,
      "new": 250,
      "reported": "25%",
      "expect_match": true
    },
    {
      "id": "fc-pct-2",
      "type": "percent-change",
      "old": 200,
      "new": 250,
      "reported": "50%",
      "expect_match": false
    },
    {
      "id": "fc-pct-3",
      "type": "percent-change",
      "old": 80,
      "new": 60,
      "reported": "-25%",
      "expect_match": true
    },
    {
      "id": "fc-unit-1",
      "type": "unit-convert",
      "value": 5,
      "from_unit": "km",
      "to_unit": "m",
      "expect": 5000,
      "tolerance": 0.001
    },
    {
      "id": "fc-unit-2",
      "type": "unit-convert",
      "value": 32,
      "from_unit": "F",
      "to_unit": "C",
      "expect": 0,
      "tolerance": 0.05
    },
    {
      "id": "fc-unit-3",
      "type": "unit-convert",
      "value": 1,
      "from_unit": "kg",
      "to_unit": "g",
      "expect": 1000,
      "tolerance": 0.001
    }
  ],
