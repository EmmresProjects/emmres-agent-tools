{
  "schema_version": "1.0",
  "title": "Offline normalized source record",
  "type": "object",
  "required": [
    "id",
    "title",
    "text",
    "source_type",
    "language",
    "license",
    "jurisdiction",
    "version",
    "date",
    "authority",
    "status",
    "permissions"
  ],
  "properties": {
    "id": {"type": "string", "min_length": 1, "max_length": 128},
    "title": {"type": "string", "min_length": 1, "max_length": 500},
    "text": {"type": "string", "min_length": 1, "max_length": 500000},
    "source_type": {"type": "string", "enum": ["primary", "secondary", "tertiary", "corrected", "retracted", "unverified", "standards", "transcript", "reference", "policy"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "license": {"type": "string", "min_length": 1},
    "jurisdiction": {"type": "string", "min_length": 1},
    "version": {"type": "string", "min_length": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "authority": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "status": {"type": "string", "enum": ["active", "corrected", "retracted", "superseded", "unverified"]},
    "permissions": {
      "type": "object",
      "required": ["search", "quote", "redistribute", "store", "export"],
      "properties": {
        "search": {"type": "boolean"},
        "quote": {"type": "boolean"},
        "redistribute": {"type": "boolean"},
        "store": {"type": "boolean"},
        "export": {"type": "boolean"}
      }
    },
    "page_anchor": {"type": "string"},
    "local_ref": {"type": "string"},
    "edition": {"type": "string"},
    "supersedes": {"type": "string"},
    "retracted_by": {"type": "string"},
    "restricted": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "speaker", "text"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "speaker": {"type": "string", "min_length": 1},
          "text": {"type": "string", "min_length": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
