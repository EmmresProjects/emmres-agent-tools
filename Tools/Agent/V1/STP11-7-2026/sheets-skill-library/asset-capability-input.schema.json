{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-capability-input.schema.json",
  "title": "Capability semantics map",
  "description": "Per-capability execution semantics consumed by tools-spreadsheet-skill-library.py. One entry per catalog capability id. Surface codes: A=copilot_answer, L=local_docs, S=sheets_cells, W=workbook_batch, D=drive_file, X=pdf_export, C=csv_export, H=chart, V=pivot, F=form, G=gmail, K=calendar, B=bigquery, R=looker, P=apps_script, N=addon.",
  "type": "object",
  "required": ["version", "surfaces_legend", "capabilities"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "surfaces_legend": {
      "type": "object",
      "minProperties": 16,
      "additionalProperties": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "slug", "risk", "surfaces", "workflow", "inputs", "validation", "limits", "fallbacks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$" },
          "name": { "type": "string", "minLength": 3 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "risk": { "enum": ["low", "medium", "high", "critical"] },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["A", "L", "S", "W", "D", "X", "C", "H", "V", "F", "G", "K", "B", "R", "P", "N"] }
          },
          "workflow": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "fallbacks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "google_apis": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
