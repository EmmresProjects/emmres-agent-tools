{
  "schema_version": 1,
  "policy_version": "1.0.0",
  "updated": "2026-11-07",
  "summary": "Licence and consent gates for model files, voice data and generated audio. The tool evaluates a decision and blocks use that the licence does not allow; a human still has to approve any release.",
  "use_gates": {
    "personal_use": {
      "require_commercial_use": false,
      "require_redistribution": false,
      "require_voice_consent": false
    },
    "commercial_release": {
      "require_commercial_use": true,
      "require_redistribution": false,
      "require_voice_consent": false,
      "note": "audio in a monetised video counts as commercial use"
    },
    "public_redistribution": {
      "require_commercial_use": false,
      "require_redistribution": true,
      "require_voice_consent": false,
      "note": "shipping model files or voice data to third parties"
    },
    "model_redistribution": {
      "require_commercial_use": false,
      "require_redistribution": true,
      "require_voice_consent": false
    },
    "voice_cloning": {
      "require_commercial_use": false,
      "require_redistribution": false,
      "require_voice_consent": true,
      "note": "cloning a real person's voice always needs an affirmed consent record with an id"
    }
  },
  "licenses": {
    "cc0-dataset": {
      "name": "CC0 1.0 dataset",
      "url": "https://creativecommons.org/publicdomain/zero/1.0/",
      "commercial_use": true,
      "redistribution": true,
      "share_alike": false,
      "attribution_required": false,
      "non_commercial": false,
      "obligations": [
        "no conditions"
      ]
    },
    "public-domain": {
      "name": "Public domain",
      "url": null,
      "commercial_use": true,
      "redistribution": true,
      "share_alike": false,
      "attribution_required": false,
      "non_commercial": false,
      "obligations": [
        "none"
      ]
    },
    "cc-by": {
      "name": "Creative Commons Attribution 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/",
      "commercial_use": true,
      "redistribution": true,
      "share_alike": false,
      "attribution_required": true,
      "non_commercial": false,
      "attribution": "LibriTTS-R dataset citation and licence notice",
      "obligations": [
        "attribute the dataset and licence"
      ]
    },
    "cc-by-sa": {
      "name": "Creative Commons Attribution ShareAlike 4.0",
      "url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "commercial_use": true,
      "redistribution": true,
      "share_alike": true,
      "attribution_required": true,
      "non_commercial": false,
      "attribution": "dataset and licence notice",
      "obligations": [
        "attribute the dataset",
        "share derived model files alike"
      ]
    },
    "cc-by-nc-sa": {
      "name": "Creative Commons Attribution NonCommercial ShareAlike 4.0",
      "url": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
      "commercial_use": false,
      "redistribution": true,
      "share_alike": true,
      "attribution_required": true,
      "non_commercial": true,
      "attribution": "dataset and licence notice",
      "obligations": [
        "non-commercial use only",
        "attribute",
        "share alike"
      ]
    },
    "mimic3-see-url": {
      "name": "Mimic3 voice dataset terms (see upstream URL)",
      "url": "https://github.com/MycroftAI/mimic3-voices",
      "commercial_use": null,
      "redistribution": null,
      "share_alike": null,
      "attribution_required": true,
      "non_commercial": null,
      "obligations": [
        "read the upstream dataset terms before any release"
      ],
      "unresolved": true
    },
    "unknown": {
      "name": "Unknown licence",
      "url": null,
      "commercial_use": false,
      "redistribution": false,
      "share_alike": false,
      "attribution_required": true,
      "non_commercial": true,
      "obligations": [
        "do not release until the licence is identified"
      ],
      "unresolved": true
    }
  },
  "consent": {
    "required_fields": [
      "record_id",
      "affirmed",
      "affirmed_by",
      "affirmed_at"
    ],
    "rules": [
      "never synthesise a real person's cloned voice without a signed consent record",
      "store the consent record id in the evidence bundle for every release",
      "consent for a public figure does not cover commercial endorsement"
    ]
  },
  "fallback_disclosure": {
    "degraded_engine_label": "DEGRADED ENGINE",
    "rule": "any audio produced by the degraded fallback engine must be labelled in the manifest, captions and evidence bundle and must never be published as speech"
  }
}
