{
  "schema": "foic.prompt-recipes/1",
  "version": "1.0.0",
  "token_estimate": {
    "chars_per_token": 4.0,
    "comma_bonus_tokens": 1,
    "note": "Heuristic only. The tokenizer limit comes from the model preset; the estimate is a budget guard, not a tokenizer."
  },
  "weight_styles": {
    "a1111": {"open": "(", "close": ")", "separator": ":", "suffix": null, "example": "(mountain:1.25)"},
    "compel": {"open": "(", "close": ")", "suffix": "*1.25", "separator": null, "example": "(mountain)*1.25"},
    "none": {"open": null, "close": null, "suffix": null, "separator": null, "example": "mountain"}
  },
  "templates": {
    "product-shot": {
      "template": "{subject}, {material} material, studio product photography, soft {lighting} lighting, {background} background, sharp focus, high detail, centered composition",
      "variables": ["subject", "material", "lighting", "background"],
      "defaults": {"material": "matte", "lighting": "three-point softbox", "background": "seamless light gray"},
      "negative": "general-photo",
      "kind": "txt2img"
    },
    "portrait": {
      "template": "portrait of {subject}, {expression} expression, {lens} lens, {lighting} lighting, shallow depth of field, detailed skin texture, {style}",
      "variables": ["subject", "expression", "lens", "lighting", "style"],
      "defaults": {"expression": "calm", "lens": "85mm", "lighting": "window soft", "style": "editorial photography"},
      "negative": "general-portrait",
      "kind": "txt2img"
    },
    "typography-poster": {
      "template": "graphic poster design, headline text {headline}, {typeface} typography, {palette} color palette, generous negative space, flat vector layout, print ready",
      "variables": ["headline", "typeface", "palette"],
      "defaults": {"typeface": "geometric sans-serif", "palette": "high contrast duotone"},
      "negative": "typography",
      "kind": "txt2img"
    },
    "environment-concept": {
      "template": "{place}, {time_of_day}, {weather}, {style}, wide establishing shot, atmospheric depth, cinematic composition",
      "variables": ["place", "time_of_day", "weather", "style"],
      "defaults": {"time_of_day": "golden hour", "weather": "clear", "style": "matte painting concept art"},
      "negative": "general-art",
      "kind": "txt2img"
    },
    "img2img-restyle": {
      "template": "{subject_description}, {style_target}, preserve original composition and layout",
      "variables": ["subject_description", "style_target"],
      "defaults": {"style_target": "oil painting, impasto brush strokes"},
      "negative": "general-art",
      "kind": "img2img"
    },
    "inpaint-fill": {
      "template": "{fill_description}, seamless continuation of surrounding {context}, matching lighting and texture",
      "variables": ["fill_description", "context"],
      "defaults": {"context": "scene"},
      "negative": "inpaint",
      "kind": "inpaint"
    },
    "upscale-fidelity": {
      "template": "preserve original content, recover fine detail, no added objects, no style change",
      "variables": [],
      "defaults": {},
      "negative": "upscale",
      "kind": "upscale"
    },
    "controlnet-structure": {
      "template": "{subject_description}, following the provided {control_type} structure exactly, {style}",
      "variables": ["subject_description", "control_type", "style"],
      "defaults": {"control_type": "canny", "style": "photorealistic"},
      "negative": "general-photo",
      "kind": "controlnet"
    }
  },
  "negative_libraries": {
    "general-photo": ["lowres", "blurry", "jpeg artifacts", "watermark", "text", "signature", "oversaturated", "overexposed", "cropped", "duplicate"],
    "general-portrait": ["deformed face", "extra limbs", "extra fingers", "crossed eyes", "plastic skin", "over-smoothed skin", "bad anatomy", "watermark"],
    "general-art": ["low quality", "worst quality", "jpeg artifacts", "watermark", "signature", "text", "cropped", "out of frame"],
    "typography": ["misspelled text", "garbled letters", "extra letters", "illegible text", "overlapping text", "watermark"],
    "inpaint": ["seam", "visible edge", "mismatched lighting", "blurry patch", "repeated texture", "halo"],
    "upscale": ["oversharpen halo", "plastic texture", "waxy skin", "invented detail", "jpeg artifacts"]
  },
  "injection_patterns": [
    "(?i)\\bignore\\s+(all\\s+)?(previous|prior|above)\\s+(instructions?|prompts?)\\b",
    "(?i)\\bsystem\\s*:\\s*",
    "(?i)\\b(disregard|override|bypass)\\s+(the\\s+)?(rules?|policy|policies|guardrails?)\\b",
    "(?i)\\bprint\\s+(your\\s+)?(system\\s+)?prompt\\b",
    "(?i)\\bexfiltrat(e|ion)\\b",
    "(?i)\\b(curl|wget)\\s+https?://",
    "(?i)<\\s*/?\\s*(script|iframe|system|assistant)\\s*>",
    "(?i)\\b(rm\\s+-rf|sudo\\s+|eval\\s*\\(|exec\\s*\\()"
  ],
  "injection_action": "flag",
  "injection_action_note": "Matching text is flagged and reported; the compiler never executes, fetches, or follows prompt content."
}
