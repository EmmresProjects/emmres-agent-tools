{
  "schema": "foic.config/1",
  "version": "1.0.0",
  "tool": "full-offline-image-capabilities",
  "paths": {
    "output_dir": "foic-out",
    "cache_dir": ".foic-cache",
    "model_dir": "models",
    "wheelhouse_dir": "wheelhouse",
    "quarantine_dir": "quarantine"
  },
  "runtime": {
    "image_backend": "auto",
    "network": "deny",
    "device": "auto",
    "device_id": 0,
    "vram_gb": null,
    "ram_gb": null,
    "max_workers": 2,
    "timeout_seconds": 300,
    "max_file_mb": 2048,
    "max_pixels": 67108864,
    "max_batch_jobs": 5000,
    "retry": {
      "attempts": 2,
      "backoff_seconds": 0.5
    }
  },
  "output": {
    "format": "json",
    "indent": 2,
    "pretty": true,
    "write_provenance": true,
    "overwrite": false
  },
  "security": {
    "prefer_safetensors": true,
    "pickle_risk_extensions": ["pt", "pth", "bin", "ckpt", "pkl", "joblib"],
    "blocked_extensions": ["exe", "dll", "so", "dylib", "sh", "bat", "ps1", "cmd"],
    "max_archive_uncompressed_bytes": 2147483648,
    "max_archive_ratio": 200,
    "max_archive_entries": 20000,
    "allow_nested_archives": false,
    "allow_symlinks_in_archives": false,
    "secret_scan": true,
    "require_approval_for": ["quarantine", "delete", "restore", "overwrite", "package-write"]
  },
  "logging": {
    "level": "info",
    "quiet": false
  },
  "notes": [
    "network=deny means every capability refuses outbound access; a missing local component fails loudly.",
    "image_backend: auto uses Pillow when importable and falls back to the bundled pure-stdlib PNG/JPEG codec layer.",
    "Set runtime.vram_gb to an integer to make the memory planner pick concrete fallbacks instead of reporting unknown."
  ]
}
