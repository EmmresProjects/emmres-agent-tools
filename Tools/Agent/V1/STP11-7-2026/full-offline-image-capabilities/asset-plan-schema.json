{
  "schema": "foic.job-spec/1",
  "title": "Offline image job specification contract",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "kind",
    "model",
    "parameters",
    "memory_plan",
    "output"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "foic.job-spec/1"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "type": "string",
      "enum": [
        "txt2img",
        "img2img",
        "inpaint",
        "outpaint",
        "upscale",
        "controlnet",
        "lora",
        "remove-bg",
        "restore-face"
      ]
    },
    "preset": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "family",
        "runtime"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "checkpoint": {
          "type": "string"
        },
        "vae": {
          "type": "string"
        },
        "text_encoders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tokenizer_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "negative_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object",
      "required": [
        "seed",
        "steps",
        "guidance",
        "sampler",
        "scheduler",
        "width",
        "height"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": -1
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "guidance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 50.0
        },
        "sampler": {
          "type": "string"
        },
        "scheduler": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "denoise_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "control_weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "loras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "weight"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": -2.0,
            "maximum": 2.0
          },
          "trigger_tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object"
    },
    "memory_plan": {
      "type": "object",
      "required": [
        "device",
        "fallbacks",
        "max_resolution"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "vram_gb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_resolution": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "webp",
            "tiff"
          ]
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "write_provenance": {
          "type": "boolean"
        },
        "filename": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "status": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "validator_subset": [
    "type",
    "required",
    "properties",
    "items",
    "enum",
    "minimum",
    "maximum",
    "minLength",
    "maxLength",
    "additionalProperties"
  ]
}
