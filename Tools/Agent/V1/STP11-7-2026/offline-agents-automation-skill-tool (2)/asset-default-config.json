{
  "schema_version": "1.0.0",
  "tool_name": "offline-agents-automation",
  "runtime": {
    "default_state_dir": ".offline-agent-state",
    "sqlite_filename": "offline-agent-store.sqlite3",
    "quarantine_dirname": "quarantine",
    "artifacts_dirname": "artifacts",
    "backups_dirname": "backups",
    "workspaces_dirname": "ephemeral-workspaces",
    "deterministic_seed": 20261107,
    "offline_env_flags": {
      "HF_HUB_OFFLINE": "1",
      "TRANSFORMERS_OFFLINE": "1",
      "HF_DATASETS_OFFLINE": "1",
      "DO_NOT_TRACK": "1",
      "PIP_NO_INDEX": "1",
      "NO_PROXY": "*"
    }
  },
  "resources": {
    "security_policy_path": "offline-agents-automation/asset-security-policy.json",
    "schemas_path": "offline-agents-automation/asset-schemas.json",
    "prompt_templates_path": "offline-agents-automation/asset-prompt-templates.json",
    "workflow_presets_path": "offline-agents-automation/asset-workflow-presets.json",
    "reference_corpus_path": "offline-agents-automation/asset-reference-corpus-and-benchmarks.json"
  },
  "network_governance": {
    "mode": "offline-deny",
    "allow_external_network": false,
    "enable_local_loopback_adapters": false,
    "block_dns_and_proxies": true,
    "loopback_service_allowlist": [
      {
        "service_id": "local-llama-cpp",
        "host": "127.0.0.1",
        "port": 8080,
        "protocol": "http",
        "purpose": "local-llm-inference"
      },
      {
        "service_id": "local-ollama",
        "host": "127.0.0.1",
        "port": 11434,
        "protocol": "http",
        "purpose": "local-model-serving"
      },
      {
        "service_id": "local-vllm",
        "host": "127.0.0.1",
        "port": 8000,
        "protocol": "http",
        "purpose": "local-batch-inference"
      }
    ]
  },
  "models": {
    "default_provider": "builtin-offline-deterministic",
    "embedding_dimensions": 64,
    "profiles": {
      "builtin-offline-deterministic": {
        "backend": "stdlib-deterministic",
        "modality": ["text", "code", "structured"],
        "context_window": 8192,
        "quantization": "FP32-exact",
        "estimated_vram_mb": 0,
        "estimated_ram_mb": 64,
        "license": "Apache-2.0",
        "supports_json_schema": true,
        "supports_tools": true
      },
      "local-instruct-8b-q4": {
        "backend": "llama.cpp",
        "modality": ["text", "code", "structured"],
        "context_window": 32768,
        "params_billion": 8.0,
        "quantization": "Q4_K_M",
        "bits_per_weight": 4.8,
        "estimated_vram_mb": 5600,
        "estimated_ram_mb": 6400,
        "license": "Apache-2.0",
        "supports_json_schema": true,
        "supports_tools": true
      },
      "local-reasoning-32b-q4": {
        "backend": "vllm",
        "modality": ["text", "code", "structured"],
        "context_window": 65536,
        "params_billion": 32.5,
        "quantization": "AWQ-INT4",
        "bits_per_weight": 4.25,
        "estimated_vram_mb": 20480,
        "estimated_ram_mb": 24576,
        "license": "Apache-2.0",
        "supports_json_schema": true,
        "supports_tools": true
      },
      "local-vlm-7b-q4": {
        "backend": "llama.cpp",
        "modality": ["text", "image", "document"],
        "context_window": 16384,
        "params_billion": 7.6,
        "quantization": "Q4_K_M",
        "bits_per_weight": 4.8,
        "estimated_vram_mb": 6200,
        "estimated_ram_mb": 7200,
        "license": "Apache-2.0",
        "supports_json_schema": true,
        "supports_tools": false
      },
      "local-asr-whisper-small": {
        "backend": "whisper.cpp",
        "modality": ["audio"],
        "context_window": 448,
        "params_billion": 0.244,
        "quantization": "Q5_1",
        "bits_per_weight": 5.5,
        "estimated_vram_mb": 512,
        "estimated_ram_mb": 768,
        "license": "MIT",
        "supports_json_schema": true,
        "supports_tools": false
      }
    }
  },
  "context_budget": {
    "default_total_tokens": 8192,
    "allocations": {
      "instructions": 0.15,
      "evidence": 0.40,
      "tools": 0.12,
      "history": 0.13,
      "memory": 0.08,
      "output": 0.12
    },
    "overflow_strategy": "priority-trim-history-then-low-rank-evidence"
  },
  "retrieval_and_grounding": {
    "chunk_size_chars": 600,
    "chunk_overlap_chars": 80,
    "rrf_k": 60,
    "bm25_k1": 1.5,
    "bm25_b": 0.75,
    "min_similarity_threshold": 0.12,
    "min_entailment_ratio": 0.55,
    "abstention_threshold": 0.35,
    "max_source_age_days": 730
  },
  "limits_and_recovery": {
    "soft_timeout_seconds": 15.0,
    "hard_timeout_seconds": 30.0,
    "max_input_bytes": 10485760,
    "max_subprocess_output_bytes": 1048576,
    "max_retries": 3,
    "retry_base_delay_ms": 150,
    "retry_max_delay_ms": 2000,
    "circuit_breaker_failure_threshold": 3,
    "circuit_breaker_cooldown_seconds": 60,
    "worker_lease_ttl_seconds": 120,
    "approval_ttl_seconds": 3600
  },
  "budgets": {
    "max_tokens_per_run": 65536,
    "max_tool_calls_per_run": 64,
    "max_destructive_calls_per_run": 4,
    "max_cpu_seconds_per_run": 60.0,
    "max_storage_bytes": 536870912,
    "storage_safety_margin_ratio": 0.15,
    "slo_availability_target": 0.995,
    "error_budget_window_runs": 200
  },
  "retention": {
    "memory_default_ttl_days": 90,
    "audit_retention_days": 365,
    "ephemeral_workspace_ttl_minutes": 15,
    "quarantine_retention_days": 30
  }
}
