{
  "config_version": "1.0",
  "description": "Baseline configuration for the offline-agents-automation Skill Tool. Copy, edit and pass with --config; every value may also be overridden with --set key=value.",
  "workspace": {
    "root": ".oaa",
    "index_dir": "index",
    "state_db": "state.sqlite3",
    "audit_log": "audit.jsonl",
    "artifacts_dir": "artifacts",
    "checkpoints_dir": "checkpoints",
    "lock_file": "workspace.lock",
    "read_roots": [
      "."
    ]
  },
  "limits": {
    "max_steps": 200,
    "max_retries": 5,
    "retry_base_seconds": 0.05,
    "retry_max_seconds": 5.0,
    "retry_jitter": 0.25,
    "step_timeout_seconds": 120,
    "workflow_timeout_seconds": 900,
    "max_input_bytes": 5000000,
    "max_document_bytes": 2000000,
    "max_chunks_per_doc": 500,
    "max_query_terms": 64,
    "max_results": 50,
    "max_workflow_steps_evaluated": 5000,
    "lock_timeout_seconds": 10
  },
  "provider": {
    "type": "deterministic",
    "command": [],
    "model": "local-default",
    "timeout_seconds": 60,
    "max_context_tokens": 8192
  },
  "policy": {
    "default_deny": true,
    "hmac_key_env": "OAA_HMAC_KEY",
    "token_ttl_seconds": 600,
    "approval_ttl_seconds": 900,
    "default_roles": [
      "operator"
    ],
    "read_only_prefixes": [
      "read.",
      "query.",
      "list.",
      "audit.",
      "plan.",
      "index.query",
      "index.audit",
      "guard.",
      "eval.compare",
      "registry.list",
      "memory.get",
      "memory.search"
    ],
    "allowed_actions": [
      "index.build",
      "index.query",
      "index.audit",
      "index.snapshot",
      "index.rebuild",
      "memory.put",
      "memory.get",
      "memory.search",
      "memory.resolve",
      "memory.compact",
      "memory.delete",
      "memory.delete.hard",
      "memory.export",
      "guard.check",
      "guard.cite",
      "guard.schema",
      "guard.injection",
      "guard.redact",
      "guard.calc",
      "policy.check",
      "policy.token.issue",
      "policy.token.verify",
      "plan.quantization",
      "plan.hardware",
      "plan.context",
      "plan.capacity",
      "eval.run",
      "eval.compare",
      "audit.append",
      "audit.verify",
      "audit.timeline",
      "airgap.check",
      "registry.add",
      "registry.list",
      "registry.license",
      "provider.infer",
      "artifact.write",
      "artifact.read",
      "artifact.publish",
      "fs.read",
      "fs.write",
      "fs.delete",
      "db.write",
      "network.export",
      "secret.read",
      "workflow.run",
      "workflow.resume",
      "workflow.cancel",
      "approval.request",
      "approval.decide"
    ],
    "denied_actions": [
      "shell.exec",
      "network.export",
      "secret.read",
      "model.install",
      "package.install"
    ],
    "require_approval": [
      "fs.delete",
      "db.write",
      "artifact.publish",
      "network.export",
      "workflow.cancel",
      "memory.delete.hard",
      "policy.token.issue"
    ],
    "roles": {
      "operator": [
        "index.*",
        "guard.*",
        "plan.*",
        "eval.*",
        "audit.*",
        "state.*",
        "memory.*",
        "workflow.*",
        "approval.*",
        "dlq.*",
        "fs.read",
        "fs.write",
        "fs.list",
        "fs.hash",
        "artifact.write",
        "artifact.publish",
        "artifact.list",
        "provider.infer",
        "policy.check",
        "policy.token.verify",
        "policy.token.issue",
        "airgap.check",
        "registry.add",
        "registry.list",
        "registry.license",
        "fs.delete"
      ],
      "approver": [
        "audit.*",
        "approval.*",
        "policy.check",
        "policy.token.issue",
        "workflow.cancel",
        "fs.read"
      ],
      "auditor": [
        "audit.*",
        "eval.compare",
        "index.audit",
        "registry.list",
        "fs.read",
        "state.report",
        "guard.cite"
      ]
    },
    "roles_authoritative": true
  },
  "retrieval": {
    "chunk_chars": 800,
    "chunk_overlap": 120,
    "bm25_k1": 1.5,
    "bm25_b": 0.75,
    "dense_dims": 256,
    "hybrid_dense_weight": 0.45,
    "hybrid_bm25_weight": 0.55,
    "min_score": 0.0,
    "max_context_chars": 4000,
    "dedupe_threshold": 0.92
  },
  "guard": {
    "min_claim_terms": 3,
    "support_threshold": 0.6,
    "max_unsupported_ratio": 0.34,
    "require_citations": true,
    "redact_patterns": [
      "(?i)(api[_-]?key\\s*[:=]\\s*)([A-Za-z0-9_\\-]{8,})",
      "(?i)(password\\s*[:=]\\s*)(\\S+)",
      "(?i)(bearer\\s+)([A-Za-z0-9._\\-]{10,})",
      "\\b[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}\\b",
      "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b"
    ]
  },
  "airgap": {
    "mode": "offline",
    "allowed_hosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ],
    "allowed_schemes": [
      "file",
      "unix"
    ],
    "blocked_schemes": [
      "http",
      "https",
      "ftp",
      "ws",
      "wss"
    ],
    "blocked_hosts": [
      "example.com",
      "api.openai.com",
      "pypi.org",
      "github.com",
      "huggingface.co"
    ],
    "scan_extensions": [
      ".py",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".md",
      ".txt",
      ".sh",
      ".cfg",
      ".ini"
    ],
    "max_files_scanned": 2000
  },
  "evaluation": {
    "dataset": "asset-eval-dataset.jsonl",
    "injection_fixtures": "asset-injection-fixtures.json",
    "baseline_dir": "baselines",
    "tolerance": 0.0,
    "block_on_regression": true
  },
  "retention": {
    "audit_days": 365,
    "state_days": 90,
    "redact_keys": [
      "password",
      "secret",
      "token",
      "api_key",
      "authorization",
      "credential",
      "private_key"
    ]
  },
  "logging": {
    "level": "info",
    "emit_json": true
  }
}
