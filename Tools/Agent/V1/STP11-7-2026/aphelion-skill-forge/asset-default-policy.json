{
  "version": "1.0.0",
  "description": "Default operating policy for the Aphelion Skill Forge. Tune per organisation; every value is overridable with --policy.",
  "defaults": {
    "max_input_bytes": 4000000,
    "max_items": 500,
    "max_tool_files": 12,
    "max_assets": 8,
    "max_output_bytes": 8000000,
    "timeout_seconds": 120,
    "retries": 2,
    "retry_backoff_seconds": 0.25,
    "strict": false,
    "require_approval_for_risk": [
      "elevated",
      "high"
    ],
    "allow_command_provider": false,
    "command_provider_allowlist": [],
    "checkpoint_every_step": true,
    "profile_min_keywords": 2,
    "max_profiles": 2,
    "max_file_bytes": 1048576
  },
  "risk_levels": {
    "low": {
      "rank": 1,
      "approval": false,
      "note": "Read-only local generation, no side effects."
    },
    "standard": {
      "rank": 2,
      "approval": false,
      "note": "Creates or edits ordinary local files."
    },
    "elevated": {
      "rank": 3,
      "approval": true,
      "note": "Touches delivery, shared state, schema, or code execution."
    },
    "high": {
      "rank": 4,
      "approval": true,
      "note": "Privileged, irreversible, security, financial, or publishing impact."
    }
  },
  "rules": [
    {
      "id": "destructive",
      "label": "Destructive or irreversible operation",
      "risk": "high",
      "patterns": [
        "delete|remove|destroy|wipe|purge|overwrite|truncate|drop table|force[- ]push|rm -rf|erase"
      ]
    },
    {
      "id": "credentials",
      "label": "Credentials, secrets, or key material",
      "risk": "high",
      "patterns": [
        "credential|secret|api[ _-]?key|password|token|private key|kms|certificate|rotate key|vault"
      ]
    },
    {
      "id": "publishing",
      "label": "Publishing or external distribution",
      "risk": "high",
      "patterns": [
        "publish|deploy|release to|send email|post to|notify (customer|user|tenant)|go[- ]live|external distribution"
      ]
    },
    {
      "id": "financial",
      "label": "Financial transaction or money movement",
      "risk": "high",
      "patterns": [
        "payment|invoice|billing|refund|transfer funds|purchase order|payroll|tax filing|wire"
      ]
    },
    {
      "id": "privileged-infrastructure",
      "label": "Privileged infrastructure change",
      "risk": "high",
      "patterns": [
        "production|prod cluster|terraform apply|kubectl apply|iam|root account|firewall|dns record|migration apply"
      ]
    },
    {
      "id": "sensitive-data",
      "label": "Sensitive or personal data handling",
      "risk": "elevated",
      "patterns": [
        "personal data|pii|phi|medical record|passport|biometric|gdpr|hipaa|consent|minor"
      ]
    },
    {
      "id": "security-testing",
      "label": "Security testing or exploitation",
      "risk": "high",
      "patterns": [
        "penetration|exploit|vulnerability scan|payload|fuzz|red team|attack"
      ]
    },
    {
      "id": "code-execution",
      "label": "Arbitrary code, shell, or network execution",
      "risk": "elevated",
      "patterns": [
        "shell|subprocess|execute code|eval\\(|curl \\||remote endpoint|webhook"
      ]
    },
    {
      "id": "legal-advice",
      "label": "Legal, regulatory, or compliance determination",
      "risk": "high",
      "patterns": [
        "legal advice|contract clause|court|lawsuit|statute|regulator|litigation"
      ]
    },
    {
      "id": "schema-change",
      "label": "Schema or data contract change",
      "risk": "elevated",
      "patterns": [
        "migration|schema change|alter table|breaking change|api contract"
      ]
    }
  ],
