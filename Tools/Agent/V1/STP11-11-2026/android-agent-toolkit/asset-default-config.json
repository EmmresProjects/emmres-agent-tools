{
  "schema_version": 1,
  "comment": "Default configuration for android-agent-toolkit. Copy and edit, then pass with --config. All keys are overridable; the toolkit deep-merges a user config over these defaults.",
  "limits": {
    "max_input_bytes": 2147483648,
    "max_zip_entries": 200000,
    "max_crc_bytes_per_entry": 268435456,
    "max_output_capture_bytes": 2097152,
    "subprocess_timeout_sec": 120,
    "selftest_timeout_sec": 30,
    "retries_readonly": 1,
    "max_dex_strings": 200000,
    "max_dex_string_bytes": 512,
    "max_smali_files_scan": 20000,
    "max_media_entries_scan": 5000,
    "max_report_items": 500,
    "clean_max_files": 100000
  },
  "approval": {
    "required_for": [
      "delete",
      "external-exec-non-readonly",
      "device-state-change",
      "signing",
      "publish",
      "credential-use",
      "overwrite-nonempty-output"
    ],
    "assume_yes_flag": "--yes",
    "noninteractive_deny": true,
    "gate_message": "This action is destructive, privileged, or side-effecting. Re-run with --yes to approve."
  },
  "exit_codes": {
    "ok": 0,
    "operation_error": 1,
    "usage_or_input_error": 2,
    "approval_required_or_denied": 3,
    "requirement_missing": 4
  },
  "paths": {
    "default_output_dir": "out",
    "pin_store": "toolkit-pins.json",
    "provenance_store": "provenance-manifest.json"
  },
  "tool_search_dirs": ["vendor", "tools", "."],
  "env_vars": [
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "JAVA_HOME",
    "GRADLE_USER_HOME",
    "ANDROID_NDK_HOME",
    "ANDROID_AVD_HOME",
    "APKTOOL_JAR",
    "BUNDLETOOL_JAR"
  ],
  "sdk_root_fallbacks": ["$ANDROID_HOME", "$ANDROID_SDK_ROOT", "~/Android/Sdk", "/opt/android-sdk", "/usr/lib/android-sdk"],
  "avd_dir_fallbacks": ["$ANDROID_AVD_HOME", "~/.android/avd"],
  "jdk_scan_dirs": ["$JAVA_HOME", "/usr/lib/jvm", "/opt/java", "/Library/Java/JavaVirtualMachines"],
  "workspace_clean": {
    "generated_dir_names": ["build", ".gradle", ".cxx", ".externalNativeBuild", "intermediates", "generated", "captures", ".kotlin"],
    "generated_file_globs": ["*.hprof", "*.trace", "hs_err_pid*.log", "replay_pid*.log"],
    "protected_globs": ["*.keystore", "*.jks", "*.p12", "*.pfx", "*.pem", "*.key", "*.asc", "*.gpg", "provenance*", "*.orig", "originals/*", "evidence/*", ".git/*", "local.properties"],
    "protected_dir_names": [".git", "originals", "evidence", "keystores"],
    "keep_apk_outside_build_dirs": true
  },
  "permissions": {
    "dangerous": [
      "android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR",
      "android.permission.READ_CALL_LOG", "android.permission.WRITE_CALL_LOG", "android.permission.PROCESS_OUTGOING_CALLS",
      "android.permission.CAMERA",
      "android.permission.READ_CONTACTS", "android.permission.WRITE_CONTACTS", "android.permission.GET_ACCOUNTS",
      "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_BACKGROUND_LOCATION",
      "android.permission.RECORD_AUDIO",
      "android.permission.READ_PHONE_STATE", "android.permission.READ_PHONE_NUMBERS", "android.permission.CALL_PHONE", "android.permission.ADD_VOICEMAIL", "android.permission.USE_SIP", "android.permission.ANSWER_PHONE_CALLS",
      "android.permission.BODY_SENSORS", "android.permission.ACTIVITY_RECOGNITION",
      "android.permission.SEND_SMS", "android.permission.RECEIVE_SMS", "android.permission.READ_SMS", "android.permission.RECEIVE_WAP_PUSH", "android.permission.RECEIVE_MMS",
      "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.ACCESS_MEDIA_LOCATION",
      "android.permission.POST_NOTIFICATIONS", "android.permission.NEARBY_WIFI_DEVICES", "android.permission.BLUETOOTH_CONNECT", "android.permission.BLUETOOTH_SCAN", "android.permission.BLUETOOTH_ADVERTISE"
    ],
    "special_access": [
      "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.WRITE_SETTINGS",
      "android.permission.MANAGE_EXTERNAL_STORAGE", "android.permission.SCHEDULE_EXACT_ALARM", "android.permission.USE_EXACT_ALARM",
      "android.permission.PACKAGE_USAGE_STATS", "android.permission.REQUEST_INSTALL_PACKAGES",
      "android.permission.BIND_ACCESSIBILITY_SERVICE", "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE",
      "android.permission.READ_PRIVILEGED_PHONE_STATE", "android.permission.INSTALL_PACKAGES"
    ],
    "installation_risk": [
      "android.permission.INSTALL_PACKAGES", "android.permission.REQUEST_INSTALL_PACKAGES",
      "android.permission.MOUNT_UNMOUNT_FILESYSTEMS", "android.permission.WRITE_SECURE_SETTINGS",
      "android.permission.BIND_DEVICE_ADMIN", "android.permission.MANAGE_DEVICE_ADMINS"
    ]
  },
  "scan_patterns": {
    "secrets": [
      {"id": "aws-access-key", "pattern": "AKIA[0-9A-Z]{16}"},
      {"id": "google-api-key", "pattern": "AIza[0-9A-Za-z_\\-]{35}"},
      {"id": "generic-api-key-assignment", "pattern": "(?i)(api[_-]?key|apikey|secret[_-]?key|access[_-]?token)\\s*[=:]\\s*['\"][A-Za-z0-9_\\-]{16,}['\"]"},
      {"id": "private-key-block", "pattern": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----"},
      {"id": "basic-auth-url", "pattern": "https?://[^/\\s:@]+:[^/\\s:@]+@"},
      {"id": "firebase-url", "pattern": "[a-z0-9\\-]+\\.firebaseio\\.com|[a-z0-9\\-]+\\.firebaseapp\\.com"}
    ],
    "crypto_misuse": [
      {"id": "ecb-mode", "pattern": "AES/ECB|DES/ECB|getInstance\\(\\s*\"ECB"},
      {"id": "weak-hash-md5", "pattern": "MessageDigest\\.getInstance\\(\\s*\"MD5"},
      {"id": "weak-hash-sha1", "pattern": "MessageDigest\\.getInstance\\(\\s*\"SHA-?1\""},
      {"id": "weak-cipher-des", "pattern": "Cipher\\.getInstance\\(\\s*\"(DES|RC4|RC2)"},
      {"id": "hardcoded-iv", "pattern": "new IvParameterSpec\\(\\s*\""},
      {"id": "static-random", "pattern": "new Random\\(\\s*[0-9]+L?\\s*\\)"}
    ],
    "sensitive_apis": [
      {"id": "device-identifier", "pattern": "getDeviceId\\(|getImei\\(|getSubscriberId\\(|getSimSerialNumber\\(|getAndroidId\\(|getMacAddress\\(|getSerial\\("},
      {"id": "location-apis", "pattern": "getLastKnownLocation\\(|requestLocationUpdates\\("},
      {"id": "sms-send", "pattern": "SmsManager.*send(Text|Multipart)Message\\("},
      {"id": "runtime-exec", "pattern": "Runtime\\.getRuntime\\(\\)\\.exec\\(|ProcessBuilder\\("},
      {"id": "dynamic-loading", "pattern": "DexClassLoader\\(|PathClassLoader\\(|System\\.loadLibrary\\(|System\\.load\\("},
      {"id": "reflection-use", "pattern": "Class\\.forName\\(|getDeclaredMethod\\(|setAccessible\\(true\\)"},
      {"id": "clipboard-read", "pattern": "getPrimaryClip\\(|ClipboardManager"},
      {"id": "contact-read", "pattern": "ContactsContract\\.|content://com\\.android\\.contacts"},
      {"id": "webview-js-bridge", "pattern": "addJavascriptInterface\\(|setJavaScriptEnabled\\(true\\)"},
      {"id": "cleartext-http", "pattern": "http://(?!schemas\\.|www\\.w3\\.org|ns\\.adobe\\.com|xmlpull\\.org|xml\\.org)[a-z0-9]"}
    ],
    "retired_services": [
      {"id": "c2dm-gcm-legacy", "pattern": "com\\.google\\.android\\.c2dm|android\\.net\\.http\\.AndroidHttpClient|org\\.apache\\.http"},
      {"id": "safetynet-legacy", "pattern": "com\\.google\\.android\\.gms\\.safetynet|SafetyNetApi"},
      {"id": "play-licensing-lvl", "pattern": "com\\.android\\.vending\\.licensing|LicenseChecker"},
      {"id": "old-billing", "pattern": "com\\.android\\.billingclient\\.api\\.BillingClient|com\\.android\\.vending\\.billing"},
      {"id": "google-plus-legacy", "pattern": "com\\.google\\.android\\.gms\\.plus|Plus\\.API"}
    ],
    "framework_usage": [
      {"id": "gms-usage", "pattern": "com\\.google\\.android\\.gms\\."},
      {"id": "compose-usage", "pattern": "androidx\\.compose\\."},
      {"id": "workmanager-usage", "pattern": "androidx\\.work\\."},
      {"id": "room-usage", "pattern": "androidx\\.room\\."},
      {"id": "support-library-legacy", "pattern": "android\\.support\\.v[0-9]"}
    ]
  },
  "known_system_libs": [
    "libc.so", "libm.so", "libdl.so", "liblog.so", "libandroid.so", "libz.so", "libEGL.so", "libGLESv1_CM.so",
    "libGLESv2.so", "libGLESv3.so", "libjnigraphics.so", "libmediandk.so", "libOpenMAXAL.so", "libOpenSLES.so",
    "libvulkan.so", "libaaudio.so", "libcamera2ndk.so", "libnativewindow.so", "libneuralnetworks.so", "libbinder_ndk.so",
    "libstdc++.so", "libatomic.so", "libwebviewchromium_loader.so", "libsync.so"
  ],
  "installer_failure_kb_ref": "asset-compat-matrix.json#/installer_failures",
  "reporting": {
    "default_format": "text",
    "json_indent": 2,
    "max_text_list_items": 40
  }
}
