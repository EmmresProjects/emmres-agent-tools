{
  "suite_id": "android-agent-toolkit-startup-selftest",
  "schema_version": 1,
  "description": "Startup self-test. tool entries use the whitelisted registry; builtin entries check the toolkit parsers against embedded binary fixtures (PASS/FAIL); host, license and device entries report catalog statuses.",
  "entries": [
    {
      "id": "tool-apktool",
      "kind": "tool",
      "tool": "apktool",
      "critical": true,
      "first_repair": true,
      "repair": "Download a versioned apktool jar, set APKTOOL_JAR, then: integrity pins-add"
    },
    {
      "id": "builtin-axml-package",
      "kind": "builtin",
      "check": "axml-package",
      "critical": true,
      "blob_b64": "",
      "expect": {
        "package": "com.toolkit.selftest.fixture"
      }
    },
    {
      "id": "builtin-dex-header",
      "kind": "builtin",
      "check": "dex-header",
      "critical": true,
      "blob_b64": "ZGV4CjAzNQDtC2DMC1vJ7kcoWdxOSiOFw6V+UJ/2ISRwAAAAcAAAAHhWNBIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABwAAAHAAAAAAAAAAcAAAAA==",
      "expect": {
        "class_defs_size": 7
      }
    },
    {
      "id": "builtin-elf-machine",
      "kind": "builtin",
      "check": "elf-machine",
      "critical": true,
      "blob_b64": "f0VMRgIBAQAAAAAAAAAAAAMAtwABAAAAAAAAAAAAAABAAAAAAAAAAAAAAAAAAAAAAAAAAEAAOAAAAEAAAAAAAA==",
      "expect": {
        "machine": "AArch64"
      }
    },
    {
      "id": "builtin-zip-fixture",
      "kind": "builtin",
      "check": "zip-fixture",
      "critical": true,
      "blob_b64": "",
      "expect": {
        "issue_codes": [
          "duplicate-entries",
          "path-traversal"
        ]
      }
    },
    {
      "id": "builtin-triage-sample",
      "kind": "builtin",
      "check": "triage-sample",
      "critical": true,
      "file": "asset-sample-failures.txt",
      "expect": {
        "min_blocks": 4,
        "kinds": [
          "java_crash",
          "anr",
          "native_tombstone",
          "installer_failure"
        ]
      }
    },
    {
      "id": "host-kvm",
      "kind": "host",
      "critical": false
    },
