{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-video-creation brief",
  "type": "object",
  "required": ["title", "objective"],
  "additionalProperties": true,
  "properties": {
    "title": {"type": "string", "minLength": 2, "maxLength": 160},
    "objective": {"type": "string", "minLength": 8, "maxLength": 4000},
    "audience": {"type": "string", "maxLength": 300},
    "duration_seconds": {"type": "number", "minimum": 0.5, "maximum": 3600},
    "fps": {"type": "number", "enum": [23.976, 24, 25, 29.97, 30, 50, 59.94, 60]},
    "aspect_ratio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:5", "4:3", "21:9"]},
    "resolution": {"type": "string", "pattern": "^[0-9]{3,5}x[0-9]{3,5}$"},
    "style": {"type": "string", "maxLength": 500},
    "style_preset": {"type": "string", "enum": ["cinematic", "documentary", "social-short", "music-video", "education", "product"]},
    "locale": {"type": "string", "maxLength": 20},
    "safety_class": {"type": "string", "enum": ["standard", "high-impact", "restricted"]},
    "capabilities": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1}},
    "script": {"type": "string", "maxLength": 100000},
    "script_source": {"type": "string", "maxLength": 500},
    "captions_text": {"type": "string", "maxLength": 100000},
    "captions_source": {"type": "string", "maxLength": 500},
    "captions_required": {"type": "boolean"},
    "audio_description": {"type": "boolean"},
    "reference_assets": {"type": "array", "maxItems": 200, "items": {"type": "object"}},
    "audio": {"type": "object"},
    "delivery_preset": {"type": "string", "enum": ["web-1080p", "shorts-vertical", "broadcast-1080i", "archive-master", "social-square"]},
    "provider": {"type": "string", "minLength": 1, "maxLength": 80},
    "seed": {"type": "integer", "minimum": 0},
    "prompt_variants": {"type": "integer", "minimum": 1, "maximum": 12},
    "constraints": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "negative_prompt": {"type": ["string", "array"]},
    "camera": {"type": "string", "maxLength": 300},
    "motion": {"type": "string", "maxLength": 300},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string", "maxLength": 4000},
    "approval": {"type": "object"},
    "publish": {"type": "boolean"},
    "voice_clone": {"type": "boolean"},
    "likeness": {"type": "boolean"},
    "medical": {"type": "boolean"},
    "political": {"type": "boolean"},
    "factual_reconstruction": {"type": "boolean"},
    "action": {"type": "string", "maxLength": 80}
  }
}
