{
  "terms_version": "1.0.0",
  "purpose": "Operational boundary screen for lawful PC work. BLOCK means refuse the bypass portion; REVIEW means collect authorization, licence or privacy scope first; ALLOW keeps legitimate compatibility, preservation and repair work available.",
  "global_rules": [
    "Preserve originals and record hashes before any modification.",
    "Prefer read-only inspection, reversible changes, snapshots and clean-state verification.",
    "Use real Windows, macOS, GPU, virtualization, network or licensed workers when the task genuinely requires them.",
    "Treat vendor licences, redistribution terms, signing keys, personal data and restricted tools as explicit dependencies."
  ],
  "categories": [
    {
      "id": "drm-bypass",
      "severity": "critical",
      "decision": "BLOCK",
      "rationale": "Circumventing digital rights management is never in scope, even when the goal is compatibility.",
      "terms": [
        "drm",
        "crack",
        "keygen",
        "serial key generator",
        "activation bypass",
        "license bypass",
        "licence bypass",
        "patch the activation",
        "remove the licence check",
        "defeat denuvo",
        "denuvo bypass",
        "securom",
        "safedisc"
      ]
    },
    {
      "id": "anti-cheat-bypass",
      "severity": "critical",
      "decision": "BLOCK",
      "rationale": "Anti-cheat and anti-tamper circumvention is prohibited.",
      "terms": [
        "anti-cheat bypass",
        "anticheat bypass",
        "bypass easy anti-cheat",
        "bypass battleye",
        "bypass vanguard",
        "spoof hwid",
        "hwid spoofer",
        "ban evasion"
      ]
    },
    {
      "id": "access-control",
      "severity": "critical",
      "decision": "BLOCK",
      "rationale": "Bypassing authentication or authorization controls is prohibited.",
      "terms": [
        "bypass login",
        "bypass password",
        "bypass the password",
        "crack the password",
        "sql injection",
        "jailbreak the",
        "brute force the login",
        "steal credentials",
        "dump passwords",
        "credential dump",
        "extract saved passwords",
        "token theft",
        "session hijack"
      ]
    },
    {
      "id": "privacy-scope",
      "severity": "high",
      "decision": "REVIEW",
      "rationale": "Personal data requires a declared lawful basis and a stated scope.",
      "terms": [
        "browser history",
        "cookies",
        "saved passwords",
        "private keys",
        "personal photos",
        "keychain",
        "credential manager",
        "someone else's",
        "employee data",
        "customer data"
      ],
      "required_context": [
        "ownership statement",
        "lawful basis",
        "retention limit",
        "minimum necessary scope"
      ]
    },
    {
      "id": "licence-dependency",
      "severity": "medium",
      "decision": "REVIEW",
      "rationale": "Licensed tooling and redistribution terms must be documented before use.",
      "terms": [
        "licensed tool",
        "purchase",
        "subscription",
        "commercial license",
        "commercial licence",
        "redistribute",
        "repack the installer",
        "bundle the runtime",
        "notarize",
        "code signing certificate"
      ],
      "required_context": [
        "licence reference",
        "entitlement evidence",
        "allowed use and redistribution scope"
      ]
    },
    {
      "id": "firmware-and-boot",
      "severity": "high",
      "decision": "REVIEW",
      "rationale": "Firmware and boot-path changes need a verified recovery path.",
      "terms": [
        "flash the bios",
        "bios update",
        "uefi update",
        "firmware flash",
        "oprom",
        "boot loader modification",
        "secure boot disable",
        "disable secure boot"
      ],
      "required_context": [
        "vendor package and recovery media",
        "battery or power guarantee",
        "snapshot or restore path"
      ]
    },
    {
      "id": "irreversible-storage",
      "severity": "high",
      "decision": "REVIEW",
      "rationale": "Partitioning, wiping and formatting destroy data unless a verified backup exists.",
      "terms": [
        "format the disk",
        "wipe the drive",
        "delete the partition",
        "resize the partition",
        "diskpart clean",
        "rm -rf",
        "shred",
        "zero fill",
        "secure erase"
      ],
      "required_context": [
        "verified backup hash",
        "confirmation that no original is unique to this drive",
        "rollback or restore media"
      ]
    }
  ],
  "exemptions": [
    {
      "id": "preservation",
      "phrases": [
        "read-only",
        "preservation",
        "museum archive",
        "hash the original"
      ],
      "why": "Preservation and read-only inspection are lawful when the material is owned or licensed.",
      "still_requires": [
        "ownership or permission statement",
        "no distribution of restricted material"
      ],
      "covers": [
        "licence-dependency"
      ],
      "requires_multiword_or_listed_single": true
    },
    {
      "id": "compatibility-work",
      "phrases": [
        "wine compatibility layer",
        "proton prefix",
        "virtual machine",
        "emulator",
        "application compatibility shim",
        "appcompat"
      ],
      "why": "Compatibility layers on legally obtained software are in scope.",
      "still_requires": [
        "lawfully obtained software",
        "no anti-cheat or DRM circumvention"
      ],
      "covers": [
        "licence-dependency"
      ],
      "requires_multiword_or_listed_single": true
    },
    {
      "id": "own-system-repair",
      "phrases": [
        "my own machine",
        "my own pc",
        "the user's own device",
        "device we own",
        "company-issued device with authorization"
      ],
      "why": "Repairing a system you own or are authorized to administer is in scope.",
      "still_requires": [
        "authorization statement when the device is not personal"
      ],
      "covers": [
        "licence-dependency",
        "irreversible-storage"
      ],
      "requires_multiword_or_listed_single": true
    },
    {
      "id": "defensive-security",
      "phrases": [
        "harden",
        "hardening",
        "verify signature",
        "check for malware",
        "vulnerability scan of our code",
        "sbom"
      ],
      "why": "Defensive hardening and owned-code scanning are in scope.",
      "still_requires": [
        "scope limited to owned or authorized systems"
      ],
      "covers": [
        "privacy-scope",
        "licence-dependency"
      ],
      "requires_multiword_or_listed_single": true
    }
  ],
  "response_template": {
    "blocked": "I cannot help with the bypass portion. I can help with the lawful alternative: {lawful_alternative}",
    "review": "Before proceeding I need: {required_context}"
  },
  "exemptions_never_cover": [
    "drm-bypass",
    "anti-cheat-bypass",
    "access-control"
  ],
  "negation_markers": [
    "prohibited",
    "not allowed",
    "not permitted",
    "without permission",
    "without authorization",
    "without consent",
    "unauthorized",
    "unauthorised",
    "illegal",
    "no consent",
    "forbidden"
  ],
  "negation_rule": "A negation marker anywhere in the request prevents exemptions from clearing REVIEW findings; the finding stays REVIEW."
}
