{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pc-capability-governance provenance record",
  "description": "Evidence and provenance document emitted by `provenance`: hashes, tool versions, recorded (never executed) commands and chain of custody.",
  "type": "object",
  "required": ["tool", "tool_version", "schema_version", "operation", "run_id", "generated_at", "host", "inputs", "tool_versions", "commands", "transforms", "chain_of_custody", "integrity"],
  "properties": {
    "tool": {"type": "string", "pattern": "^pc-capability-governance$"},
    "tool_version": {"type": "string"},
    "schema_version": {"type": "string"},
    "operation": {"type": "string", "enum": ["provenance"]},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "generated_at": {"type": "string"},
    "host": {"type": "object", "required": ["host_type", "architecture"]},
    "goal": {"type": "string"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string", "enum": ["file", "directory"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "entries": {"type": "integer", "minimum": 0},
          "bytes": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "tool_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "status", "detected_command", "detected_version"],
        "properties": {
          "capability_id": {"type": "string"},
          "status": {"type": "string"},
          "detected_command": {"type": "string"},
          "detected_version": {"type": ["string", "null"]}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argv", "executed"],
        "properties": {
          "argv": {"type": "string"},
          "executed": {"type": "boolean", "enum": [false]}
        }
      }
    },
    "transforms": {"type": "array", "items": {"type": "object"}},
    "chain_of_custody": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "at", "detail"],
        "properties": {
          "step": {"type": "string"},
          "at": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "input_count"],
      "properties": {
        "algorithm": {"type": "string", "enum": ["sha256"]},
        "input_count": {"type": "integer", "minimum": 0},
        "recompute": {"type": "string"}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
