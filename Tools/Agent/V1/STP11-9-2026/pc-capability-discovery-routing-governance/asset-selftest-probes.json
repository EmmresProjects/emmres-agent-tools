{
  "asset": "selftest-probes",
  "version": "1.0.0",
  "description": "Startup self-test contract and probe definitions for the PC Agent Skill Catalog. Probes run local commands only; no network access is performed.",
  "contract": {
    "statuses": [
      "FOUND",
      "MISSING",
      "WRONG VERSION",
      "BROKEN",
      "LICENSE REQUIRED",
      "WINDOWS HOST REQUIRED",
      "GPU REQUIRED",
      "VIRTUALIZATION REQUIRED",
      "NETWORK REQUIRED",
      "MACOS HOST REQUIRED"
    ],
    "extended_statuses": [
      "MACOS HOST REQUIRED"
    ],
    "extended_status_reason": "MACOS HOST REQUIRED extends the catalog contract for skills that delegate to a macOS worker; every other status is from the catalog contract.",
    "required_fields": [
      "capability_id",
      "status",
      "detected_command",
      "detected_version",
      "host_type",
      "architecture",
      "requirements",
      "test_command",
      "exit_code",
      "evidence_path",
      "recommended_action"
    ],
    "status_precedence": [
      "MACOS HOST REQUIRED",
      "WINDOWS HOST REQUIRED",
      "GPU REQUIRED",
      "VIRTUALIZATION REQUIRED",
      "NETWORK REQUIRED",
      "LICENSE REQUIRED",
      "BROKEN",
      "MISSING",
      "WRONG VERSION",
      "FOUND"
    ]
  },
  "probes": [
    {
      "id": "dotnet",
      "test_command": "dotnet --info",
      "commands": [
        [
          "dotnet",
          "--info"
        ]
      ],
      "kind": "command",
      "version_patterns": [
        "Version:\\s+(\\S+)",
        "(\\d+\\.\\d+\\.\\d+)"
      ],
      "require_success": true,
      "timeout_sec": 20,
      "retries": 1
    },
    {
      "id": "mono",
      "test_command": "mono --version",
      "commands": [
        [
          "mono",
          "--version"
        ]
      ],
