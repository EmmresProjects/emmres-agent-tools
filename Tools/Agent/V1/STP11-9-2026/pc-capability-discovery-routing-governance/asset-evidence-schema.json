{
  "asset": "evidence-schema",
  "version": "1.0.0",
  "description": "Schemas for evidence records, self-test rows, and reversible change plans produced by the capability-discovery-routing-governance skill tool. Validation is intentionally simple (required fields, types, enums) so it runs with no third-party dependencies.",
  "schema_language": "json-schema-subset",
  "definitions": {
    "selftest_row": {
      "type": "object",
      "required": [
        "capability_id",
        "status",
        "detected_command",
        "detected_version",
        "host_type",
        "architecture",
        "requirements",
        "test_command",
        "exit_code",
        "evidence_path",
        "recommended_action"
      ],
      "properties": {
        "capability_id": { "type": "string" },
        "status": { "type": "string", "enum": [
          "FOUND", "MISSING", "WRONG VERSION", "BROKEN", "LICENSE REQUIRED",
          "WINDOWS HOST REQUIRED", "GPU REQUIRED", "VIRTUALIZATION REQUIRED",
          "NETWORK REQUIRED", "MACOS HOST REQUIRED"
        ] },
        "detected_command": { "type": ["string", "null"] },
        "detected_version": { "type": ["string", "null"] },
        "host_type": { "type": "string" },
        "architecture": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "test_command": { "type": ["string", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "evidence_path": { "type": ["string", "null"] },
        "recommended_action": { "type": "string" }
      }
    },
    "evidence_record": {
      "type": "object",
      "required": ["schema", "event", "timestamp_utc", "host"],
      "properties": {
        "schema": { "type": "string", "enum": ["evidence-record/1"] },
        "event": { "type": "string", "enum": [
          "selftest", "inventory", "route", "gate", "risk", "plan-created",
          "plan-rolled-back", "boundary", "clean-state", "version-policy", "manual"
        ] },
        "timestamp_utc": { "type": "string" },
        "host": { "type": "object" },
        "actor": { "type": ["string", "null"] },
        "skill_id": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "type": "object" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "tool_versions": { "type": "object" },
        "approval": { "type": ["object", "null"] },
        "result": { "type": ["object", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "change_plan": {
      "type": "object",
      "required": [
        "schema", "plan_id", "created_utc", "target", "action",
        "target_sha256", "backup_path", "backup_sha256", "rollback_steps",
        "status"
      ],
      "properties": {
        "schema": { "type": "string", "enum": ["change-plan/1"] },
        "plan_id": { "type": "string" },
        "created_utc": { "type": "string" },
        "target": { "type": "string" },
        "action": { "type": "string" },
        "risk_class": { "type": "string" },
        "target_sha256": { "type": "string" },
        "backup_path": { "type": "string" },
        "backup_sha256": { "type": "string" },
        "backup_bytes": { "type": "integer" },
        "rollback_steps": { "type": "array", "items": { "type": "string" } },
        "approval": { "type": ["object", "null"] },
        "status": { "type": "string", "enum": ["open", "rolled_back"] },
        "rolled_back_utc": { "type": ["string", "null"] }
      }
    }
  }
}
