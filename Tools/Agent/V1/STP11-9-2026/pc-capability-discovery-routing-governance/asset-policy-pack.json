{
  "asset": "policy-pack",
  "version": "1.0.0",
  "description": "Operational policies for the capability-discovery-routing-governance skill tool: risk and approval model, lawful-use gate declarations, prohibited-boundary patterns, toolchain version pins, capability combinations, and runtime limits. Edit this file to adjust policy; no code changes are required.",
  "approval_levels": [
    "none",
    "operator",
    "administrator",
    "external"
  ],
  "approval_flags": {
    "none": "no flag required",
    "operator": "--approve",
    "administrator": "--approve --approver NAME",
    "external": "--approve --approver NAME --reason TEXT"
  },
  "risk_levels": {
    "read_only": {
      "rank": 0,
      "approval": "none"
    },
    "reversible": {
      "rank": 1,
      "approval": "operator"
    },
    "networked": {
      "rank": 2,
      "approval": "operator"
    },
    "privileged": {
      "rank": 3,
      "approval": "administrator"
    },
    "signing": {
      "rank": 4,
      "approval": "external"
    },
    "publishing": {
      "rank": 4,
      "approval": "external"
    },
    "financial": {
      "rank": 5,
      "approval": "external"
    },
    "credential": {
      "rank": 5,
      "approval": "external"
    },
    "security_sensitive": {
      "rank": 5,
      "approval": "external"
    },
    "destructive": {
      "rank": 6,
      "approval": "external"
    }
  },
  "risk_keywords": {
    "read_only": [
      "read",
      "inspect",
      "list",
      "view",
      "report",
      "hash",
      "summar",
      "query",
      "check",
      "inventory",
      "describe"
    ],
    "reversible": [
      "backup",
      "snapshot",
      "restore",
      "rollback",
      "copy",
      "rename",
      "move",
      "patch",
      "configur",
      "plan",
      "preview",
      "dry-run",
      "stage",
      "modify",
      "edit",
      "write file",
      "create file"
    ],
    "networked": [
      "download",
      "upload",
      "connect",
      "dns",
      "http",
      "tls",
      "ssh",
      "vpn",
      "proxy",
      "remote",
      "fetch",
      "request",
      "network"
    ],
    "privileged": [
      "admin",
      "elevat",
      "root",
      "service",
      "driver",
      "registry",
      "firmware",
      "system-wide",
      "install",
      "chmod",
      "sudo",
      "kernel"
    ],
    "signing": [
      "sign",
      "timestamp",
      "certificate",
      "authenticode",
      "notariz",
      "attestation"
    ],
    "publishing": [
      "publish",
      "release",
      "push to",
      "deploy",
      "announce",
      "submit to"
    ],
    "financial": [
      "purchase",
      "pay ",
      "billing",
      "invoice",
      "renew",
      "subscription",
      "checkout"
    ],
    "credential": [
      "password",
      "secret",
      "token",
      "credential",
      "private key",
      "unlock",
      "recovery key"
    ],
    "security_sensitive": [
      "firewall",
      "antivirus",
      "policy change",
      "acl",
      "permission change",
      "encrypt",
      "disable protection",
      "hardening"
    ],
    "destructive": [
      "delete",
      "remove",
      "wipe",
      "erase",
      "format ",
      "uninstall",
      "destroy",
      "overwrite",
      "irreversible",
      "sanitize",
      "decommission",
      "truncate",
      "drop ",
      "purge",
      "shred",
      "brick"
    ]
  },
  "gate_declarations": [
    "authorized",
    "owns_artifact",
    "license_ok",
    "privacy_ok"
  ],
  "gate_declaration_labels": {
    "authorized": "work is authorized by the owner or a lawful mandate",
    "owns_artifact": "the operator owns the artifact or has permission to act on it",
    "license_ok": "applicable software licenses permit the action",
    "privacy_ok": "personal data stays inside the declared privacy scope"
  },
  "prohibited": [
    {
      "id": "drm-bypass",
      "pattern": "\\b(drm|widevine|fairplay|content protection)\\b[^.]{0,60}\\b(bypass|crack|strip|defeat|circumvent|remove)\\b|\\b(bypass|crack|strip|defeat|circumvent)\\b[^.]{0,40}\\b(drm|widevine|fairplay|content protection)\\b",
      "reason": "DRM circumvention is out of scope."
    },
    {
      "id": "anticheat-bypass",
      "pattern": "\\banti[ -]?cheat\\b[^.]{0,60}\\b(bypass|disable|block|circumvent|kill)\\b|\\b(bypass|disable|circumvent|kill)\\b[^.]{0,40}\\banti[ -]?cheat\\b",
      "reason": "Anti-cheat bypass or disabling is prohibited."
    },
    {
      "id": "activation-bypass",
      "pattern": "\\b(activation|kms|licence|license)\\b[^.]{0,40}\\b(bypass|crack|keygen|circumvent|emulat)\\b|\\b(bypass|crack|keygen|circumvent)\\b[^.]{0,40}\\b(activation|kms|licence|license)\\b|\\bkms\\s*emulator\\b|\\bwindows\\s*activator\\b",
      "reason": "License or activation circumvention is prohibited."
    },
    {
      "id": "piracy",
      "pattern": "\\b(crack(ed)?|keygen|warez|pirated?|serial\\s*(code|generator)?)\\b",
      "reason": "Cracked software, keygens, and warez are prohibited."
    },
    {
      "id": "credential theft",
      "pattern": "\\b(steal|dump|harvest|exfiltrat)\\w*\\b[^.]{0,40}\\b(password|credential|token|cookie|secret)s?\\b|\\b(password|credential|token|secret)s?\\b[^.]{0,30}\\b(steal|dump|harvest|exfiltrat)\\w*\\b|\\bmimikatz\\b",
      "reason": "Credential theft or dumping is prohibited."
    },
    {
      "id": "purchase-or-account-bypass",
      "pattern": "\\b(bypass|circumvent|defeat)\\b[^.]{0,40}\\b(account|payment|purchase|subscription|paywall|trial)\\b|\\b(account|payment|purchase|subscription|paywall|trial)\\b[^.]{0,30}\\b(bypass|circumvent|defeat)\\b",
      "reason": "Account, payment, purchase, or trial bypass is prohibited."
    },
    {
      "id": "access-control-bypass",
      "pattern": "\\b(bypass|circumvent|disable|escape)\\b[^.]{0,40}\\b(access control|authentication|authorization|permission check|sandbox escape|audit log)\\b|\\b(access control|authentication|authorization|permission check|audit log)\\b[^.]{0,30}\\b(bypass|circumvent|disable)\\b",
      "reason": "Access-control or audit bypass is prohibited."
    },
    {
      "id": "privacy-control-bypass",
      "pattern": "\\b(bypass|disable|void)\\b[^.]{0,40}\\b(privacy control|consent|data protection|gdpr)\\b|\\b(privacy control|consent|data protection|gdpr)\\b[^.]{0,30}\\b(bypass|disable|void)\\b",
      "reason": "Privacy-control bypass is prohibited."
    }
  ],
  "boundary_allow_note": "Legitimate compatibility, preservation, inspection, repair, and rights-respecting migration work remains allowed.",
  "version_pins": {
    "python3": "3.9",
    "git": "2.30",
    "node": "18",
    "npm": "9",
    "java": "17",
    "openssl": "1.1.1",
    "gcc": "9",
    "clang": "12",
    "cmake": "3.20",
    "ninja": "1.10",
    "readelf": "2.38",
    "objdump": "2.38",
    "strings": "2.38",
    "file": "5.40",
    "zip": "3.0",
    "unzip": "6.0",
    "sqlite3": "3.35",
    "ffmpeg": "4.4",
    "ffprobe": "4.4",
    "llvm-readelf": "12",
    "dotnet": "6.0",
    "mono": "6.0",
    "mingw-gcc": "10.0",
    "wine": "6.0",
    "qemu-system-x86_64": "6.0",
    "qemu-img": "6.0",
    "7z": "21.0",
    "r2": "5.0",
    "diec": "2.0",
    "make": "4.0",
    "magick": "7.0",
    "exiftool": "12.0",
    "gdb": "9.0",
    "strace": "5.0",
    "valgrind": "3.18",
    "diffoscope": "2021.1",
    "tshark": "3.4",
    "docker": "20.10",
    "podman": "4.0",
    "pefile-lief": null
  },
  "capability_combinations": [
    {
      "id": "windows-cross-build",
      "requires_any": [
        "mingw-gcc"
      ],
      "reason": "Building Windows EXE/DLL outputs from this host requires a MinGW-w64 cross compiler."
    },
    {
      "id": "compatibility-lanes",
      "requires_any": [
        "wine"
      ],
      "reason": "Wine/Proton compatibility lanes require a Wine runtime on the host."
    },
    {
      "id": "virtualization-lanes",
      "requires_any": [
        "qemu-system-x86_64"
      ],
      "reason": "VM test lanes require a QEMU system emulator."
    },
    {
      "id": "managed-dotnet-lane",
      "requires_any": [
        "dotnet",
        "mono"
      ],
      "reason": "Managed .NET builds or runs require a .NET SDK or Mono runtime."
    },
    {
      "id": "media-lane",
      "requires_any": [
        "ffmpeg",
        "ffprobe"
      ],
      "reason": "Audio/video inspection and conversion requires FFmpeg tools."
    }
  ],
  "limits": {
    "probe_timeout_sec": 10,
    "probe_retries": 1,
    "asset_max_bytes": 52428800,
    "parse_input_max_bytes": 5242880,
    "route_max_matches": 5,
    "route_max_matches_cap": 20,
    "clean_state_timeout_sec": 30,
    "clean_state_max_repeats": 3,
    "clean_state_max_argv": 32,
    "clean_state_max_arg_len": 4096,
    "plan_max_backup_bytes": 2147483648,
    "provenance_max_sources": 32,
    "provenance_max_command_len": 2000,
    "provenance_max_records_read": 1000,
    "artifact_probe_bytes": 8192
  },
  "execution_gates": {
    "clean-state": "operator",
    "plan-change": "per classified action risk",
    "rollback": "external"
  }
}
