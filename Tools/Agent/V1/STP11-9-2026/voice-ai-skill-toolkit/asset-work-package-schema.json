{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-work-package-schema.json",
  "title": "Voice Work Package Manifest",
  "type": "object",
  "required": ["package_id", "skill_id", "title", "status", "language", "created_by", "created_at"],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Lowercase hyphenated identifier, e.g. acme-podcast-ep12."
    },
    "skill_id": {
      "type": "string",
      "minLength": 3,
      "description": "Catalog skill id (slug) or number, e.g. number-verbalization-engine or 2.3."
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "approved", "delivered", "archived"]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$",
      "description": "BCP-47 language tag, e.g. en, en-US, fil-PH."
    },
    "locale": { "type": "string", "maxLength": 32 },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 120 },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.+Zz-]{4,})?$",
      "description": "ISO 8601 date or datetime, e.g. 2026-11-09 or 2026-11-09T14:03:00Z."
    },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.+Zz-]{4,})?$" },
    "consent_required": { "type": "boolean" },
    "tier": { "type": "string", "enum": ["standard", "review", "elevated"] },
    "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "channels": { "type": "integer", "minimum": 1, "maximum": 32 },
    "delivery_profile": { "type": "string" },
    "speaker_authorization": { "type": "string", "maxLength": 200, "description": "Who authorized the voice / recording, if any." },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "approver", "date", "decision"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "approver": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected", "changes-requested"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["text", "audio", "transcript", "lexicon", "prompt", "model", "policy", "report", "metadata", "consent", "other"]
        },
        "path": { "type": "string", "description": "Path relative to the work-package folder." },
        "role": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
