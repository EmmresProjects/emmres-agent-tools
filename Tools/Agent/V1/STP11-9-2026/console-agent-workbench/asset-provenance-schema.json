{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "console-agent-workbench/provenance-record",
  "note": "Validated by the built-in JSON Schema subset validator (see knowledge-readme.md).",
  "title": "Preservation provenance record",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "operator",
    "created_at",
    "material",
    "dump",
    "integrity",
    "provenance",
    "rights"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "provenance"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 4
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "material": {
      "type": "object",
      "required": [
        "reference",
        "media_type",
        "ownership"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "enum": [
            "cartridge",
            "optical-disc",
            "magnetic-media",
            "card",
            "save-memory",
            "firmware",
            "executable",
            "archive",
            "unknown"
          ]
        },
        "region": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "ownership": {
          "type": "string",
          "enum": [
            "owned",
            "authorized",
            "public-domain",
            "licensed-archive",
            "unknown"
          ]
        },
        "detected_format": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "dump": {
      "type": "object",
      "required": [
        "method",
        "reader",
        "hardware",
        "firmware",
        "reads"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reader": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "firmware": {
          "type": "string",
          "minLength": 1
        },
        "software_versions": {
          "type": "object"
        },
        "reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "size",
        "crc32",
        "sha1",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "crc32": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "md5": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dat_match": {
          "type": "object"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "acquisition_date"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "rights": {
      "type": "object",
      "required": [
        "redistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "redistribution": {
          "type": "string",
          "enum": [
            "none",
            "unknown",
            "permitted",
            "embargoed"
          ]
        },
        "attribution": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
