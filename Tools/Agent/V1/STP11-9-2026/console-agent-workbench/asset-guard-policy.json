{
  "schema_version": "1.0",
  "policy_id": "console-agent-guard",
  "title": "Lawful console preservation guard policy",
  "principles": [
    "Use only media, firmware, keys, certificates, accounts, devices and SDKs the operator lawfully owns or is authorized to use.",
    "Never bundle or disclose copyrighted game content, BIOS/firmware images, encryption or title keys, console certificates, leaked SDKs, signing keys, DRM bypasses or account bypasses.",
    "Route modern PlayStation, Xbox and Nintendo work to official partner programs and licensed hardware only.",
    "Reports carry metadata only unless redistribution rights are explicitly established by the operator.",
    "Emulation availability never implies title compatibility, redistribution rights, or a replacement for official certification."
  ],
  "authorization_materials": [
    "media",
    "firmware",
    "keys",
    "accounts",
    "certificates",
    "devices",
    "sdks",
    "development-materials"
  ],
  "file_rules": [
    {
      "id": "restricted-bios-firmware",
      "kind": "filename_pattern",
      "pattern": "(?i)^(boot0|boot1|boot9|boot11|boot2|otp|prod|title|seed|common)\\.(bin|keys|dat)$|^(scph\\d{5}\\.bin)$|^(bios|firmware|fw)[-_].*\\.(bin|rom)$",
      "severity": "critical",
      "category": "firmware-or-bios",
      "reason": "console BIOS or firmware image",
      "remediation": "keep out of any package or report; reference it only by operator-held path and hash"
    },
    {
      "id": "console-key-material",
      "kind": "filename_pattern",
      "pattern": "(?i)\\.(keys|kek|tik|tmd|cert|cer|xci|keypair)$",
      "severity": "critical",
      "category": "keys-and-certificates",
      "reason": "console key or certificate container",
      "remediation": "never copy, bundle, print or hash-dump key material into shared reports"
    },
    {
      "id": "private-key-material",
      "kind": "extension",
      "values": [
        ".pem",
        ".key",
        ".p12",
        ".pfx",
        ".jks",
        ".asc",
        ".gpg",
        ".ppk"
      ],
      "severity": "critical",
      "category": "credentials",
      "reason": "private key or credential store",
      "remediation": "remove from the working set; use the platform's own credential store"
    },
    {
      "id": "leaked-sdk-marker",
      "kind": "filename_pattern",
      "pattern": "(?i)(leaked|sdk[-_ ]?leak|proprietary[-_ ]?sdk|_ndk_dump|sdk_?dump)",
      "severity": "critical",
      "category": "leaked-sdk",
      "reason": "name indicates a leaked or unauthorized SDK",
      "remediation": "delete the reference and obtain access through the official program"
    },
    {
      "id": "devkit-serial-record",
      "kind": "filename_pattern",
      "pattern": "(?i).*(devkit|testkit|dec[-_]?serial|dex[-_]?serial|prodg|ndk[-_]?serial).*",
      "severity": "high",
      "category": "devkit-identifiers",
      "reason": "devkit-related file may contain serial numbers or NDA material",
      "remediation": "redact serials before sharing; keep the original in the restricted store"
    },
    {
      "id": "cartridge-rom-image",
      "kind": "extension",
      "values": [
        ".nes",
        ".fds",
        ".unf",
        ".unif",
        ".sfc",
        ".smc",
        ".fig",
        ".swc",
        ".st",
        ".n64",
        ".z64",
        ".v64",
        ".ndd",
        ".gb",
        ".gbc",
        ".gba",
        ".vb",
        ".vboy",
        ".sms",
        ".gg",
        ".sg",
        ".32x",
        ".md",
        ".gen",
        ".smd",
        ".a26",
        ".a52",
        ".a78",
        ".j64",
        ".jag",
        ".col",
        ".int",
        ".vec",
        ".rom",
        ".ngc",
        ".ws",
        ".wsc",
        ".pce",
        ".lnx"
      ],
      "severity": "high",
      "category": "game-content",
      "ambiguous_extensions": [
        ".md",
        ".bin",
        ".rom",
        ".dat",
        ".st",
        ".gg",
        ".col",
        ".int"
      ],
      "reason": "cartridge image that may contain copyrighted game content",
      "remediation": "keep in the operator's lawful library; never redistribute without rights"
    },
    {
      "id": "optical-image",
      "kind": "extension",
      "values": [
        ".iso",
        ".cue",
        ".chd",
        ".gdi",
        ".cdi",
        ".img",
        ".mds",
        ".mdf",
        ".ccd",
        ".sub",
        ".toc",
        ".nrg",
        ".cso",
        ".rvz",
        ".wbfs",
        ".gcm",
        ".bin"
      ],
      "severity": "medium",
      "category": "game-content",
      "ambiguous_extensions": [
        ".bin",
        ".img",
        ".dat"
      ],
      "reason": "optical image that may contain copyrighted game content",
      "remediation": "verify ownership and rights before any redistribution decision"
    },
    {
      "id": "save-memory-image",
      "kind": "extension",
      "values": [
        ".sav",
        ".srm",
        ".eep",
        ".fla",
        ".mpk",
        ".mcr",
        ".mcd",
        ".vms",
        ".ps2",
        ".dsv",
        ".sav0",
        ".dat0"
      ],
      "severity": "low",
      "category": "personal-data",
      "reason": "save memory that may contain personal data or account identifiers",
      "remediation": "treat as personal data; apply the retention policy before sharing"
    },
    {
      "id": "archive-container",
      "kind": "extension",
      "values": [
        ".zip",
        ".7z",
        ".rar",
        ".tar",
        ".gz",
        ".xz",
        ".bz2",
        ".tgz",
        ".zst"
      ],
      "severity": "high",
      "category": "packaging",
      "reason": "archive found inside a delivery or scan set",
      "remediation": "deliver expanded files; nested archives are not allowed in a Skill Tool package"
    },
    {
      "id": "oversized-binary",
      "kind": "size_threshold",
      "min_bytes": 268435456,
      "severity": "medium",
      "category": "packaging",
      "reason": "binary larger than 256 MiB",
      "remediation": "confirm the file is lawful to keep and is not raw media you may not redistribute"
    }
  ],
  "content_rules": [
    {
      "id": "private-key-block",
      "kind": "content_regex",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----",
      "severity": "critical",
      "category": "credentials",
      "reason": "PEM private key block",
      "remediation": "remove the file from the working set and rotate the key"
    },
    {
      "id": "account-credential",
      "kind": "content_regex",
      "pattern": "(?i)(api[_-]?key|api[_-]?token|client[_-]?secret|password|passwd|token)\\s*[:=]\\s*[\\\"']?[A-Za-z0-9._~+/=-]{8,}",
      "severity": "critical",
      "category": "credentials",
      "reason": "credential-shaped assignment",
      "remediation": "move secrets to the platform credential store and re-issue"
    },
    {
      "id": "console-key-blob",
      "kind": "content_regex",
      "pattern": "(?i)(aes[-_ ]?key|title[-_ ]?key|common[-_ ]?key|keyblob|key_blob)",
      "severity": "high",
      "category": "keys-and-certificates",
      "reason": "console key material reference",
      "remediation": "keep key material out of logs, reports and packages"
    },
    {
      "id": "nda-confidential",
      "kind": "content_regex",
      "pattern": "(?i)(\\bunder nda\\b|confidential[^\\n]{0,40}(sony|nintendo|microsoft|playstation|xbox)|do not distribute)",
      "severity": "high",
      "category": "nda-material",
      "reason": "document marked confidential or NDA-bound",
      "remediation": "exclude from shareable artifacts; keep only in the restricted workspace"
    },
    {
      "id": "drm-or-account-bypass",
      "kind": "content_regex",
      "pattern": "(?i)(drm[-_ ]?bypass|anti[-_ ]?cheat[-_ ]?bypass|account[-_ ]?bypass|pirated|cracked[\\s_-]?(rom|iso|game))",
      "severity": "critical",
      "category": "circumvention",
      "reason": "circumvention or piracy marker",
      "remediation": "refuse the task and record the refusal; this tool does not support circumvention"
    },
    {
      "id": "devkit-identifier",
      "kind": "content_regex",
      "pattern": "(?i)\\b(DECR|DEX|DEVKIT|TESTKIT|XDK|PRODG)[-_]?(?=[0-9A-Z]*\\d)[0-9A-Z]{3,}\\b",
      "severity": "medium",
      "category": "devkit-identifiers",
      "reason": "devkit or testkit identifier",
      "remediation": "redact before sharing; identifiers can link to partner accounts"
    }
  ],
  "redaction_rules": [
    {
      "id": "home-paths",
      "pattern": "(?:[A-Za-z]:\\\\|/)(?:home|Users|root|mnt|media|Volumes|private|opt|srv)/[^\\s\\\"'<>|)]*",
      "replacement": "<PATH>"
    },
    {
      "id": "windows-paths",
      "pattern": "[A-Za-z]:\\\\[^\\s\\\"'<>|)]+",
      "replacement": "<PATH>"
    },
    {
      "id": "private-key-block",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "replacement": "<PRIVATE KEY REDACTED>"
    },
    {
      "id": "email-address",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replacement": "<EMAIL>"
    },
    {
      "id": "credential-value",
      "pattern": "(?i)((?:api[_-]?key|api[_-]?token|client[_-]?secret|secret|password|passwd|token)\\s*[:=]\\s*)[\\\"']?[A-Za-z0-9._~+/=-]{6,}",
      "replacement": "\\1<CREDENTIAL>"
    },
    {
      "id": "bearer-token",
      "pattern": "(?i)(bearer\\s+)[A-Za-z0-9._-]{12,}",
      "replacement": "\\1<TOKEN>"
    },
    {
      "id": "devkit-identifier",
      "pattern": "(?i)\\b(DECR|DEX|DEVKIT|TESTKIT|XDK|PRODG)[-_]?(?=[0-9A-Z]*\\d)[0-9A-Z]{3,}\\b",
      "replacement": "\\1-<SERIAL>"
    },
    {
      "id": "ipv4-address",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b",
      "replacement": "<IP>"
    }
  ],
  "verdicts_by_mode": {
    "package": {
      "block": [
        "critical",
        "high"
      ],
      "review": [
        "medium",
        "low"
      ]
    },
    "redistribute": {
      "block": [
        "critical",
        "high"
      ],
      "review": [
        "medium"
      ]
    },
    "bundle": {
      "block": [
        "critical"
      ],
      "review": [
        "high",
        "medium",
        "low"
      ]
    },
    "report": {
      "block": [],
      "review": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    }
  },
  "approval_required_actions": [
    "retention-apply",
    "retention-hard-delete",
    "publish-report",
    "write-firmware",
    "flash-hardware"
  ],
  "retention": {
    "default_class": "default",
    "default_days": 365,
    "quarantine_dirname": "caw-quarantine",
    "classes": [
      {
        "id": "records",
        "extensions": [
          ".json",
          ".jsonl",
          ".md",
          ".csv"
        ],
        "days": 3650
      },
      {
        "id": "dumps",
        "extensions": [
          ".bin",
          ".img",
          ".iso",
          ".chd",
          ".rom",
          ".nes",
          ".gb"
        ],
        "days": 3650
      },
      {
        "id": "logs",
        "extensions": [
          ".log",
          ".txt",
          ".out"
        ],
        "days": 180
      },
      {
        "id": "captures",
        "extensions": [
          ".png",
          ".jpg",
          ".jpeg",
          ".wav",
          ".mp4",
          ".webm"
        ],
        "days": 180
      },
      {
        "id": "crash",
        "extensions": [
          ".dmp",
          ".core",
          ".stack"
        ],
        "days": 90
      },
      {
        "id": "temporary",
        "extensions": [
          ".tmp",
          ".partial"
        ],
        "days": 7
      }
    ]
  },
  "scan_exempt_filenames": [
    "asset-guard-policy.json",
    "asset-capability-catalog.json",
    "knowledge-readme.md"
  ],
  "scan_exempt_note": "These packaged documentation files necessarily contain the rule patterns and catalog wording they describe. Exemption is by exact filename and is always reported in the scan 'skipped' list; it never covers media, keys, firmware, or operator files.",
  "scan_limits": {
    "max_files": 20000,
    "max_depth": 24,
    "max_read_bytes": 65536,
    "overall_timeout_seconds": 300
  }
}
