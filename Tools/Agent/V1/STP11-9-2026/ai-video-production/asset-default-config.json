{
  "schema_version": "1.0",
  "limits": {
    "max_input_bytes": 1048576,
    "max_duration_seconds": 3600,
    "max_shots": 500,
    "max_capabilities_per_plan": 564,
    "max_caption_characters": 500000
  },
  "runtime": {
    "timeout_seconds": 120,
    "retries": 1,
    "retry_backoff_seconds": 1.0,
    "ffmpeg_executable": "ffmpeg",
    "ffprobe_executable": "ffprobe"
  },
  "defaults": {
    "duration_seconds": 12,
    "aspect_ratio": "16:9",
    "resolution": [1280, 720],
    "fps": 24,
    "language": "en",
    "background_colors": ["#111827", "#164e63", "#3f2d5b", "#134e4a", "#4a2c20"],
    "foreground_color": "#f8fafc",
    "accent_color": "#67e8f9"
  },
  "providers": {
    "generation": {
      "name": "none",
      "model": "none",
      "endpoint": null,
      "credential_environment_variable": null
    }
  },
  "policy": {
    "require_approval_for": ["render", "publish", "train", "likeness", "voice_cloning", "sensitive_content", "factual_reconstruction", "overwrite"],
    "allow_network": false,
    "allow_shell": false
  }
}
