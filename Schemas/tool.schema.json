{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emmre Tool Metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "category",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "experimental",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  }
}
