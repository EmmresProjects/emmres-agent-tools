{
  "description": "Canvas sizes, delivery specifications and layout templates for image.layout_compose, image.delivery_audit and image.responsive_crop. Sizes are common starting points, not platform guarantees; confirm each destination's current rules. Elements use pixel boxes [x, y, width, height]. Any {key} in a string is replaced from the 'texts' input.",
  "canvases": {
    "social-square": {"size": [1080, 1080], "background": "#ffffff"},
    "social-portrait": {"size": [1080, 1350], "background": "#ffffff"},
    "social-story": {"size": [1080, 1920], "background": "#ffffff"},
    "web-banner": {"size": [1500, 500], "background": "#ffffff"},
    "video-thumbnail": {"size": [1280, 720], "background": "#111111"},
    "poster": {"size": [1800, 2546], "background": "#fafafa"},
    "packaging-panel": {"size": [1200, 1200], "background": "#f5f1e8"},
    "ecommerce-white": {"size": [2000, 2000], "background": "#ffffff"},
    "brand-template": {"size": [1600, 900], "background": "#f5f5f5"}
  },
  "layouts": {
    "poster": {
      "canvas": "poster",
      "elements": [
        {"type": "image", "src": "hero", "box": [0, 0, 1800, 1900], "fit": "cover"},
        {"type": "rect", "box": [0, 1900, 1800, 646], "fill": "{brand_color}"},
        {"type": "text", "text": "{title}", "box": [120, 1960, 1560, 200], "font_size": 96, "color": "#ffffff", "align": "left"},
        {"type": "text", "text": "{call_to_action}", "box": [120, 2220, 1560, 90], "font_size": 48, "color": "#ffffff", "align": "left"}
      ]
    },
    "social-square": {
      "canvas": "social-square",
      "elements": [
        {"type": "image", "src": "hero", "box": [0, 0, 1080, 1080], "fit": "cover"},
        {"type": "rect", "box": [0, 880, 1080, 200], "fill": "{brand_color}"},
        {"type": "text", "text": "{title}", "box": [60, 910, 960, 140], "font_size": 60, "color": "#ffffff", "align": "left"}
      ]
    },
    "packaging-panel": {
      "canvas": "packaging-panel",
      "elements": [
        {"type": "rect", "box": [0, 0, 1200, 1200], "fill": "#f5f1e8"},
        {"type": "image", "src": "product", "box": [200, 200, 800, 800], "fit": "contain"},
        {"type": "text", "text": "{title}", "box": [100, 1030, 1000, 110], "font_size": 56, "color": "#222222", "align": "center"}
      ]
    },
    "brand-template": {
      "canvas": "brand-template",
      "elements": [
        {"type": "rect", "box": [0, 0, 1600, 900], "fill": "{brand_color}"},
        {"type": "image", "src": "logo", "box": [1200, 60, 340, 160], "fit": "contain"},
        {"type": "image", "src": "hero", "box": [80, 180, 1040, 640], "fit": "cover"},
        {"type": "text", "text": "{title}", "box": [1160, 360, 380, 260], "font_size": 52, "color": "#ffffff", "align": "left"}
      ]
    },
    "ecommerce-white": {
      "canvas": "ecommerce-white",
      "elements": [
        {"type": "image", "src": "product", "box": [200, 200, 1600, 1600], "fit": "contain"}
      ]
    }
  },
  "delivery_specs": {
    "generic-web": {"min_width": 400, "min_height": 400, "max_bytes": 5242880, "formats": ["png", "jpeg", "webp"], "require_srgb": false, "square": false},
    "marketplace-generic": {"min_width": 1000, "min_height": 1000, "max_bytes": 10485760, "formats": ["jpeg", "png"], "require_srgb": true, "square": true},
    "technical-reference": {"min_width": 2000, "min_height": 2000, "max_bytes": 52428800, "formats": ["png", "tiff"], "require_srgb": true, "square": false},
    "print-300": {"min_width": 1200, "min_height": 1200, "max_bytes": 209715200, "formats": ["tiff", "png", "jpeg"], "require_srgb": false, "square": false, "min_dpi": 300}
  },
  "crop_targets": {
    "1:1": [1, 1], "4:5": [4, 5], "9:16": [9, 16], "16:9": [16, 9], "1.91:1": [191, 100], "3:1": [3, 1], "2:3": [2, 3]
  }
}
