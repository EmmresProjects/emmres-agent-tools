{
  "guide_version": "1.0",
  "default_profile": "academic",
  "quotes": "straight",
  "serial_comma": true,
  "profiles": {
    "academic": {
      "description": "Scholarly prose for journals, theses and technical reports.",
      "banned_terms": ["basically", "actually", "very unique", "needless to say", "utilize",
                       "in order to", "a lot of", "tons of", "obviously"],
      "preferred": {"utilize": "use", "in order to": "to", "a lot of": "many", "prior to": "before",
                    "commence": "start", "terminate": "end", "ascertain": "find out"},
      "max_sentence_words": 32,
      "hedging": "use calibrated hedges tied to evidence strength",
      "citation_system": "author-date"
    },
    "plain": {
      "description": "Plain-language summaries for public and operational readers.",
      "banned_terms": ["heretofore", "whereas", "pursuant to", "notwithstanding", "utilize",
                       "facilitate", "endeavour", "aforementioned"],
      "preferred": {"pursuant to": "under", "notwithstanding": "despite", "commence": "start"},
      "max_sentence_words": 20,
      "hedging": "state uncertainty in ordinary words",
      "citation_system": "author-date"
    },
    "policy": {
      "description": "Decision-oriented policy briefs.",
      "banned_terms": ["arguably", "it is well known", "clearly", "obviously", "many say"],
      "preferred": {"stakeholders": "affected groups", "leverage": "use"},
      "max_sentence_words": 26,
      "hedging": "state the strength of evidence in the options section",
      "citation_system": "author-date"
    },
    "legal": {
      "description": "Legal memoranda and standards compliance writing.",
      "banned_terms": ["clearly", "obviously", "undoubtedly"],
      "preferred": {"shall": "must", "hereinafter": "from here on"},
      "max_sentence_words": 40,
      "hedging": "separate binding obligation from persuasive authority",
      "citation_system": "oscola"
    }
  },
  "typography": {
    "quote_style": "straight",
    "dash": "en-dash with spaces",
    "ellipsis": "three dots",
    "number_style": "numerals above ten, words at or below ten"
  },
  "accessibility": {
    "required_checks": ["headings", "alt_text", "table_headers", "link_text"],
    "max_alt_text_characters": 250,
    "min_contrast_ratio": 4.5,
    "language_attribute_required": true
  },
  "translation_style": {
    "fil": {
      "register": "formal, second person avoided in findings",
      "preferred": {"data": "datos", "stakeholders": "mga kinauukulan"},
      "forbidden": ["magandang umaga sa lahat ng"],
      "number_style": "period decimal, comma thousands",
      "date_format": "5 Marso 2024"
    },
    "en-PH": {
      "spelling": "Philippine English (US spelling, local institutional terms retained)",
      "date_format": "5 March 2024",
      "currency": "PHP with ISO code on first use"
    }
  }
}
