{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-result-schema.json",
  "title": "Offline Neural Voice CLI result envelope",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "tool",
    "generated_at",
    "data"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "tool": {
      "type": "string",
      "pattern": "^offline-neural-voice"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill": {
      "type": "string",
      "const": "offline-neural-voice"
    },
    "skill_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "approval_required": {
      "type": "boolean"
    },
    "cancelled": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "data": {
      "type": "object"
    },
    "exit_code": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
