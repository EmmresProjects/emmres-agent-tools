  "description": "Versioned delivery presets. Each preset maps a human performance direction onto engine scales (length_scale, noise_scale, noise_w) and mastering settings. Values are bounded by the tool: length 0.45..2.2, noise 0.2..1.2.",
  "default_preset": "warm-friendly",
  "scales_reference": {
    "length_scale": "higher is slower and more deliberate (1.0 = model default)",
    "noise_scale": "higher adds timbre variation and expression, lower is flatter",
    "noise_w": "higher varies phoneme durations, lower is metronomic"
  },
