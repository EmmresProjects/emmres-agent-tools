{
  "policy_version": "1.0",
  "limits": {
    "max_input_bytes": 2097152,
    "max_catalog_bytes": 8388608,
    "max_capabilities_per_request": 249,
    "max_evidence_items": 5000,
    "max_output_bytes": 33554432,
    "default_timeout_seconds": 30,
    "max_timeout_seconds": 300,
    "max_text_characters": 200000,
    "max_string_characters": 4000
  },
  "approval": {
    "production_execution_requires_approval": true,
    "high_risk_execution_requires_approval": true,
    "maximum_age_hours": 24,
    "allow_expired": false
  },
  "assessment": {
    "maximum_evidence_age_hours": 720,
    "future_skew_seconds": 300,
    "allow_not_applicable_for_required": false,
    "require_change_ticket_for_execution": true,
    "require_rollback_for_high_risk_execution": true,
    "require_backup_for_destructive_execution": true,
    "require_success_criteria_for_execution": true,
    "require_monitoring_for_production_execution": true
  },
  "output": {
    "redact_sensitive_keys": true,
    "atomic_writes": true,
    "overwrite_requires_force": true
  }
}
