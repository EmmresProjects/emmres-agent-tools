{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-brief-schema.json",
  "title": "Presentation brief",
  "description": "Requirements input for tools-presentation-makers.py brief/plan/draft/build/pipeline. Every field except title, purpose, and audience.primary is optional; the tool fills safe defaults and reports what it assumed.",
  "type": "object",
  "required": ["title", "purpose", "audience"],
  "properties": {
    "brief_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 140},
    "purpose": {
      "type": "string",
      "enum": ["decide", "inform", "persuade", "teach", "train", "sell", "fundraise", "status", "research", "launch", "align", "recap"]
    },
    "purpose_detail": {"type": "string", "maxLength": 600},
    "audience": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"type": "string", "minLength": 2, "maxLength": 120},
        "secondary": {"type": "string", "maxLength": 120},
        "size": {"type": "string", "maxLength": 60},
        "expertise": {"type": "string", "enum": ["novice", "mixed", "practitioner", "expert", "executive"]},
        "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"},
        "objections": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 6}
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["live-stage", "classroom", "sales-call", "remote-meeting", "recorded-narration", "self-running-kiosk", "embedded-web", "printable-handout", "workshop"]
        },
        "venue": {"type": "string", "maxLength": 120},
        "duration_minutes": {"type": "integer", "minimum": 3, "maximum": 480},
        "recorded": {"type": "boolean"},
        "asynchronous": {"type": "boolean"},
        "devices": {"type": "array", "items": {"type": "string", "maxLength": 60}, "maxItems": 8},
        "network": {"type": "string", "enum": ["reliable", "unreliable", "offline"]}
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "slides_target": {"type": "integer", "minimum": 1, "maximum": 500},
        "deadline": {"type": "string", "maxLength": 40},
        "must_include": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 25},
        "must_exclude": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 25},
        "brand_assets": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 25},
        "approved_fonts": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 20},
        "approved_colors": {"type": "array", "items": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"}, "maxItems": 20},
        "logo_required": {"type": "boolean"},
        "editability": {"type": "string", "enum": ["editable-source-required", "pdf-fine", "web-fine", "video-fine"]}
      },
      "additionalProperties": true
    },
    "priorities": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": ["precision", "automation", "templates", "collaboration", "offline", "animation", "ai_drafting", "analytics", "affordability", "compatibility", "learning_ease", "accessibility", "interactivity", "data_visuals", "web_publishing", "print"]
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "preferred": {"type": "string", "maxLength": 60},
        "must_support": {"type": "array", "items": {"type": "string", "maxLength": 40}, "maxItems": 10},
        "forbidden": {"type": "array", "items": {"type": "string", "maxLength": 40}, "maxItems": 10}
      },
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "properties": {
        "source_files": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 20},
        "data_files": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 20},
        "existing_deck": {"type": "string", "maxLength": 300}
      },
      "additionalProperties": true
    },
    "narrative": {
      "type": "object",
      "properties": {
        "framework": {"type": "string", "maxLength": 60},
        "tone": {"type": "string", "enum": ["plain", "formal", "warm", "urgent", "technical", "playful"]},
        "language": {"type": "string", "maxLength": 20}
      },
      "additionalProperties": true
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "standard": {"type": "string", "enum": ["wcag-aa", "wcag-aaa", "internal-baseline"]},
        "captions_required": {"type": "boolean"},
        "screen_reader_required": {"type": "boolean"},
        "reduced_motion": {"type": "boolean"},
        "min_body_pt": {"type": "number", "minimum": 10, "maximum": 36}
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "properties": {
        "confidential": {"type": "boolean"},
        "external_audience": {"type": "boolean"},
        "pii_expected": {"type": "boolean"},
        "retention_days": {"type": "integer", "minimum": 0, "maximum": 3650},
        "public_publishing": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "call_to_action": {
      "type": "object",
      "properties": {
        "decision": {"type": "string", "maxLength": 240},
        "owner": {"type": "string", "maxLength": 120},
        "deadline": {"type": "string", "maxLength": 60}
      },
      "additionalProperties": true
    },
    "success_criteria": {"type": "array", "items": {"type": "string", "maxLength": 240}, "maxItems": 12},
    "theme": {"type": "string", "maxLength": 40},
    "review_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {"type": "string", "maxLength": 60},
          "approver": {"type": "string", "maxLength": 120},
          "required": {"type": "boolean"}
        }
      },
      "maxItems": 12
    }
  },
  "additionalProperties": true
}
