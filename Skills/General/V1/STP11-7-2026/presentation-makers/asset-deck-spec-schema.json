{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-deck-spec-schema.json",
  "title": "Deck specification",
  "description": "The single source of truth consumed by build, audit, diff, benchmark, export and package. Produced by plan/draft and safe to hand-edit.",
  "type": "object",
  "required": ["spec_version", "deck", "slides"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "deck": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 3, "maxLength": 160},
        "subtitle": {"type": "string", "maxLength": 200},
        "organization": {"type": "string", "maxLength": 120},
        "author": {"type": "string", "maxLength": 120},
        "audience": {"type": "string", "maxLength": 160},
        "purpose": {"type": "string", "maxLength": 80},
        "delivery_mode": {"type": "string", "maxLength": 60},
        "platform": {"type": "string", "maxLength": 60},
        "language": {"type": "string", "maxLength": 20},
        "date": {"type": "string", "maxLength": 40},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
        "framework": {"type": "string", "maxLength": 60},
        "theme_id": {"type": "string", "maxLength": 40},
        "classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
        "reduced_motion": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 40},
        "background": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "surface": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "text_primary": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "text_secondary": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "accent_alt": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "text_on_accent": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "fonts": {"type": "object"},
        "typography_pt": {"type": "object"},
        "chart_series": {"type": "array", "items": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"}, "maxItems": 8}
      },
      "additionalProperties": true
    },
    "call_to_action": {
      "type": "object",
      "properties": {
        "decision": {"type": "string", "maxLength": 300},
        "owner": {"type": "string", "maxLength": 120},
        "deadline": {"type": "string", "maxLength": 60}
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "id": {"type": "string", "maxLength": 60},
          "title": {"type": "string", "maxLength": 140},
          "purpose": {"type": "string", "maxLength": 300},
          "slide_ids": {"type": "array", "items": {"type": "string", "maxLength": 60}, "maxItems": 60}
        },
        "additionalProperties": true
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "object",
        "required": ["id", "role", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"},
          "role": {
            "type": "string",
            "enum": ["title", "agenda", "section", "concept", "evidence", "comparison", "process", "timeline", "table", "metrics", "quote", "demonstration", "decision", "summary", "appendix"]
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "subtitle": {"type": "string", "maxLength": 240},
          "section_id": {"type": "string", "maxLength": 60},
          "bullets": {"type": "array", "items": {"type": "string", "maxLength": 400}, "maxItems": 12},
          "left": {"type": "array", "items": {"type": "string", "maxLength": 240}, "maxItems": 8},
          "right": {"type": "array", "items": {"type": "string", "maxLength": 240}, "maxItems": 8},
          "left_title": {"type": "string", "maxLength": 80},
          "right_title": {"type": "string", "maxLength": 80},
          "steps": {"type": "array", "items": {"type": "string", "maxLength": 160}, "maxItems": 8},
          "phases": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "label": {"type": "string", "maxLength": 60},
                "date": {"type": "string", "maxLength": 40},
                "detail": {"type": "string", "maxLength": 160}
              }
            }
          },
          "metrics": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": {"type": "string", "maxLength": 60},
                "value": {"type": "string", "maxLength": 24},
                "note": {"type": "string", "maxLength": 120},
                "source": {"type": "string", "maxLength": 200}
              }
            }
          },
          "table": {
            "type": "object",
            "properties": {
              "headers": {"type": "array", "items": {"type": "string", "maxLength": 60}, "maxItems": 6},
              "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 6}, "maxItems": 8},
              "caption": {"type": "string", "maxLength": 200}
            }
          },
          "quote": {
            "type": "object",
            "properties": {
              "text": {"type": "string", "maxLength": 400},
              "attribution": {"type": "string", "maxLength": 160}
            }
          },
          "notes": {"type": "string", "maxLength": 4000},
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "claim": {"type": "string", "maxLength": 240},
                "source": {"type": "string", "maxLength": 300},
                "url": {"type": "string", "maxLength": 500}
              }
            }
          },
          "image": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "maxLength": 300},
              "alt_text": {"type": "string", "maxLength": 300},
              "decorative": {"type": "boolean"},
              "rights": {"type": "string", "maxLength": 200},
              "credit": {"type": "string", "maxLength": 200}
            }
          },
          "media": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "kind": {"type": "string", "enum": ["audio", "video", "screen-recording", "embed"]},
                "path": {"type": "string", "maxLength": 300},
                "captions": {"type": "string", "maxLength": 300},
                "autoplay": {"type": "boolean"},
                "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 7200},
                "rights": {"type": "string", "maxLength": 200}
              }
            }
          },
          "animation": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "object": {"type": "string", "maxLength": 80},
                "effect": {"type": "string", "enum": ["appear", "fade", "fly-in", "wipe", "zoom", "pulse", "grow", "spin", "motion-path", "disappear"]},
                "trigger": {"type": "string", "enum": ["on-click", "with-previous", "after-previous", "on-page-load"]},
                "duration_seconds": {"type": "number", "minimum": 0, "maximum": 30},
                "flashes_per_second": {"type": "number", "minimum": 0, "maximum": 60}
              }
            }
          },
          "links": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "label": {"type": "string", "maxLength": 80},
                "url": {"type": "string", "maxLength": 500},
                "kind": {"type": "string", "enum": ["external", "internal-slide", "file", "email"]}
              }
            }
          },
          "data": {
            "type": "object",
            "properties": {
              "chart_type": {"type": "string", "enum": ["bar", "line", "pie", "scatter", "area", "table", "kpi", "none"]},
              "series": {"type": "array", "items": {"type": "string", "maxLength": 60}, "maxItems": 12},
              "values": {"type": "array", "items": {"type": "number"}, "maxItems": 60},
              "y_axis_starts_at_zero": {"type": "boolean"},
              "source": {"type": "string", "maxLength": 300},
              "as_of": {"type": "string", "maxLength": 40},
              "percent_parts": {"type": "array", "items": {"type": "number"}, "maxItems": 12}
            }
          },
          "alt_text": {"type": "string", "maxLength": 400},
          "decorative": {"type": "boolean"},
          "reading_order": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 12},
          "pacing_seconds": {"type": "integer", "minimum": 0, "maximum": 1800},
          "hidden": {"type": "boolean"},
          "sources": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 8}
        },
        "additionalProperties": true
      }
    },
    "sources": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 200},
    "assumptions": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 40},
    "review_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {"type": "string", "maxLength": 60},
          "approver": {"type": "string", "maxLength": 120},
          "required": {"type": "boolean"},
          "status": {"type": "string", "enum": ["pending", "approved", "rejected", "not-required"]}
        }
      },
      "maxItems": 12
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generated_by": {"type": "string", "maxLength": 120},
        "generated_at": {"type": "string", "maxLength": 40},
        "brief_title": {"type": "string", "maxLength": 160},
        "content_files": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 20}
      }
    }
  },
  "additionalProperties": true
}
