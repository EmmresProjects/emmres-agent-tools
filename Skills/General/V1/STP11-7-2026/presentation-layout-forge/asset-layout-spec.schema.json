{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presentation Layout Forge specification",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "title"],
        "properties": {
          "type": {"enum": ["title", "section", "bullets", "table", "flow", "uml"]},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "items": {"type": "array"},
          "headers": {"type": "array"},
          "rows": {"type": "array"},
          "steps": {"type": "array"},
          "nodes": {"type": "array"},
          "relationships": {"type": "array"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
