{
  "schema": "o3d/render-presets/1",
  "description": "Look and camera presets used by 'mesh render'. Values are deterministic inputs to the software rasteriser, not photometric references.",
  "presets": {
    "review-hero": {
      "camera": {"azimuth_deg": 35.0, "elevation_deg": 18.0, "distance_factor": 1.9, "fov_deg": 40.0},
      "lighting": {"key_azimuth_deg": 35.0, "key_elevation_deg": 45.0, "ambient": 0.18, "rim": true, "shadows": true},
      "background_rgb": [18, 20, 26],
      "exposure": 1.0,
      "fog": 0.0,
      "samples": 2,
      "use_for": ["modeling review", "asset turntable stills", "quick silhouette checks"]
    },
    "clay-silhouette": {
      "camera": {"azimuth_deg": 90.0, "elevation_deg": 8.0, "distance_factor": 2.0, "fov_deg": 45.0},
      "lighting": {"key_azimuth_deg": 90.0, "key_elevation_deg": 30.0, "ambient": 0.05, "rim": false, "shadows": true},
      "background_rgb": [128, 128, 128],
      "exposure": 1.15,
      "fog": 0.0,
      "samples": 1,
      "use_for": ["silhouette readability", "proportion review", "blockout approval"]
    },
    "topology-check": {
      "camera": {"azimuth_deg": 45.0, "elevation_deg": 45.0, "distance_factor": 1.7, "fov_deg": 35.0},
      "lighting": {"key_azimuth_deg": 45.0, "key_elevation_deg": 60.0, "ambient": 0.3, "rim": false, "shadows": false},
      "background_rgb": [10, 12, 16],
      "wireframe": true,
      "exposure": 1.0,
      "fog": 0.0,
      "samples": 1,
      "use_for": ["retopology review", "quad flow inspection", "wireframe overlays"]
    },
    "matchmove-plate": {
      "camera": {"azimuth_deg": 0.0, "elevation_deg": 10.0, "distance_factor": 2.2, "fov_deg": 50.0},
      "lighting": {"key_azimuth_deg": 0.0, "key_elevation_deg": 50.0, "ambient": 0.22, "rim": true, "shadows": true},
      "background_rgb": [4, 4, 6],
      "exposure": 1.0,
      "fog": 0.15,
      "samples": 2,
      "use_for": ["matchmove sanity frames", "camera/scale verification"]
    }
  },
  "rules": [
    "Review stills never replace a final engine render; they exist for deterministic regression comparison.",
    "Keep the preset name in the filename so approvals can be traced.",
    "Wireframe presets must use samples=1 to keep comparison bit-exact."
  ]
}
