{
  "$schema_note": "Configuration for the word-document-agent skill tool. Copy this file, edit it, and pass the copy with --config. All paths are resolved relative to the process working directory unless absolute. Do not store credentials here: the tool never calls authenticated services.",
  "paths": {
    "state_dir": ".word-document-agent-state",
    "backup_dir": ".word-document-agent-state/backups",
    "report_dir": ".word-document-agent-state/reports"
  },
  "limits": {
    "max_input_bytes": 104857600,
    "max_zip_entries": 10000,
    "max_part_bytes": 67108864,
    "max_replacements": 20000,
    "max_merge_records": 500,
    "max_pdf_pages": 400,
    "max_scan_text_chars": 4000000,
    "max_seconds": 300,
    "max_backups_per_source": 10
  },
  "external": {
    "pdf_converter": "",
    "pdf_converter_args": ["{input}", "--headless", "--convert-to", "pdf", "--outdir", "{outdir}"],
    "timeout_seconds": 180,
    "allow_subprocess": false
  },
  "editing": {
    "require_approval_for": [
      "sanitize",
      "protect",
      "unprotect",
      "accept-revisions",
      "reject-revisions",
      "restore",
      "in-place",
      "watermark-remove"
    ],
    "allowed_input_extensions": [".docx", ".docm", ".dotx", ".dotm"],
    "refuse_output_overwrite": true,
    "allow_in_place": true
  },
  "defaults": {
    "sanitized_author": "Author",
    "title": "Untitled document",
    "watermark_text": "DRAFT",
    "watermark_color": "#C0C0C0",
    "toc_depth": 3,
    "placeholder_pattern": "{{key}}"
  },
  "policy_files": {
    "inspection_policy": "asset-inspection-policy.json",
    "capability_map": "asset-capability-map.json",
    "catalog": "asset-catalog.json"
  }
}
