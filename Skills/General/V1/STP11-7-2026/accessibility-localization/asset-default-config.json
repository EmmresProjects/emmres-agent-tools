{
  "schema_version": "1.0",
  "tool": "accessibility-localization",
  "locale": {
    "default": "en-PH",
    "source": "en",
    "targets": [
      "fil-PH",
      "en-PH"
    ],
    "fallback_chain": [
      "fil-PH",
      "en-PH",
      "en"
    ],
    "time_zone": "Asia/Manila",
    "currency": "PHP",
    "date_format": "YYYY-MM-DD",
    "number_format": "en-PH"
  },
  "standards": {
    "wcag": "2.2",
    "levels": [
      "A",
      "AA"
    ],
    "documents": [
      "PDF/UA-1",
      "WCAG 2.2",
      "EPUB 3"
    ],
    "localization": [
      "ISO 17100",
      "ASTM F2575",
      "WCAG 2.2 3.1.x"
    ]
  },
  "limits": {
    "max_findings": 500,
    "max_files": 200,
    "max_bytes": 8388608,
    "timeout_seconds": 60,
    "max_text_chars": 200000,
    "max_rows": 5000
  },
  "paths": {
    "output_dir": "output",
    "artifacts_dir": "artifacts",
    "cache_dir": ".accessibility-localization-cache"
  },
  "privacy": {
    "redact_pii": true,
    "retain_recordings": false,
    "allow_external_services": false
  },
  "approval": {
    "require_for": [
      "publish",
      "delete",
      "credential",
      "financial",
      "security"
    ],
    "default": "deny"
  },
  "organization": {
    "name": "The organization",
    "scope": "digital products and content",
    "owner": "Accessibility lead",
    "feedback_channel": "accessibility@example.org",
    "response_days": 5,
    "escalation_contact": "Accessibility lead"
  },
  "release_gate": {
    "block_on": [
      "critical",
      "serious"
    ],
    "allow_with_exception": true,
    "max_exception_days": 90,
    "require_owner": true
  },
  "report": {
    "include_evidence": true,
    "include_remediation": true,
    "include_protocol": true,
    "markdown": true
  }
}
