{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Tool input",
  "type": "object",
  "description": "Accepts a capability brief, findings envelope, locale resource, review data, or request object. Format-specific validation is performed by the selected capability.",
  "properties": {
    "source": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "values": {
      "type": "object"
    },
    "findings": {
      "type": "array"
    },
    "retest": {
      "type": "array"
    },
    "requirements": {
      "type": "array"
    },
    "journeys": {
      "type": "array"
    },
    "exceptions": {
      "type": "array"
    },
    "duration": {
      "type": "number"
    },
    "gaps": {
      "type": "array"
    },
    "descriptions": {
      "type": "array"
    },
    "scores": {
      "type": "object"
    }
  }
}
