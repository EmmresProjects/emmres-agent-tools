{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Tool output envelope",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "generated_at",
    "capability",
    "status",
    "summary",
    "findings",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string"
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "operation",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "category_title": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "enum": [
            "auto",
            "assisted",
            "human"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "attention",
        "failed",
        "error",
        "skipped"
      ]
    },
    "summary": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "severity",
          "title"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "serious",
              "moderate",
              "minor",
              "info"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "wcag": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "protocol": {
      "type": [
        "object",
        "null"
      ]
    },
    "artifacts": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "next_steps": {
      "type": "array"
    },
    "config": {
      "type": "object"
    }
  }
}
