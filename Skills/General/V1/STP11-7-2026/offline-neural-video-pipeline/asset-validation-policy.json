{
  "policy_version": "1.0",
  "note": "Validation thresholds and approval rules. Severity 'error' fails the run (exit 3), 'warning' reports without failing, 'info' reports only.",
  "fail_mode": "error",
  "severity": {
    "probe": "error",
    "decode": "error",
    "duration": "warning",
    "fps": "warning",
    "resolution": "error",
    "pix_fmt": "warning",
    "black": "warning",
    "freeze": "warning",
    "loudness": "warning",
    "clipping": "warning",
    "audio_presence": "info",
    "caption": "warning",
    "bitrate": "warning",
    "filesize": "error",
    "overwrite_protection": "error"
  },
  "checks": {
    "probe": {"enabled": true},
    "decode": {"enabled": true, "max_error_lines": 0, "timeout_s": 900},
    "duration": {"enabled": true, "tolerance_ratio": 0.08, "tolerance_s": 0.35},
    "fps": {"enabled": true, "tolerance_ratio": 0.02},
    "resolution": {"enabled": true, "require_even_dimensions": true},
    "pix_fmt": {"enabled": true, "allowed": ["yuv420p", "yuv422p", "yuv444p", "yuv420p10le", "yuv422p10le", "nv12", "rgb24"]},
    "black": {"enabled": true, "min_segment_s": 0.5, "max_total_s": 2.0, "pixel_threshold": 0.10},
    "freeze": {"enabled": true, "noise_db": -60, "min_segment_s": 2.0, "max_total_s": 3.0},
    "loudness": {"enabled": true, "target_lufs": -16.0, "tolerance_lu": 3.0, "max_true_peak_dbtp": -1.0, "max_lra_lu": 20.0},
    "clipping": {"enabled": true, "max_peak_dbfs": -0.05},
    "audio_presence": {"enabled": true, "require_when_declared": true},
    "caption": {"enabled": true, "require_when_declared": true, "min_cue_count": 1},
    "bitrate": {"enabled": true, "min_kbps": 200},
    "filesize": {"enabled": true},
    "overwrite_protection": {"enabled": true}
  },
  "approvals": {
    "note": "Stages listed here are refused unless the operator passes --approve (or records an approval in the ledger).",
    "require_for": ["backend_dispatch", "package", "overwrite", "ledger_write"],
    "approval_token": "--approve",
    "record_in_provenance": true
  },
  "limits": {
    "max_stage_timeout_s": 3600,
    "max_retries": 5,
    "max_parallel_stages": 1,
    "cancel_grace_s": 5
  }
}
