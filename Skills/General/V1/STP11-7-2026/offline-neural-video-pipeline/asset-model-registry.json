  "proxy_filters": {
    "generate": {
      "label": "Ken Burns animatic from a reference still (deterministic, non-neural)",
      "filter": "zoompan",
      "requires_input": true,
      "placeholder_filter": "testsrc2",
      "summary": "Produces a pan/zoom animatic from the first declared image input so the rest of the pipeline can be exercised without weights."
    },
    "transform": {
      "label": "Deterministic LUT/curve restyle proxy",
      "filter": "curves=preset=medium_contrast,hue=s=1.08",
      "requires_input": true,
      "summary": "Approximates a style/transform pass with fixed curves; intended only for pipeline validation, not creative approval."
    },
    "animate": {
      "label": "Still-motion proxy (subtle zoom-pan on the portrait or frame)",
      "filter": "zoompan",
      "requires_input": true,
      "summary": "Keeps a subject still while adding micro camera movement; it does not animate a face."
    },
    "interpolate": {
      "label": "ffmpeg minterpolate motion-compensated frame synthesis",
      "filter": "minterpolate",
      "requires_input": true,
      "summary": "Real frame synthesis, acceptable for preview retiming; may show warping artifacts on fast motion."
    },
    "restore": {
      "label": "hqdn3d + deflicker + Lanczos rescale",
      "filter": "hqdn3d=4:3:6:4.5,deflicker=mode=pm:size=10",
      "requires_input": true,
      "summary": "Classical denoise/deflicker/upscale; a credible preview stand-in for ESRGAN/BasicVSR."
    },
    "edit": {
      "label": "Exposure / contrast relight approximation",
      "filter": "eq=brightness=0.05:contrast=1.08:saturation=1.05",
      "requires_input": true,
      "summary": "Global tone adjustment only; it cannot remove or replace objects."
    },
    "audio": {
      "label": "Loudness normalisation and mix",
      "filter": "loudnorm",
      "requires_input": false,
      "summary": "Two-stage EBU R128 loudness normalisation plus channel mix."
    },
    "caption": {
      "label": "Subtitle burn-in or sidecar writer",
      "filter": "subtitles",
      "requires_input": true,
      "summary": "Burns an SRT/WebVTT file with libass, or writes a sidecar when libass is unavailable."
    },
    "color": {
      "label": "Finishing contrast/saturation pass",
      "filter": "eq=contrast=1.05:saturation=1.02",
      "requires_input": true,
      "summary": "Deterministic finishing look; replace with a LUT in production."
    },
    "encode": {
      "label": "H.264/AAC delivery encode",
      "filter": null,
      "requires_input": true,
      "summary": "libx264 + aac with faststart."
    }
  }
}
