{
  "registry_version": "1.0",
  "note": "Offline model routing registry. Every numeric field is a PLANNING DEFAULT that must be re-verified against the pinned model card on the air-gapped host before production use. No weights are bundled and no network endpoint is referenced.",
  "fields": {
    "ops": "operation families this model can serve (see asset-capability-catalog.json operations)",
    "residency.vram_reference": "resolution/frame count at which residency.vram_min_gb was measured; the planner scales from here",
    "weights.filename_globs": "globs matched inside spec.models.root to prove the weights exist locally",
    "license.redistribution": "one of permissive | restricted | unknown; 'unknown' must be cleared by an operator",
    "backend.command_template": "operator-verifiable local runner template; placeholders are substituted by tools-onv-exec.py"
  },
  "defaults": {
    "command_template": null,
    "allow_cpu_fallback": true
  },
