      "redistributable": false,
      "weights": {
        "filename_globs": ["svd_xt*.safetensors", "svd_xt*.ckpt", "svd_xt*.fp16.safetensors"],
        "approx_size_gb": 9.6,
        "sha256": null
      },
      "residency": {
        "vram_min_gb": 10.0,
        "vram_recommended_gb": 20.0,
        "ram_min_gb": 16.0,
        "vram_reference": {"width": 1024, "height": 576, "frames": 25},
        "cpu_capable": true
      },
      "limits": {"frames_per_second": 0.35, "max_frames": 25, "native_fps": 7.5, "native_resolution": [1024, 576]},
      "license": {
        "name": "Stability AI community / non-commercial terms (verify pinned license text)",
        "redistribution": "restricted",
        "verification_required": true
      },
      "backend": {
        "framework": "diffusers",
        "command_template": "python3 -m svd_runner --model {model_path} --image {input_image} --out {output} --frames {frames} --fps {fps} --seed {seed}"
      },
      "notes": "Image-to-video only. Native 7.5 fps output is normally retimed by the interpolate stage."
