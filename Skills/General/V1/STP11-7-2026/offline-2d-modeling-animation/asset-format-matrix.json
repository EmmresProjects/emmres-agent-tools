{
  "name": "studio-format-matrix",
  "version": "1.0",
  "description": "Format compatibility routing table for the format-router command (tools-encode.py). Given a target consumer and requirements (alpha, animation, quality), the matrix picks a primary and fallback format.",
  "built_in": {
    "formats": ["png", "apng", "gif", "bmp", "tga", "ppm/pgm", "wav", "pdf"],
    "external": ["mp4/h264", "mkv/ffv1", "mov/prores", "webp", "jpg", "exr", "tiff"]
  },
  "matrix": {
    "web-browser": {
      "still_with_alpha": {"primary": "png", "fallback": "webp"},
      "animation_with_alpha": {"primary": "apng", "fallback": "webp"},
      "animation_small": {"primary": "gif", "fallback": "apng"},
      "video": {"primary": "mp4-h264", "fallback": "webm", "requires": "ffmpeg"}
    },
    "game-engine-generic": {
      "sprites_with_alpha": {"primary": "png", "fallback": "tga"},
      "sprite_animation": {"primary": "png sequence + atlas json", "fallback": "spritesheet png"},
      "ui_nine_slice": {"primary": "png", "fallback": "tga"},
      "video_cinematic": {"primary": "mp4-h264", "fallback": "png sequence"}
    },
    "video-editor": {
      "master": {"primary": "mkv-ffv1", "fallback": "png sequence + wav", "requires": "ffmpeg"},
      "review": {"primary": "mp4-h264", "requires": "ffmpeg"},
      "alpha_for_comp": {"primary": "png sequence", "fallback": "prores4444", "requires": "ffmpeg"},
      "stills": {"primary": "png", "fallback": "tiff"}
    },
    "print-merch": {
      "poster": {"primary": "png 300dpi", "fallback": "tiff", "note": "CMYK conversion at the print shop; keep RGB master"},
      "sticker_cut": {"primary": "png + cut-line vector (svg)", "note": "bleed >= 3mm"}
    },
    "archive-long-term": {
      "image_master": {"primary": "png", "fallback": "tiff"},
      "animation_master": {"primary": "png sequence + wav + json manifest", "fallback": "mkv-ffv1"},
      "project_bundle": {"primary": "zip (sources + manifests)", "fallback": "directory tree"}
    },
    "legacy-software": {
      "older_windows_tools": {"primary": "bmp", "fallback": "tga"},
      "older_unix_tools": {"primary": "ppm", "fallback": "tga"}
    }
  },
  "alpha_notes": {
    "png": "straight alpha",
    "tga": "straight alpha (32-bit)",
    "bmp": "alpha unreliable across readers; prefer 24-bit",
    "gif": "1-bit alpha (binary transparency)",
    "apng": "straight alpha per frame with blend ops",
    "premultiplied_warning": "video codecs commonly deliver premultiplied; verify before compositing"
  }
}
