{
  "schema_version": "1.0",
  "description": "Runtime defaults for the powerpoint-agent skill tool. Copy and edit this file (or pass --config) to change limits, thresholds, rendering, and safety policy without touching code.",
  "paths": {
    "default_out_dir": "pptx-agent-output",
    "temp_prefix": "pptx-agent-"
  },
  "limits": {
    "max_input_mb": 300,
    "max_slides": 400,
    "max_bullets_per_slide": 60,
    "max_table_rows": 200,
    "max_table_columns": 20,
    "max_chart_series": 12,
    "max_chart_categories": 60,
    "max_media_files": 500,
    "max_batch_jobs": 200,
    "max_text_chars": 4000,
    "max_notes_chars": 20000
  },
  "timeouts": {
    "default_seconds": 300,
    "export_seconds": 240,
    "batch_seconds": 900
  },
  "audit": {
    "fail_on": "error",
    "font_allowlist": [
      "Arial",
      "Aptos",
      "Aptos Display",
      "Calibri",
      "Segoe UI",
      "Helvetica",
      "Georgia",
      "Times New Roman",
      "Verdana",
      "Tahoma",
      "Trebuchet MS",
      "Inter",
      "Roboto",
      "Open Sans",
      "Lato",
      "Source Sans Pro",
      "Noto Sans",
      "Noto Serif",
      "DejaVu Sans",
      "DejaVu Serif",
      "Liberation Sans",
      "Liberation Serif"
    ],
    "placeholder_patterns": [
      "click to add",
      "lorem ipsum",
      "todo",
      "tbd",
      "xxx",
      "insert text",
      "sample text"
    ],
    "max_slide_budget": 40,
    "max_file_mb": 60
  },
  "format": {
    "min_font_pt": 14,
    "title_pt": 32,
    "body_pt": 16,
    "force_fonts": false,
    "normalize_geometry": true,
    "add_footer": true,
    "add_slide_numbers": true,
    "remove_empty_placeholders": true
  },
  "repair": {
    "max_findings": 500,
    "dry_run": true
  },
  "optimize": {
    "max_image_dimension_px": 1920,
    "jpeg_quality": 82,
    "drop_unused_media": false,
    "dry_run": true
  },
  "render": {
    "backend": "auto",
    "preview_scale": 1.0,
    "max_preview_slides": 60,
    "width_px": 1280,
    "font_search_paths": [
      "/usr/share/fonts/truetype/dejavu",
      "/usr/share/fonts/truetype/liberation",
      "/Library/Fonts",
      "/System/Library/Fonts/Supplemental",
      "C:/Windows/Fonts"
    ],
    "font_map": {
      "heading": [
        "DejaVuSans-Bold.ttf",
        "Arial Bold.ttf",
        "arialbd.ttf",
        "LiberationSans-Bold.ttf"
      ],
      "body": [
        "DejaVuSans.ttf",
        "Arial.ttf",
        "arial.ttf",
        "LiberationSans-Regular.ttf"
      ],
      "mono": [
        "DejaVuSansMono.ttf",
        "CourierNew.ttf",
        "cour.ttf"
      ]
    }
  },
  "export": {
    "libreoffice_binary": "",
    "soffice_candidates": [
      "soffice",
      "libreoffice",
      "/usr/bin/soffice",
      "/Applications/LibreOffice.app/Contents/MacOS/soffice"
    ],
    "pdf_filter": "impress_pdf_Export",
    "timeout_seconds": 240
  },
  "batch": {
    "stop_on_error": false,
    "retries": 0,
    "timeout_seconds": 600,
    "stage_outputs": true
  },
  "safety": {
    "approval_required_commands": [
      "repair",
      "optimize",
      "replace"
    ],
    "blocked_protocols": [
      "javascript:",
      "data:",
      "vbscript:",
      "file:"
    ],
    "max_external_links": 200,
    "allow_in_place_with_approval": false
  },
  "defaults": {
    "json": false,
    "overwrite": false,
    "theme": "corporate-blue"
  }
}
