{
  "manifest_version": "1.0",
  "description": "Build the example deck, audit it, and render three previews. Paths are resolved relative to this manifest, so the batch can be started from any working directory.",
  "options": {
    "stop_on_error": true,
    "retries": 0,
    "timeout_seconds": 240,
    "stage_outputs": false,
    "publish_at_end": true
  },
  "jobs": [
    {
      "id": "build-example-deck",
      "command": "build",
      "args": {
        "spec": "asset-deck-spec-example.json",
        "out": "batch-out/deck.pptx",
        "audit": true,
        "overwrite": true
      }
    },
    {
      "id": "audit-example-deck",
      "command": "audit",
      "args": {
        "input": "batch-out/deck.pptx",
        "out": "batch-out/audit.json",
        "markdown": "batch-out/audit.md",
        "fail_on": "none"
      }
    },
    {
      "id": "inspect-example-deck",
      "command": "inspect",
      "args": {
        "input": "batch-out/deck.pptx",
        "out": "batch-out/stats.json"
      }
    },
    {
      "id": "preview-example-deck",
      "command": "preview",
      "args": {
        "input": "batch-out/deck.pptx",
        "out_dir": "batch-out/previews",
        "slides": "1-3",
        "overwrite": true
      }
    }
  ]
}
