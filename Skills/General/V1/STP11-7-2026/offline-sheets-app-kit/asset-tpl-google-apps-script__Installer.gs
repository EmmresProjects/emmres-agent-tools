/**
 * =====================================================================
 *  {{KIT_TITLE}} - Google Apps Script backend
 *  File: Installer.gs
 * ---------------------------------------------------------------------
 *  RUN installKit() ONCE. It will:
 *    1. Create every sheet with the correct headers and formatting
 *    2. Write the branches, roles, accounts, products and settings
 *       declared in the generated SEED constant
 *    3. Protect the password columns from casual edits
 *    4. Return the Web App URL hint
 *
 *  Safe to re-run: it never duplicates rows and never deletes sales.
 * =====================================================================
 */

/** ============== MAIN INSTALLER - RUN THIS ONE ============== */
/* =====================================================================
   SEED - generated by offline-sheets-app-kit from your specification file.
   Consumed by seedReference_() below. Do not hand-edit; re-run:
       python tools-generate-kit.py --spec spec.json --out <dir> --force
   ===================================================================== */
var SEED = {{SEED_JS}};

function installKit() {
  var ss = ss_();
  var created = [];
  var kept = [];

  Object.keys(SHEETS).forEach(function (name) {
    var sh = ss.getSheetByName(name);
    if (!sh) { sh = ss.insertSheet(name); created.push(name); }
    else kept.push(name);
    ensureHeaders_(sh, SHEETS[name]);
    styleSheet_(sh, SHEETS[name]);
  });

  // Remove the default "Sheet1" only if it is empty and not used.
  var def = ss.getSheetByName('Sheet1');
  if (def && def.getLastRow() === 0 && ss.getSheets().length > 1) { try { ss.deleteSheet(def); } catch (e) {} }

  seedReference_();
  protectPasswordColumns_();

  var url = '';
  try { url = ScriptApp.getService().getUrl() || ''; } catch (e) { url = ''; }

  Logger.log('=================================================');
  Logger.log(' {{APP_TITLE}} installed');
  Logger.log(' Sheets created: ' + (created.join(', ') || 'none (already existed)'));
  Logger.log(' Sheets verified: ' + kept.join(', '));
  Logger.log(' Web App URL: ' + (url || '(deploy first: Deploy > New deployment > Web app)'));
  Logger.log(' Access token: ' + USER_SETTINGS.ACCESS_TOKEN);
  Logger.log(' Owner login: {{OWNER_USER}} / ' + USER_SETTINGS.OWNER_PASSWORD);
  Logger.log('=================================================');

  return {
    ok: true,
    created: created,
    verified: kept,
    webAppUrl: url,
    next: [
      '1) Make sure Config.gs ACCESS_TOKEN is your own long random string.',
      '2) Deploy > New deployment > Web app. Execute as: Me. Who has access: Anyone.',
      '3) Copy the /exec URL and the token into the app: Settings > Google Sheets connection.',
      '4) Sign in as owner and click "Pull menu & settings".'
    ]
  };
}

function ensureHeaders_(sh, headers) {
  var firstRow = sh.getRange(1, 1, 1, Math.max(headers.length, sh.getLastColumn() || 1)).getValues()[0];
  var current = firstRow.slice(0, headers.length).map(function (v) { return String(v).trim(); });
  var matches = current.join('|') === headers.join('|');
  if (!matches) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  }
  sh.setFrozenRows(1);
}

function styleSheet_(sh, headers) {
  var headerRange = sh.getRange(1, 1, 1, headers.length);
  headerRange
    .setFontWeight('bold')
    .setFontColor('#ffffff')
    .setBackground('#16202e')
    .setVerticalAlignment('middle');
  sh.setRowHeight(1, 34);
  try {
    var banding = sh.getBandings();
    if (!banding.length && sh.getLastRow() > 1) {
      sh.getRange(1, 1, Math.max(sh.getMaxRows(), 2), headers.length)
        .applyRowBanding(SpreadsheetApp.BandingTheme.BLUE, true, false);
    }
  } catch (e) { /* banding is cosmetic */ }
  // Reasonable column widths
  for (var i = 1; i <= headers.length; i++) {
    var name = headers[i - 1];
    var w = 120;
    if (name === 'RecordID' || name === 'Notes' || name === 'VolumeJSON' || name === 'ItemsJSON') w = 220;
    if (name === 'BusinessDate' || name === 'CreatedAt' || name === 'UpdatedAt') w = 150;
    sh.setColumnWidth(i, w);
  }
}

/* ------------------------------------------------------------------ */
/*  Seed data                                                         */
/* ------------------------------------------------------------------ */
function seedReference_() {
  var now = new Date();

  seedIfEmpty_('Branches', 'BranchID', SEED.branches);

  seedIfEmpty_('Roles', 'RoleID', SEED.roles);

  if (readTable_('Accounts').length === 0) {
    var makeAccount = function (row) {
      var salt = randomSalt_();
      return [row[0], row[1], row[2], row[3], row[4], 'Active', salt,
        hashPassword_(row[6], salt), hashPassword_(row[7], salt), now, '', 'No', now];
    };
    appendRows_('Accounts', SEED.accounts.map(makeAccount));
  }

  if (readTable_('Products').length === 0) {
    var P = function (row) {
      return [row[0], row[1], row[2], row[3], row[4], JSON.stringify(row[5]), row[6], row[7], row[8]];
    };
    appendRows_('Products', SEED.products.map(P));
  }

  seedIfEmpty_('Settings', 'Key', SEED.settings);
}

function seedIfEmpty_(sheetName, keyColumn, rows) {
  var sh = sheet_(sheetName);
  var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
  var keyIdx = head.indexOf(keyColumn);
  var existing = {};
  if (sh.getLastRow() > 1) {
    var col = sh.getRange(2, keyIdx + 1, sh.getLastRow() - 1, 1).getValues();
    col.forEach(function (r) { if (r[0] !== '') existing[String(r[0])] = true; });
  }
  var toAdd = rows.filter(function (r) { return !existing[String(r[keyIdx])]; });
  if (toAdd.length) appendRows_(sheetName, toAdd);
  return toAdd.length;
}

/* ------------------------------------------------------------------ */
/*  Protect the password columns from casual edits                   */
/* ------------------------------------------------------------------ */
function protectPasswordColumns_() {
  var sh = sheet_('Accounts');
  var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
  ['PasswordSalt', 'PasswordHash', 'PinHash'].forEach(function (name) {
    var idx = head.indexOf(name);
    if (idx < 0) return;
    var range = sh.getRange(2, idx + 1, Math.max(sh.getMaxRows() - 1, 1), 1);
    try {
      var prot = range.protect().setDescription('Protected: hashed values only');
      prot.removeEditors(prot.getEditors());
      if (prot.canDomainEdit) prot.setDomainEdit(false);
    } catch (e) { /* protection needs an owner account; skip silently */ }
  });
}

/* ------------------------------------------------------------------ */
/*  Extra utilities you can run from the editor                      */
/* ------------------------------------------------------------------ */
/** Show what the Web App URL should look like and whether it is deployed. */
function showDeploymentInfo() {
  var url = '';
  try { url = ScriptApp.getService().getUrl() || ''; } catch (e) {}
  Logger.log(url ? 'Web App URL: ' + url : 'Not deployed yet. Deploy > New deployment > Web app.');
  Logger.log('Paste this URL and the token from Config.gs into the app.');
  return url;
}

/** Generate a fresh strong token to paste into Config.gs. */
function generateToken() {
  var token = '{{BRAND_SLUG}}-' + Utilities.getUuid().replace(/-/g, '') + '-' + Utilities.getUuid().slice(0, 8);
  Logger.log('New access token: ' + token);
  Logger.log('Paste it into Config.gs ACCESS_TOKEN and into the app settings.');
  return token;
}

/** Reset the owner password to USER_SETTINGS.OWNER_PASSWORD. */
function resetOwnerPassword() {
  var row = findRow_('Accounts', 'AccountID', 'ACC-0001');
  if (!row) throw new Error('Owner account ACC-0001 not found.');
  var sh = sheet_('Accounts');
  var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
  var salt = randomSalt_();
  sh.getRange(row, head.indexOf('PasswordSalt') + 1).setValue(salt);
  sh.getRange(row, head.indexOf('PasswordHash') + 1).setValue(hashPassword_(USER_SETTINGS.OWNER_PASSWORD, salt));
  sh.getRange(row, head.indexOf('ForceChange') + 1).setValue('No');
  CacheService.getScriptCache().remove('ref_v1');
  Logger.log('Owner password reset to: ' + USER_SETTINGS.OWNER_PASSWORD);
  return true;
}

/** Delete the sample leftover row if it is still there. */
function removeSampleRows() {
  var sh = sheet_('NonRevenueLogs');
  var data = sh.getDataRange().getValues();
  var removed = 0;
  for (var r = data.length - 1; r >= 1; r--) {
    if (String(data[r][9] || '').indexOf('SAMPLE ROW') === 0) { sh.deleteRow(r + 1); removed++; }
  }
  Logger.log(removed + ' sample row(s) removed.');
  return removed;
}

/** Rebuild the reference cache after editing the sheet by hand. */
function refreshCache() {
  CacheService.getScriptCache().remove('ref_v1');
  Logger.log('Reference cache cleared. The app will pull fresh data next time.');
  return true;
}
