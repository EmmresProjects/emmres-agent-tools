{
  "name": "{{ANDROID_PACKAGE}}",
  "displayName": "{{APP_NAME}}",
  "version": "{{APP_VERSION}}",
  "description": "{{APP_TITLE}} - Android build (Cordova)",
  "author": "{{AUTHOR}}",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-www.js",
    "prepare:android": "npm run sync && cordova prepare android",
    "build:debug": "npm run sync && cordova build android --debug",
    "build:release": "npm run sync && cordova build android --release -- --keystore=../keystore/{{KEYSTORE_NAME}}-release.keystore --storePassword=$KS_PASS --alias={{KEYSTORE_ALIAS}} --password=$KS_PASS",
    "run:device": "npm run sync && cordova run android --device",
    "open:studio": "cordova open android",
    "doctor": "cordova requirements android"
  },
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-android": "^13.0.0",
    "cordova-plugin-device": "^2.1.0",
    "cordova-plugin-statusbar": "^4.0.0",
    "cordova-plugin-splashscreen": "^6.0.2",
    "cordova-plugin-insomnia": "^4.3.0",
    "cordova-plugin-file": "^8.0.0",
    "cordova-plugin-x-socialsharing": "^6.0.4"
  },
  "cordova": {
    "platforms": ["android"],
    "plugins": {
      "cordova-plugin-device": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-insomnia": {},
      "cordova-plugin-file": {},
      "cordova-plugin-x-socialsharing": {}
    }
  }
}
