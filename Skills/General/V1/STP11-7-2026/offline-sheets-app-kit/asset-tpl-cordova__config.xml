<?xml version='1.0' encoding='utf-8'?>
<widget id="{{ANDROID_APP_ID}}" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

  <name>{{APP_NAME}}</name>
  <description>{{APP_TITLE}} - {{TAGLINE}}</description>
  <author email="{{AUTHOR_EMAIL}}">{{AUTHOR}}</author>

  <content src="index.html" />

  <!-- The app talks to a Google Apps Script Web App over HTTPS.
       Nothing else is allowed to load. -->
  <access origin="https://script.google.com" />
  <access origin="https://script.googleusercontent.com" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />

  <!-- Do not let the OS shuffle the layout: this is a full-screen till app. -->
  <preference name="Orientation" value="{{ORIENTATION}}" />
  <preference name="Fullscreen" value="false" />
  <preference name="StatusBarOverlaysWebView" value="false" />
  <preference name="StatusBarBackgroundColor" value="{{THEME_COLOR}}" />
  <preference name="StatusBarStyle" value="lightcontent" />
  <preference name="BackgroundColor" value="0xff{{BG_HEX}}" />
  <preference name="SplashMaintainAspectRatio" value="true" />
  <preference name="SplashShowOnlyFirstTime" value="false" />
  <preference name="SplashScreenDelay" value="1200" />
  <preference name="FadeSplashScreenDuration" value="300" />
  <preference name="ShowSplashScreenSpinner" value="false" />
  <preference name="AutoHideSplashScreen" value="true" />
  <preference name="keepScreenOnWhilePlaying" value="true" />
  <preference name="AndroidPersistentFileLocation" value="Compatibility" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="android-targetSdkVersion" value="34" />
  <preference name="AndroidWindowSplashScreenBackground" value="{{THEME_COLOR}}" />
  <preference name="AndroidInsetsBehavior" value="default" />

  <platform name="android">
    <!-- Launcher icons -->
    <icon density="ldpi"    src="res/icon/android/ldpi.png" />
    <icon density="mdpi"    src="res/icon/android/mdpi.png" />
    <icon density="hdpi"    src="res/icon/android/hdpi.png" />
    <icon density="xhdpi"   src="res/icon/android/xhdpi.png" />
    <icon density="xxhdpi"  src="res/icon/android/xxhdpi.png" />
    <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />

    <!-- Splash screens -->
    <splash density="port-ldpi"    src="res/screen/android/portrait-ldpi.png" />
    <splash density="port-mdpi"    src="res/screen/android/portrait-mdpi.png" />
    <splash density="port-hdpi"    src="res/screen/android/portrait-hdpi.png" />
    <splash density="port-xhdpi"   src="res/screen/android/portrait-xhdpi.png" />
    <splash density="port-xxhdpi"  src="res/screen/android/portrait-xxhdpi.png" />
    <splash density="land-ldpi"    src="res/screen/android/landscape-ldpi.png" />
    <splash density="land-mdpi"    src="res/screen/android/landscape-mdpi.png" />
    <splash density="land-hdpi"    src="res/screen/android/landscape-hdpi.png" />
    <splash density="land-xhdpi"   src="res/screen/android/landscape-xhdpi.png" />
    <splash density="land-xxhdpi"  src="res/screen/android/landscape-xxhdpi.png" />

    <preference name="AndroidLaunchMode" value="singleTop" />
    <preference name="android-compileSdkVersion" value="34" />
    <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/application">
      <application android:usesCleartextTraffic="true" />
    </edit-config>
  </platform>

  <platform name="ios">
    <icon height="120" src="res/icon/ios/icon-60.png" width="120" />
    <icon height="76" src="res/icon/ios/icon-76.png" width="76" />
    <icon height="120" src="res/icon/ios/icon-120.png" width="120" />
    <icon height="152" src="res/icon/ios/icon-152.png" width="152" />
    <icon height="167" src="res/icon/ios/icon-167.png" width="167" />
    <icon height="180" src="res/icon/ios/icon-180.png" width="180" />
    <icon height="1024" src="res/icon/ios/icon-1024.png" width="1024" />
    <preference name="WKWebViewOnly" value="true" />
    <preference name="deployment-target" value="12.0" />
  </platform>

  <plugin name="cordova-plugin-device" spec="^2.1.0" />
  <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />
  <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
  <plugin name="cordova-plugin-insomnia" spec="^4.3.0" />
  <plugin name="cordova-plugin-file" spec="^8.0.0" />
  <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />

  <hook type="after_prepare" src="scripts/after-prepare.js" />
</widget>
