{
  "presets_version": "1.0.0",
  "workflows": [
    {
      "workflow_id": "airgap-grounded-rag-pipeline",
      "version": "1.0.0",
      "owner": "knowledge-engineering",
      "description": "Ingests approved corpus, builds hybrid BM25+vector index, runs grounded RAG with injection defense, validates entailment, and exports evidence bundle.",
      "steps": [
        {
          "step_id": "ingest-corpus",
          "capability": "embedding-corpus-builder",
          "depends_on": [],
          "params": {"use_reference_corpus": true},
          "require_approval": false
        },
        {
          "step_id": "hybrid-search",
          "capability": "hybrid-retrieval-builder",
          "depends_on": ["ingest-corpus"],
          "params": {"top_k": 4},
          "require_approval": false
        },
        {
          "step_id": "grounded-answer",
          "capability": "rag-pipeline-architect",
          "depends_on": ["hybrid-search"],
          "params": {},
          "require_approval": false
        },
        {
          "step_id": "verify-claims",
          "capability": "claim-to-evidence-validator",
          "depends_on": ["grounded-answer"],
          "params": {},
          "require_approval": false
        },
        {
          "step_id": "export-evidence",
          "capability": "evidence-package-exporter",
          "depends_on": ["verify-claims"],
          "params": {},
          "require_approval": false
        }
      ]
    },
    {
      "workflow_id": "approved-transactional-mutation",
      "version": "1.0.0",
      "owner": "automation-safety",
      "description": "Generates action diff, performs dry-run check, pauses at human approval gate, applies atomic file mutation with backup, and verifies post-action state.",
      "steps": [
        {
          "step_id": "plan-diff",
          "capability": "action-plan-diff-builder",
          "depends_on": [],
          "params": {},
          "require_approval": false
        },
        {
          "step_id": "dry-run",
          "capability": "read-only-dry-run-operator",
          "depends_on": ["plan-diff"],
          "params": {},
          "require_approval": false
        },
        {
          "step_id": "apply-mutation",
          "capability": "file-mutation-safety-manager",
          "depends_on": ["dry-run"],
          "params": {},
          "compensate_capability": "compensating-action-builder",
          "require_approval": true
        },
        {
          "step_id": "verify-mutation",
          "capability": "post-action-verification-operator",
          "depends_on": ["apply-mutation"],
          "params": {},
          "require_approval": false
        }
      ]
    },
    {
      "workflow_id": "offline-release-readiness-gate",
      "version": "1.0.0",
      "owner": "sre-operations",
      "description": "Verifies air-gap compliance, runs security regression suite, checks audit chain integrity, evaluates benchmark quality gate, and runs operational readiness review.",
      "steps": [
        {
          "step_id": "airgap-check",
          "capability": "air-gap-compliance-tester",
          "depends_on": [],
          "params": {},
          "require_approval": false
        },
        {
          "step_id": "security-check",
          "capability": "security-regression-suite",
          "depends_on": [],
          "params": {},
          "require_approval": false
        },
        {
          "step_id": "audit-verify",
          "capability": "tamper-evident-log-manager",
          "depends_on": ["airgap-check", "security-check"],
          "params": {"operation": "verify"},
          "require_approval": false
        },
        {
          "step_id": "orr-review",
          "capability": "operational-readiness-review",
          "depends_on": ["audit-verify"],
          "params": {},
          "require_approval": false
        }
      ]
    }
  ]
}
