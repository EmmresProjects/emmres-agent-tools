{
  "schema": "foic.qc-policy/1",
  "version": "1.0.0",
  "defaults": {
    "min_width": 512,
    "min_height": 512,
    "max_width": 8192,
    "max_height": 8192,
    "require_multiple_of": 8,
    "allowed_aspect_ratios": ["1:1", "3:2", "2:3", "4:3", "3:4", "16:9", "9:16", "5:4", "4:5", "21:9"],
    "aspect_tolerance": 0.02,
    "expect_alpha": "any",
    "alpha_coverage_min": 0.0,
    "alpha_coverage_max": 1.0,
    "min_file_bytes": 1024,
    "max_file_bytes": 419430400,
    "max_bytes_per_megapixel": 12582912,
    "require_icc": false,
    "forbid_gps_exif": true,
    "expect_text": null
  },
  "thresholds": {
    "flat_stddev_max": 3.0,
    "flat_unique_colors_min": 32,
    "flat_block_ratio_max": 0.55,
    "block_size": 16,
    "clipped_pixel_ratio_max": 0.02,
    "banding_step_ratio_max": 0.35,
    "noise_stddev_min": 0.4,
    "noise_stddev_max": 90.0,
    "dead_pixel_ratio_max": 0.001,
    "gray_saturation_max": 8.0,
    "edge_density_text_min": 0.18,
    "edge_density_text_max": 0.85,
    "edge_density_photo_max": 0.60,
    "deduplicate_hamming_max": 8,
    "similarity_warn_hamming": 20,
    "sample_side": 512,
    "sample_pixels_max": 4000000
  },
  "severity": {
    "decode": "error",
    "dimensions": "error",
    "aspect_ratio": "warn",
    "file_size": "warn",
    "empty": "error",
    "alpha": "warn",
    "artifacts": "warn",
    "color": "warn",
    "text_region": "warn",
    "bit_depth": "warn",
    "metadata": "warn",
    "duplicate": "warn"
  },
  "presets": {
    "photo": {
      "min_width": 1024,
      "min_height": 1024,
      "expect_alpha": "absent",
      "flat_stddev_max": 2.0,
      "clipped_pixel_ratio_max": 0.01
    },
    "product-cutout": {
      "expect_alpha": "present",
      "alpha_coverage_min": 0.02,
      "alpha_coverage_max": 0.95,
      "require_multiple_of": 8
    },
    "upscale-output": {
      "min_width": 2048,
      "min_height": 2048,
      "flat_block_ratio_max": 0.40,
      "noise_stddev_min": 1.0
    },
    "typography": {
      "expect_text": true,
      "edge_density_text_min": 0.22,
      "min_width": 768
    },
    "thumbnail": {
      "min_width": 128,
      "min_height": 128,
      "max_width": 1024,
      "max_height": 1024
    }
  },
  "notes": [
    "expect_alpha values: any | present | absent.",
    "expect_text values: null (skip heuristic) | true (require text-like edge density) | false (reject text-like edges).",
    "A preset merges over defaults; command-line --set overrides both."
  ]
}
