{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "$id":"offline-game-development/asset-output-schema.json",
 "title":"Skill Tool output envelope",
 "description":"The shape every command prints on stdout, plus the artifact records that commands emit and that validate --records and evidence check enforce. The list under validator_support is exactly what the built-in validator in tools-gates.py implements; nothing else is honoured.",
 "validator_support":[
  "$ref",
  "type",
  "enum",
  "const",
  "required",
  "properties",
  "items",
  "additionalProperties",
  "pattern",
  "minimum",
  "maximum",
  "minItems",
  "maxItems",
  "minLength",
  "maxLength",
  "minProperties",
  "anyOf",
  "oneOf"
 ],
 "type":"object",
 "additionalProperties":true,
 "required":[
  "ok",
  "tool",
  "version",
  "command",
  "data",
  "warnings",
  "errors",
  "meta"
 ],
 "properties":{
  "ok":{
   "type":"boolean"
  },
  "tool":{
   "const":"offline-game-development"
  },
  "version":{
   "type":"string",
   "minLength":1
  },
  "command":{
   "type":"string",
   "minLength":1
  },
  "data":{
   "type":[
    "object",
    "array",
    "null"
   ]
  },
  "warnings":{
   "type":"array",
   "items":{
    "type":"object",
    "required":[
     "code",
     "message"
    ]
   }
  },
  "errors":{
   "type":"array",
   "items":{
    "$ref":"#/$defs/error"
   }
  },
  "generated_at":{
   "type":"string"
  },
  "meta":{
   "type":"object",
   "minProperties":1
  }
 },
 "$defs":{
  "error":{
   "type":"object",
   "required":[
    "code",
    "message"
   ],
   "additionalProperties":true,
   "properties":{
    "code":{
     "type":"string",
     "pattern":"^E-[A-Z][A-Z-]*$"
    },
    "message":{
     "type":"string",
     "minLength":1
    },
    "hint":{
     "type":"string"
    },
    "where":{
     "type":"string"
    },
    "details":{
     "type":"object"
    }
   }
  },
  "identifier":{
   "type":"string",
   "pattern":"^c\\d{2}e\\d{2}$",
   "description":"capability id: c<category>e<entry>, zero padded"
  },
  "capability_ref":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "id",
    "name",
    "category",
    "archetype"
   ],
   "properties":{
    "id":{
     "$ref":"#/$defs/identifier"
    },
    "ref":{
     "type":"string",
     "pattern":"^\\d{1,2}\\.\\d{1,3}$"
    },
    "name":{
     "type":"string",
     "minLength":1
    },
    "slug":{
     "type":"string",
     "pattern":"^[a-z0-9-]+$"
    },
    "category":{
     "type":"integer",
     "minimum":1,
     "maximum":34
    },
    "category_title":{
     "type":"string"
    },
    "layer":{
     "enum":[
      "production-control-plane",
      "engine-packs",
      "runtime-skills",
      "content-skills",
      "release-skills"
     ]
    },
    "archetype":{
     "enum":[
      "implement",
      "define",
      "evaluate",
      "operate",
      "create",
      "provide"
     ]
    },
    "subject":{
     "type":"string"
    },
    "description":{
     "type":"string"
    },
    "tags":{
     "type":"array",
     "items":{
      "type":"string"
     }
    },
    "engines":{
     "type":"array",
     "items":{
      "type":"string"
     }
    },
    "risk":{
     "type":"object"
    }
   }
  },
  "section":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "id",
    "title",
    "rows",
    "gaps"
   ],
   "properties":{
    "id":{
     "type":"string",
     "pattern":"^[a-z0-9_]+$"
    },
    "title":{
     "type":"string"
    },
    "purpose":{
     "type":"string"
    },
    "blocking":{
     "type":"boolean"
    },
    "rows":{
     "type":"array",
     "items":{
      "type":"object"
     },
     "minItems":1
    },
    "gaps":{
     "type":"array",
     "items":{
      "type":"string"
     }
    }
   }
  },
  "spec_record":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "kind",
    "capability_id",
    "capability_name",
    "archetype",
    "generated_for",
    "sections",
    "gates",
    "evidence_to_file",
    "status"
   ],
   "properties":{
    "kind":{
     "const":"spec"
    },
    "capability_id":{
     "$ref":"#/$defs/identifier"
    },
    "capability_name":{
     "type":"string"
    },
    "category":{
     "type":"integer",
     "minimum":1,
     "maximum":34
    },
    "archetype":{
     "enum":[
      "implement",
      "define",
      "evaluate",
      "operate",
      "create",
      "provide"
     ]
    },
    "generated_for":{
     "type":"object",
     "minProperties":1
    },
    "sections":{
     "type":"array",
     "items":{
      "$ref":"#/$defs/section"
     },
     "minItems":1
    },
    "gates":{
     "type":"array",
     "minItems":1
    },
    "evidence_to_file":{
     "type":"array",
     "minItems":1
    },
    "assumptions":{
     "type":"array",
     "items":{
      "type":"string"
     }
    },
    "approvals":{
     "type":"array"
    },
    "status":{
     "enum":[
      "draft",
      "ready",
      "complete"
     ]
    },
    "open_fields":{
     "type":"integer",
     "minimum":0
    }
   }
  },
  "plan_item":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "seq",
    "phase",
    "capability_id",
    "capability_name",
    "owner",
    "gates",
    "effort"
   ],
   "properties":{
    "seq":{
     "type":"integer",
     "minimum":1
    },
    "phase":{
     "enum":[
      "decide",
      "produce",
      "build",
      "operate",
      "provide",
      "verify"
     ]
    },
    "capability_id":{
     "$ref":"#/$defs/identifier"
    },
    "capability_name":{
     "type":"string"
    },
    "owner":{
     "type":"string",
     "minLength":1
    },
    "gates":{
     "type":"array",
     "items":{
      "type":"string"
     },
     "minItems":1
    },
    "effort":{
     "enum":[
      "S",
      "M",
      "L",
      "XL"
     ]
    },
    "depends_on":{
     "type":"array",
     "items":{
      "type":"string"
     }
    },
    "risk_class":{
     "enum":[
      "routine",
      "resource-heavy",
      "approval-required"
     ]
    },
    "note":{
     "type":"string"
    }
   }
  },
  "checklist_item":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "id",
    "capability_id",
    "capability_name",
    "section",
    "text",
    "blocking",
    "evidence_kind",
    "done"
   ],
   "properties":{
    "id":{
     "type":"string",
     "pattern":"^CHK-c\\d{2}e\\d{2}-\\d{2}$"
    },
    "capability_id":{
     "$ref":"#/$defs/identifier"
    },
    "capability_name":{
     "type":"string"
    },
    "section":{
     "type":"string"
    },
    "section_title":{
     "type":"string"
    },
    "text":{
     "type":"string",
     "minLength":3
    },
    "blocking":{
     "type":"boolean"
    },
    "evidence_kind":{
     "type":"string"
    },
    "gate":{
     "type":"string"
    },
    "done":{
     "type":"boolean"
    }
   }
  },
  "evidence_record":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "kind",
    "capability_id",
    "capability_name",
    "verdict",
    "environment",
    "checks",
    "operator",
    "run_started"
   ],
   "properties":{
    "kind":{
     "const":"evidence"
    },
    "capability_id":{
     "$ref":"#/$defs/identifier"
    },
    "capability_name":{
     "type":"string"
    },
    "verdict":{
     "enum":[
      "pass",
      "fail",
      "blocked",
      "not-run"
     ]
    },
    "environment":{
     "type":"object",
     "required":[
      "engine",
      "engine_version",
      "platform",
      "hardware",
      "scene_or_build",
      "network_state"
     ],
     "properties":{
      "engine":{
       "type":"string",
       "minLength":1
      },
      "engine_version":{
       "type":"string",
       "minLength":1
      },
      "platform":{
       "type":"string",
       "minLength":1
      },
      "hardware":{
       "type":"string",
       "minLength":1,
       "description":"the device or profile actually used"
      },
      "scene_or_build":{
       "type":"string",
       "minLength":1
      },
      "network_state":{
       "enum":[
        "blocked",
        "connected",
        "mocked"
       ]
      },
      "os":{
       "type":"string"
      }
     }
    },
    "checks":{
     "type":"array",
     "minItems":1,
     "items":{
      "type":"object",
      "additionalProperties":true,
      "required":[
       "id",
       "kind",
       "description",
       "result"
      ],
      "properties":{
       "id":{
        "type":"string",
        "minLength":1
       },
       "kind":{
        "enum":[
         "automated",
         "manual",
         "gate",
         "measurement",
         "review"
        ]
       },
       "description":{
        "type":"string",
        "minLength":3
       },
       "command_hint":{
        "type":"string"
       },
       "measured":{},
       "pass_threshold":{
        "type":[
         "number",
         "boolean",
         "string",
         "null"
        ]
       },
       "result":{
        "enum":[
         "pass",
         "fail",
         "blocked",
         "not-run"
        ]
       }
      }
     }
    },
    "budget_reference":{
     "type":"object"
    },
    "measured_result":{
     "type":"string",
     "minLength":1
    },
    "pass_threshold":{
     "type":"string",
     "minLength":1
    },
    "failure_evidence":{
     "type":[
      "string",
      "object",
      "null"
     ]
    },
    "remediation":{
     "type":[
      "string",
      "object",
      "null"
     ]
    },
    "regression_retest":{
     "type":[
      "string",
      "object",
      "null"
     ]
    },
    "notes":{
     "type":"string"
    },
    "operator":{
     "type":"string",
     "minLength":1
    },
    "run_started":{
     "type":"string",
     "minLength":4,
     "description":"ISO-8601 UTC stamp of when the run began"
    },
    "reproducibility":{
     "type":"object",
     "additionalProperties":true
    },
    "gates":{
     "type":"array",
     "items":{
      "$ref":"#/$defs/gate_verdict"
     }
    },
    "evidence_files":{
     "type":"array",
     "items":{
      "type":"string"
     }
    }
   },
   "description":"One capability's recorded proof. verdict is the claim; the checks are the data. evidence check fails when the two disagree, when a gate of the capability's archetype has no recorded result, or when a fail verdict is missing failure_evidence, remediation, and regression_retest."
  },
  "gate_verdict":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "gate_id",
    "rule",
    "severity",
    "result",
    "message"
   ],
   "properties":{
    "gate_id":{
     "type":"string",
     "pattern":"^[A-Z][A-Z0-9-]*$"
    },
    "rule":{
     "type":"string"
    },
    "severity":{
     "enum":[
      "block",
      "warn",
      "info"
     ]
    },
    "result":{
     "enum":[
      "pass",
      "fail",
      "warn",
      "skipped",
      "info"
     ]
    },
    "message":{
     "type":"string"
    },
    "remediation":{
     "type":"string"
    },
    "applies_to":{
     "type":"string"
    },
    "details":{
     "type":"object"
    }
   }
  },
  "asset_manifest_record":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "asset",
    "kind",
    "license",
    "source",
    "acquired_from",
    "acquired_on",
    "generated_by",
    "commercial_use",
    "redistribution",
    "record_path"
   ],
   "properties":{
    "asset":{
     "type":"string",
     "minLength":1
    },
    "kind":{
     "type":"string"
    },
    "license":{
     "type":"string",
     "minLength":1
    },
    "source":{
     "type":"string"
    },
    "acquired_from":{
     "type":"string"
    },
    "acquired_on":{
     "type":"string"
    },
    "generated_by":{
     "type":"string"
    },
    "commercial_use":{
     "type":[
      "boolean",
      "null"
     ]
    },
    "redistribution":{
     "type":[
      "boolean",
      "null"
     ]
    },
    "attribution":{
     "type":[
      "boolean",
      "null"
     ]
    },
    "bundle_allowed":{
     "type":[
      "boolean",
      "null"
     ]
    },
    "record_path":{
     "type":"string"
    }
   }
  },
  "measurements_record":{
   "type":"object",
   "additionalProperties":true,
   "required":[
    "capability_id",
    "profile",
    "values"
   ],
   "properties":{
    "capability_id":{
     "type":"string",
     "minLength":1
    },
    "profile":{
     "type":"string",
     "minLength":1
    },
    "build_id":{
     "type":"string"
    },
    "values":{
     "type":"object",
     "minProperties":1
    },
    "notes":{
     "type":"string"
    }
   }
  }
 }
}
