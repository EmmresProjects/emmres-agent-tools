  "align_tolerance_pt": 1.5,
  "overlap_min_ratio": 0.12,
  "overlap_ignore_area_pt2": 60,
  "whitespace_min_gap_pt": 4,
  "color_drift_distance": 12,
  "title_zone_tolerance_pt": 8,
  "spacing_tolerance_pt": 2,
  "font_fallback_map": {
    "Calibri": ["Carlito", "Liberation Sans", "Arial"],
    "Calibri Light": ["Carlito", "Liberation Sans", "Arial"],
    "Arial": ["Liberation Sans", "Helvetica", "DejaVu Sans"],
    "Helvetica": ["Liberation Sans", "Arial", "DejaVu Sans"],
    "Segoe UI": ["Selawik", "DejaVu Sans", "Noto Sans"],
    "Segoe UI Light": ["Selawik", "DejaVu Sans", "Noto Sans"],
    "Verdana": ["DejaVu Sans", "Bitstream Vera Sans"],
    "Tahoma": ["DejaVu Sans", "Noto Sans"],
    "Times New Roman": ["Liberation Serif", "DejaVu Serif", "Noto Serif"],
    "Georgia": ["DejaVu Serif", "Noto Serif"],
    "Cambria": ["Caladea", "Liberation Serif", "DejaVu Serif"],
    "Courier New": ["Liberation Mono", "DejaVu Sans Mono"],
    "Consolas": ["Inconsolata", "DejaVu Sans Mono"],
    "Microsoft YaHei": ["Noto Sans CJK SC", "Source Han Sans SC"],
    "MS Gothic": ["Noto Sans CJK JP"],
    "Malgun Gothic": ["Noto Sans CJK KR"],
    "Gulim": ["Noto Sans CJK KR"],
    "Aptos": ["Carlito", "Liberation Sans", "Arial"],
    "Aptos Display": ["Carlito", "Liberation Sans", "Arial"]
  },
  "sensitive_patterns": {
    "aws_access_key": "AKIA[0-9A-Z]{16}",
    "private_key": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "bearer_token": "(?i)bearer\\s+[A-Za-z0-9._\\-]{16,}",
    "api_key_assignment": "(?i)(api[_-]?key|secret|token|password)\\s*[:=]\\s*[\"']?[A-Za-z0-9._\\-]{8,}",
    "email": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}",
    "phone_intl": "\\+\\d{1,3}[\\s\\-]?\\(?\\d{2,4}\\)?[\\s\\-]?\\d{3,4}[\\s\\-]?\\d{3,4}",
    "internal_url": "(?i)(file://|\\\\\\\\[a-z0-9._\\-]+\\\\|https?://(localhost|10\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.))",
    "sharepoint_tenant": "(?i)https?://[a-z0-9\\-]+\\.sharepoint\\.com/[^\\s\"']+",
    "phi_marker": "(?i)\\b(patient|mrn|diagnosis|ssn|dob)\\b\\s*[:#]"
  },
  "citation_required_patterns": ["%", "\\b\\d{4}\\b", "\\$", "€", "₱", "\\bdoubled?\\b", "\\bincreased?\\b", "\\bdecreased?\\b", "\\bpercent\\b"],
  "citation_hint_patterns": ["source:", "via ", "according to", "©", "http", "ref "],
  "allowed_link_domains": ["example.com", "w3.org", "un.org", "who.int", "worldbank.org", "oecd.org"],
  "risk_weights": {
    "error": 10,
    "warning": 4,
    "info": 1
  },
  "score_weights": {
    "readability": 0.25,
    "consistency": 0.2,
    "accessibility": 0.25,
    "structure": 0.15,
    "evidence": 0.15
  },
  "dependency_checks": {
    "check_fonts": true,
    "check_media": true,
    "check_links": true,
    "check_relationships": true
  },
  "limits": {
    "max_slides": 2000,
    "max_objects_per_slide": 3000,
    "max_file_bytes": 524288000,
    "render_max_pixels": 42000000,
    "timeout_seconds": 120
  }
}
