{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-workflow-schema.json",
  "title": "Offline Agents Automation Workflow Definition",
  "description": "Declarative workflow consumed by `tools-oaa.py workflow run --file`. Every step names a registered operation from `tools-oaa.py capabilities --ops`. Steps never execute arbitrary shell code; the operation allowlist is the only execution surface.",
  "type": "object",
  "required": ["workflow", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "workflow": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase hyphenated workflow name."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "description": {"type": "string", "maxLength": 1000},
    "owner": {"type": "string", "maxLength": 200},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_seconds": {"type": "number", "minimum": 0.1, "maximum": 86400},
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 64}, "maxItems": 20},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "op"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
            "maxLength": 64
          },
          "op": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$",
            "description": "Registered operation name, e.g. index.build or guard.check."
          },
          "params": {"type": "object"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "maxLength": 64},
            "maxItems": 50
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempts": {"type": "integer", "minimum": 1, "maximum": 20},
              "base_seconds": {"type": "number", "minimum": 0, "maximum": 60},
              "max_seconds": {"type": "number", "minimum": 0, "maximum": 600},
              "on": {
                "type": "array",
                "items": {
                  "enum": ["transient", "tool", "environment", "logic", "input",
                           "data", "state", "resource", "permission", "integrity"]
                }
              }
            }
          },
          "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 86400},
          "continue_on_error": {"type": "boolean"},
          "compensate": {
            "type": "object",
            "required": ["op"],
            "additionalProperties": false,
            "properties": {
              "op": {"type": "string"},
              "params": {"type": "object"}
            },
            "description": "Cleanup operation executed in reverse order when the workflow fails after this step completed."
          },
          "approval": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {"type": "string"},
              "reason": {"type": "string", "maxLength": 1000},
              "evidence": {"type": "object"}
            },
            "description": "Explicit human approval gate recorded before the step body runs."
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 120,
            "description": "When set, a completed step result is replayed instead of re-executed."
          }
        }
      }
    }
  }
}
