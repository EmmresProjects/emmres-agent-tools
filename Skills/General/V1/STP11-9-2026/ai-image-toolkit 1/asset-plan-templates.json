{
  "description": "Category blueprints used by plan.blueprint. Each entry follows the recommended blueprint from the AI Image Skill Catalog: trigger, inputs, outputs, tool routing, workflow, evaluation, governance, recovery. Keys are category numbers.",
  "default": {
    "evaluation": [
      "Normal case: a typical request produces the expected output and passes the category checks.",
      "Boundary case: extreme sizes, counts or very long text are rejected or flagged with a clear message.",
      "Failure case: missing or invalid inputs return a structured error and no partial output."
    ],
    "governance": [
      "Record rights, consent, privacy and retention for every source image or reference.",
      "Keep AI-generation or edit disclosure with any published output.",
      "Require human approval before publishing, sharing externally or handling identifiable people."
    ],
    "recovery": [
      "Preserve the last passing output and its exact settings.",
      "Isolate the failing stage and change one variable at a time.",
      "Rerun the affected checks and record the result before continuing."
    ]
  },
  "1": {
    "name": "Foundations of Generative Imaging",
    "inputs": ["Concept or question to explain", "Target audience level", "Optional numeric parameters such as width, height, channels, steps"],
    "outputs": ["Plain-language explanation or specification", "Structured numeric results where relevant", "Glossary or diagram notes"],
    "routing": ["Deterministic numeric helpers for tensors, schedules and latents", "Heuristic checks for prompts and tokens"],
    "workflow": ["Confirm the concept and audience", "Run the numeric helper with explicit parameters", "Explain results with stated assumptions", "Flag any claim that depends on a specific model"]
  },
