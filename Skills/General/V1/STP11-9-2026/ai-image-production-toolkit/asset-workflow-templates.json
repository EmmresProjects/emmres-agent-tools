{
  "source": "AI Image Skill Catalog - workflow, platform and template data",
  "a1111_presets": {
    "txt2img": {
      "negative_prompt": "text artifacts, watermark, signature, blurry, low quality, extra fingers, malformed hands, deformed anatomy, duplicate subject, oversaturated",
      "params": {"sampler_name": "DPM++ 2M", "scheduler": "Karras", "steps": 30, "cfg_scale": 7.0, "width": 1024, "height": 1024, "hires_fix": false, "clip_skip": 1, "seed": -1},
      "notes": "Baseline SDXL text-to-image preset."
    },
    "txt2img_hires": {
      "negative_prompt": "text artifacts, watermark, signature, blurry, low quality, extra fingers, malformed hands, deformed anatomy, duplicate subject, oversaturated",
      "params": {"sampler_name": "DPM++ 2M", "scheduler": "Karras", "steps": 30, "cfg_scale": 7.0, "width": 1024, "height": 1024, "clip_skip": 1, "seed": -1, "hires_fix": true, "hires_upscaler": "4x-UltraSharp", "hires_steps": 12, "hires_cfg_scale": 6.0, "hires_resize": 1.5, "hires_denoising_strength": 0.35, "hires_upscaler_for": "Latent"},
      "notes": "Two-pass rendering. Keep hires denoising below 0.45 or detail turns waxy."
    },
    "img2img": {
      "negative_prompt": "text artifacts, watermark, signature, blurry, low quality, deformed anatomy",
      "params": {"sampler_name": "DPM++ 2M", "scheduler": "Karras", "steps": 30, "cfg_scale": 7.0, "width": 1024, "height": 1024, "denoising_strength": 0.55, "clip_skip": 1},
      "notes": "Below 0.35 the source dominates; above 0.75 the composition is redrawn."
    },
    "inpaint": {
      "negative_prompt": "text artifacts, watermark, signature, blurry, low quality, visible seams, mismatched lighting",
      "params": {"sampler_name": "DPM++ 2M", "scheduler": "Karras", "steps": 30, "cfg_scale": 7.0, "width": 1024, "height": 1024, "denoising_strength": 0.75, "mask_blur": 8, "inpaint_full_res": false, "inpaint_full_res_padding": 32, "inpaint_area": "Only masked"},
      "notes": "Mask blur above the seam length hides the boundary. Keep masked content at the native resolution."
    },
    "controlnet": {
      "negative_prompt": "text artifacts, watermark, signature, blurry, low quality, deformed anatomy",
      "params": {"sampler_name": "DPM++ 2M", "scheduler": "Karras", "steps": 30, "cfg_scale": 7.0, "width": 1024, "height": 1024, "alwayson_scripts": [], "controlnet": [{"module": "control_v11p_sd15_canny", "model": "control_v11p_sd15_canny", "weight": 0.7, "control_mode": "Balanced", "pixel_perfect": true, "resize_mode": "Crop and resize", "start_percent": 0.0, "end_percent": 0.8}]},
      "notes": "Balanced control mode; pixel perfect on. Reduce weight before touching the denoise window."
    }
  },
  "comfyui_templates": {
    "txt2img": {
      "nodes": [
        {"id": 1, "type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sdxl_base.safetensors"}, "outputs": ["MODEL", "CLIP", "VAE"]},
        {"id": 2, "type": "CLIPTextEncode", "inputs": {"text": "{prompt}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 3, "type": "CLIPTextEncode", "inputs": {"text": "{negative}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 4, "type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}, "outputs": ["LATENT"]},
        {"id": 5, "type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0, "model": [1, 0], "positive": [2, 0], "negative": [3, 0], "latent_image": [4, 0]}, "outputs": ["LATENT"]},
        {"id": 6, "type": "VAEDecode", "inputs": {"samples": [5, 0], "vae": [1, 2]}, "outputs": ["IMAGE"]},
        {"id": 7, "type": "SaveImage", "inputs": {"filename_prefix": "render", "images": [6, 0]}, "outputs": []}
      ]
    },
    "img2img": {
      "nodes": [
        {"id": 1, "type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sdxl_base.safetensors"}, "outputs": ["MODEL", "CLIP", "VAE"]},
        {"id": 2, "type": "CLIPTextEncode", "inputs": {"text": "{prompt}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 3, "type": "CLIPTextEncode", "inputs": {"text": "{negative}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 8, "type": "LoadImage", "inputs": {"image": "input.png"}, "outputs": ["IMAGE", "MASK"]},
        {"id": 9, "type": "VAEEncode", "inputs": {"pixels": [8, 0], "vae": [1, 2]}, "outputs": ["LATENT"]},
        {"id": 5, "type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.55, "model": [1, 0], "positive": [2, 0], "negative": [3, 0], "latent_image": [9, 0]}, "outputs": ["LATENT"]},
        {"id": 6, "type": "VAEDecode", "inputs": {"samples": [5, 0], "vae": [1, 2]}, "outputs": ["IMAGE"]},
        {"id": 7, "type": "SaveImage", "inputs": {"filename_prefix": "render", "images": [6, 0]}, "outputs": []}
      ]
    },
    "inpaint": {
      "nodes": [
        {"id": 1, "type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sdxl_base.safetensors"}, "outputs": ["MODEL", "CLIP", "VAE"]},
        {"id": 2, "type": "CLIPTextEncode", "inputs": {"text": "{prompt}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 3, "type": "CLIPTextEncode", "inputs": {"text": "{negative}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 8, "type": "LoadImage", "inputs": {"image": "input.png"}, "outputs": ["IMAGE", "MASK"]},
        {"id": 10, "type": "LoadImage", "inputs": {"image": "mask.png"}, "outputs": ["IMAGE", "MASK"]},
        {"id": 11, "type": "VAEEncodeForInpaint", "inputs": {"pixels": [8, 0], "vae": [1, 2], "mask": [10, 1], "grow_mask_by": 12}, "outputs": ["LATENT"]},
        {"id": 5, "type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.75, "model": [1, 0], "positive": [2, 0], "negative": [3, 0], "latent_image": [11, 0]}, "outputs": ["LATENT"]},
        {"id": 6, "type": "VAEDecode", "inputs": {"samples": [5, 0], "vae": [1, 2]}, "outputs": ["IMAGE"]},
        {"id": 7, "type": "SaveImage", "inputs": {"filename_prefix": "render", "images": [6, 0]}, "outputs": []}
      ]
    },
    "controlnet": {
      "nodes": [
        {"id": 1, "type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sdxl_base.safetensors"}, "outputs": ["MODEL", "CLIP", "VAE"]},
        {"id": 2, "type": "CLIPTextEncode", "inputs": {"text": "{prompt}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 3, "type": "CLIPTextEncode", "inputs": {"text": "{negative}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 12, "type": "ControlNetLoader", "inputs": {"control_net_name": "control_v11p_sd15_canny.pth"}, "outputs": ["CONTROL_NET"]},
        {"id": 13, "type": "LoadImage", "inputs": {"image": "control.png"}, "outputs": ["IMAGE", "MASK"]},
        {"id": 14, "type": "ControlNetApplyAdvanced", "inputs": {"strength": 0.7, "start_percent": 0.0, "end_percent": 0.8, "positive": [2, 0], "negative": [3, 0], "control_net": [12, 0], "image": [13, 0]}, "outputs": ["CONDITIONING", "CONDITIONING"]},
        {"id": 4, "type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}, "outputs": ["LATENT"]},
        {"id": 5, "type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0, "model": [1, 0], "positive": [14, 0], "negative": [14, 1], "latent_image": [4, 0]}, "outputs": ["LATENT"]},
        {"id": 6, "type": "VAEDecode", "inputs": {"samples": [5, 0], "vae": [1, 2]}, "outputs": ["IMAGE"]},
        {"id": 7, "type": "SaveImage", "inputs": {"filename_prefix": "render", "images": [6, 0]}, "outputs": []}
      ]
    },
    "upscale": {
      "nodes": [
        {"id": 1, "type": "LoadImage", "inputs": {"image": "input.png"}, "outputs": ["IMAGE", "MASK"]},
        {"id": 2, "type": "ImageUpscaleWithModel", "inputs": {"upscale_model_name": "4x-UltraSharp.pth"}, "outputs": ["IMAGE"]},
        {"id": 3, "type": "SaveImage", "inputs": {"filename_prefix": "upscaled", "images": [2, 0]}, "outputs": []}
      ]
    },
    "hires-fix": {
      "nodes": [
        {"id": 1, "type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sdxl_base.safetensors"}, "outputs": ["MODEL", "CLIP", "VAE"]},
        {"id": 2, "type": "CLIPTextEncode", "inputs": {"text": "{prompt}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 3, "type": "CLIPTextEncode", "inputs": {"text": "{negative}", "clip": [1, 1]}, "outputs": ["CONDITIONING"]},
        {"id": 4, "type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}, "outputs": ["LATENT"]},
        {"id": 5, "type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0, "model": [1, 0], "positive": [2, 0], "negative": [3, 0], "latent_image": [4, 0]}, "outputs": ["LATENT"]},
        {"id": 6, "type": "VAEDecode", "inputs": {"samples": [5, 0], "vae": [1, 2]}, "outputs": ["IMAGE"]},
        {"id": 7, "type": "ImageUpscaleWithModel", "inputs": {"upscale_model_name": "4x-UltraSharp.pth"}, "outputs": ["IMAGE"]},
        {"id": 8, "type": "VAEEncode", "inputs": {"pixels": [7, 0], "vae": [1, 2]}, "outputs": ["LATENT"]},
        {"id": 9, "type": "KSampler", "inputs": {"seed": 0, "steps": 14, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.35, "model": [1, 0], "positive": [2, 0], "negative": [3, 0], "latent_image": [8, 0]}, "outputs": ["LATENT"]},
        {"id": 10, "type": "VAEDecode", "inputs": {"samples": [9, 0], "vae": [1, 2]}, "outputs": ["IMAGE"]},
        {"id": 11, "type": "SaveImage", "inputs": {"filename_prefix": "hires", "images": [10, 0]}, "outputs": []}
      ]
    }
  },
