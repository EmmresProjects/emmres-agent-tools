<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Safe defaults merged into every ExportOptions.plist generated by
	  tools-iosh.py export-options. Values that the command computes
	  (method, teamID, signingStyle, provisioningProfiles) always win.
	  Keep this file free of secrets: no team IDs, no profile names, no keys.
	-->
	<key>destination</key>
	<string>export</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>compileBitcode</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
