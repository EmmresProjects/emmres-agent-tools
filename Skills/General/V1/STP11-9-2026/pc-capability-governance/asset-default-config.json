{
  "config_version": "1.0.0",
  "description": "Default configuration for the pc-capability-governance Skill Tool. Copy, edit and pass with --config <path>. Relative paths are resolved from the process working directory; packaged asset names (for example asset-approval-policy.json) resolve from the Skill Tool folder.",
  "timeout_seconds": 10,
  "retries": 1,
  "offline": false,
  "evidence_dir": "evidence",
  "evidence_root": ".",
  "keep_probe_payloads": false,
  "provider_file": null,
  "approval_policy": "asset-approval-policy.json",
  "boundary_terms": "asset-boundary-terms.json",
  "route_mode": "least-privilege",
  "max_text_bytes": 2000000,
  "network_probe": {
    "host": "1.1.1.1",
    "port": 443,
    "timeout_seconds": 0.6
  },
  "self_test": {
    "default_check_runs": 1,
    "max_check_runs": 10,
    "fail_on_contract_violation": true
  },
  "redaction": {
    "patterns": [
      "(?i)(password|passwd|pwd|token|secret|api[_-]?key|authorization)(\\s*[=:]\\s*)(\\S+)",
      "(?i)(--(?:password|token|secret|key)[ =])(\\S+)",
      "(?i)\\bBearer\\s+[A-Za-z0-9._\\-]{8,}",
      "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b"
    ]
  }
}
