{
  "schema_version": "1.0",
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "path_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.).*$"
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "operation",
        "handler",
        "supported_formats"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "supported_formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider_hint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "name",
        "format",
        "path",
        "bytes",
        "primary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skipped"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  },
  "schemas": {
    "config": {
      "type": "object",
      "required": [
        "schema_version",
        "catalog_path",
        "policy_path",
        "limits",
        "providers",
        "models",
        "storage",
        "approval"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "catalog_path": {
          "$ref": "#/$defs/path_string"
        },
        "policy_path": {
          "$ref": "#/$defs/path_string"
        },
        "limits": {
          "type": "object",
          "required": [
            "max_input_bytes",
            "timeout_seconds",
            "retry_count"
          ]
        },
        "providers": {
          "type": "object"
        },
        "models": {
          "type": "object"
        },
        "storage": {
          "type": "object"
        },
        "approval": {
          "type": "object",
          "required": [
            "token_env"
          ]
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "schema_version",
        "tool_name",
        "category_count",
        "capability_count",
        "categories"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "category_count": {
          "type": "integer",
          "minimum": 1
        },
        "capability_count": {
          "type": "integer",
          "minimum": 1
        },
        "categories": {
          "type": "array"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "umbrella_name",
        "source_format",
        "categories",
        "capabilities",
        "warnings"
      ],
      "properties": {
        "umbrella_name": {
          "type": "string"
        },
        "source_format": {
          "enum": [
            "text",
            "markdown",
            "html"
          ]
        },
        "categories": {
          "type": "array"
        },
        "capabilities": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "tool_name",
        "capability_count",
        "capabilities",
        "categories",
        "operations",
        "handlers"
      ],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "capability_count": {
          "type": "integer",
          "minimum": 1
        },
        "capabilities": {
          "type": "array"
        },
        "categories": {
          "type": "array"
        },
        "operations": {
          "type": "array"
        },
        "handlers": {
          "type": "array"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "artifacts",
        "checks",
        "errors",
        "warnings",
        "metrics",
        "limits"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "batch": {
      "type": "object",
      "required": [
        "ok",
        "command",
        "items",
        "summary"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "summary": {
          "type": "object"
        }
      }
    }
  }
}
