{
  "mission_id": "sample-local-research-brief-001",
  "goal": "Produce a verified local research brief from bounded evidence fragments without network or shell execution",
  "constraints": [
    "Use only local deterministic task operations",
    "Do not call external tools or models",
    "Keep worker contexts isolated unless a handoff is explicit"
  ],
  "deadline_seconds": 10,
  "workers": [
    {"worker_id": "planner-1", "role": "planner", "capabilities": ["decompose", "schedule"], "capacity": 2},
    {"worker_id": "researcher-1", "role": "researcher", "capabilities": ["normalize", "summarize"], "capacity": 2},
    {"worker_id": "analyst-1", "role": "analyst", "capabilities": ["score", "compare", "aggregate"], "capacity": 2},
    {"worker_id": "reviewer-1", "role": "reviewer", "capabilities": ["validate"], "capacity": 2},
    {"worker_id": "integrator-1", "role": "integrator", "capabilities": ["merge", "aggregate"], "capacity": 2},
    {"worker_id": "safety-1", "role": "safety-officer", "capabilities": ["policy-check"], "capacity": 1}
  ],
  "tasks": [
    {
      "task_id": "T1",
      "name": "Normalize evidence fragments",
      "operation": "normalize",
      "payload": {"values": ["  Local Evidence A  ", "LOCAL Evidence B ", "  Local Evidence C"]},
      "depends_on": [],
      "priority": 90,
      "risk": "low",
      "required_role": "researcher",
      "estimated_seconds": 0.003,
      "transient_failures": 0
    },
    {
      "task_id": "T2",
      "name": "Score claim support",
      "operation": "score",
      "payload": {"values": [2, 4, 6, 8]},
      "depends_on": ["T1"],
      "priority": 80,
      "risk": "low",
      "required_role": "analyst",
      "estimated_seconds": 0.003,
      "transient_failures": 1
    },
    {
      "task_id": "T3",
      "name": "Compare plan variants",
      "operation": "compare",
      "payload": {"left": 4, "right": 3.5},
      "depends_on": ["T1"],
      "priority": 70,
      "risk": "low",
      "required_role": "analyst",
      "estimated_seconds": 0.003,
      "transient_failures": 0
    },
    {
      "task_id": "T4",
      "name": "Validate intermediate checks",
      "operation": "validate",
      "payload": {"checks": {"schema_present": true, "dependencies_declared": true, "no_external_calls": true}},
      "depends_on": ["T2", "T3"],
      "priority": 60,
      "risk": "low",
      "required_role": "reviewer",
      "estimated_seconds": 0.003,
      "transient_failures": 0
    },
    {
      "task_id": "T5",
      "name": "Summarize goal and constraints",
      "operation": "summarize",
      "payload": {"text": "Produce a verified local research brief from bounded evidence fragments without network or shell execution"},
      "depends_on": ["T4"],
      "priority": 50,
      "risk": "low",
      "required_role": "researcher",
      "estimated_seconds": 0.003,
      "transient_failures": 0
    },
    {
      "task_id": "T6",
      "name": "Merge verified sections",
      "operation": "merge",
      "payload": {"parts": ["Evidence", "Scores", "Checks"]},
      "depends_on": ["T4", "T5"],
      "priority": 40,
      "risk": "low",
      "required_role": "integrator",
      "estimated_seconds": 0.003,
      "transient_failures": 0
    },
    {
      "task_id": "T7",
      "name": "Aggregate final metrics",
      "operation": "aggregate",
      "payload": {"values": [1, 2, 3]},
      "depends_on": ["T2", "T3", "T6"],
      "priority": 30,
      "risk": "low",
      "required_role": "integrator",
      "estimated_seconds": 0.003,
      "transient_failures": 0
    }
  ],
  "acceptance_criteria": [
    "All seven tasks complete",
    "Dependency order is respected",
    "Transient failure is retried within the configured retry budget",
    "Structured output validates against the packaged result schema"
  ]
}
