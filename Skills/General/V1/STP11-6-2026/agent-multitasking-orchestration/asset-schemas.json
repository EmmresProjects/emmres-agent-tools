{
  "config": {
    "type": "object",
    "required": ["schema_version", "tool", "provider", "runtime", "limits", "safety", "paths"],
    "properties": {
      "schema_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
      "tool": {
        "type": "object",
        "required": ["name", "version", "umbrella"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string"},
          "umbrella": {"type": "string", "minLength": 1}
        }
      },
      "provider": {
        "type": "object",
        "required": ["name", "model", "endpoint", "network_access", "max_external_calls"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "endpoint": {"type": ["string", "null"]},
          "network_access": {"type": "boolean"},
          "max_external_calls": {"type": "integer", "minimum": 0, "maximum": 0}
        }
      },
      "runtime": {
        "type": "object",
        "required": ["storage", "concurrency", "task_timeout_seconds", "max_runtime_seconds", "retries", "retry_backoff_seconds", "cancellation_poll_seconds", "checkpoint", "cleanup_ephemeral_state"],
        "properties": {
          "storage": {"type": "string", "enum": ["auto", "memory", "filesystem-json"]},
          "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
          "task_timeout_seconds": {"type": "number", "minimum": 0.01, "maximum": 60},
          "max_runtime_seconds": {"type": "number", "minimum": 0.1, "maximum": 300},
          "retries": {"type": "integer", "minimum": 0, "maximum": 5},
          "retry_backoff_seconds": {"type": "number", "minimum": 0, "maximum": 5},
          "cancellation_poll_seconds": {"type": "number", "minimum": 0, "maximum": 5},
          "checkpoint": {"type": "boolean"},
          "cleanup_ephemeral_state": {"type": "boolean"}
        }
      },
      "limits": {
        "type": "object",
        "required": ["max_input_bytes", "max_pdf_pages", "max_categories", "max_capabilities", "max_description_chars", "max_tasks", "max_workers", "max_result_bytes", "max_artifact_bytes"],
        "properties": {
          "max_input_bytes": {"type": "integer", "minimum": 1024},
          "max_pdf_pages": {"type": "integer", "minimum": 1},
          "max_categories": {"type": "integer", "minimum": 1},
          "max_capabilities": {"type": "integer", "minimum": 1},
          "max_description_chars": {"type": "integer", "minimum": 80},
          "max_tasks": {"type": "integer", "minimum": 1},
          "max_workers": {"type": "integer", "minimum": 1},
          "max_result_bytes": {"type": "integer", "minimum": 1024},
          "max_artifact_bytes": {"type": "integer", "minimum": 1024}
        }
      },
      "safety": {
        "type": "object",
        "required": ["approval_required_for_sensitive_actions", "allow_shell", "allow_network", "allow_arbitrary_code", "allowed_task_operations"],
        "properties": {
          "approval_required_for_sensitive_actions": {"type": "boolean"},
          "allow_shell": {"type": "boolean"},
          "allow_network": {"type": "boolean"},
          "allow_arbitrary_code": {"type": "boolean"},
          "allowed_task_operations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      },
      "paths": {
        "type": "object",
        "required": ["catalog", "profiles", "policy", "prompts", "role_blueprints", "schemas", "sample_mission", "sample_source_html", "sample_source_markdown", "sample_source_text"],
        "properties": {
          "catalog": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "profiles": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "policy": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "prompts": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "role_blueprints": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "schemas": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sample_mission": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sample_source_html": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sample_source_markdown": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sample_source_text": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
        }
      }
    }
  },
  "catalog": {
    "$defs": {
      "capability": {
        "type": "object",
        "required": ["id", "name", "slug", "description", "category", "category_slug", "category_index"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "description": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "category_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "category_index": {"type": "integer", "minimum": 1}
        }
      },
      "category": {
        "type": "object",
        "required": ["index", "name", "slug", "capabilities"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}}
        }
      }
    },
    "type": "object",
    "required": ["schema_version", "source", "umbrella", "counts", "categories", "capabilities", "warnings"],
    "properties": {
      "schema_version": {"type": "string"},
      "source": {"type": "object"},
      "umbrella": {"type": "object", "required": ["name", "slug"], "properties": {"name": {"type": "string"}, "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}},
      "counts": {"type": "object", "required": ["categories", "capabilities"], "properties": {"categories": {"type": "integer", "minimum": 0}, "capabilities": {"type": "integer", "minimum": 1}}},
      "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
      "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
      "warnings": {"type": "array", "items": {"type": "string"}}
    }
  },
  "capability_profiles": {
    "type": "object",
    "required": ["schema_version", "umbrella", "counts", "profiles"],
    "properties": {
      "schema_version": {"type": "string"},
      "umbrella": {"type": "object"},
      "counts": {"type": "object"},
      "profiles": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "slug", "name", "category", "category_slug", "description", "handler", "artifact_type", "operation", "focus_terms", "risk", "approval_scope", "output_contract"],
          "properties": {
            "id": {"type": "string"},
            "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "name": {"type": "string"},
            "category": {"type": "string"},
            "category_slug": {"type": "string"},
            "description": {"type": "string"},
            "handler": {"type": "string"},
            "artifact_type": {"type": "string"},
            "operation": {"type": "string"},
            "focus_terms": {"type": "array", "items": {"type": "string"}},
            "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "approval_scope": {"type": "string"},
            "output_contract": {"type": "object"},
            "timeout_seconds": {"type": "number", "minimum": 0.01},
            "retries": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "mission": {
    "type": "object",
    "required": ["mission_id", "goal", "tasks"],
    "properties": {
      "mission_id": {"type": "string", "minLength": 1},
      "goal": {"type": "string", "minLength": 1},
      "constraints": {"type": "array", "items": {"type": "string"}},
      "deadline_seconds": {"type": "number", "minimum": 0.1, "maximum": 300},
      "workers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["worker_id", "role", "capabilities"],
          "properties": {
            "worker_id": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "capabilities": {"type": "array", "items": {"type": "string"}},
            "capacity": {"type": "integer", "minimum": 1}
          }
        }
      },
      "tasks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": {
          "type": "object",
          "required": ["task_id", "name", "operation", "payload", "depends_on", "priority", "risk"],
          "properties": {
            "task_id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "operation": {"type": "string", "enum": ["normalize", "score", "compare", "validate", "merge", "summarize", "aggregate"]},
            "payload": {"type": "object"},
            "depends_on": {"type": "array", "items": {"type": "string"}},
            "priority": {"type": "integer", "minimum": 0, "maximum": 100},
            "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "required_role": {"type": "string"},
            "estimated_seconds": {"type": "number", "minimum": 0, "maximum": 5},
            "transient_failures": {"type": "integer", "minimum": 0, "maximum": 5},
            "requires_approval": {"type": "boolean"}
          }
        }
      },
      "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
    }
  },
  "approval": {
    "type": "object",
    "required": ["schema_version", "status", "action", "scope", "approved_by", "reason", "issued_at", "expires_at"],
    "properties": {
      "schema_version": {"type": "string"},
      "status": {"type": "string", "enum": ["approved"]},
      "action": {"type": "string", "minLength": 1},
      "scope": {"type": "string", "minLength": 1},
      "approved_by": {"type": "string", "minLength": 1},
      "reason": {"type": "string", "minLength": 1},
      "issued_at": {"type": "string", "minLength": 1},
      "expires_at": {"type": "string", "minLength": 1},
      "nonce": {"type": "string"}
    }
  },
  "capability_result": {
    "type": "object",
    "required": ["status", "command", "timestamp", "capability", "category", "handler", "summary", "artifact", "checks", "next_actions", "limits", "audit"],
    "properties": {
      "status": {"type": "string", "enum": ["ok", "approval_required", "cancelled"]},
      "command": {"type": "string"},
      "timestamp": {"type": "string"},
      "capability": {"type": "object"},
      "category": {"type": "string"},
      "handler": {"type": "string"},
      "summary": {"type": "string", "minLength": 1},
      "artifact": {"type": "object"},
      "checks": {"type": "array", "items": {"type": "object"}},
      "next_actions": {"type": "array", "items": {"type": "string"}},
      "limits": {"type": "object"},
      "audit": {"type": "object"}
    }
  },
  "mission_result": {
    "type": "object",
    "required": ["status", "command", "timestamp", "mission_id", "execution", "results", "verification", "recovery", "cleanup", "events"],
    "properties": {
      "status": {"type": "string", "enum": ["ok", "approval_required", "cancelled", "error"]},
      "command": {"type": "string"},
      "timestamp": {"type": "string"},
      "mission_id": {"type": "string"},
      "execution": {"type": "object"},
      "results": {"type": "array", "items": {"type": "object"}},
      "verification": {"type": "object"},
      "recovery": {"type": "object"},
      "cleanup": {"type": "object"},
      "events": {"type": "array", "items": {"type": "object"}}
    }
  },
  "cli_output": {
    "type": "object",
    "required": ["status", "command", "timestamp"],
    "properties": {
      "status": {"type": "string"},
      "command": {"type": "string"},
      "timestamp": {"type": "string"},
      "result": {"type": "object"},
      "error": {"type": "object"}
    }
  }
}
