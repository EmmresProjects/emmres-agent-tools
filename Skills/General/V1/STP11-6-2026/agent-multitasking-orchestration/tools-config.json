{
  "schema_version": "1.0",
  "tool": {
    "name": "agent-multitasking-orchestration",
    "version": "1.0.0",
    "umbrella": "Agent Multitasking"
  },
  "provider": {
    "name": "local-deterministic",
    "model": "none",
    "endpoint": null,
    "network_access": false,
    "max_external_calls": 0
  },
  "runtime": {
    "storage": "auto",
    "concurrency": 2,
    "task_timeout_seconds": 2.0,
    "max_runtime_seconds": 15.0,
    "retries": 2,
    "retry_backoff_seconds": 0.01,
    "cancellation_poll_seconds": 0.01,
    "checkpoint": true,
    "cleanup_ephemeral_state": true
  },
  "limits": {
    "max_input_bytes": 10485760,
    "max_pdf_pages": 500,
    "max_categories": 100,
    "max_capabilities": 1000,
    "max_description_chars": 4000,
    "max_tasks": 256,
    "max_workers": 16,
    "max_result_bytes": 2097152,
    "max_artifact_bytes": 1048576
  },
  "safety": {
    "approval_required_for_sensitive_actions": true,
    "allow_shell": false,
    "allow_network": false,
    "allow_arbitrary_code": false,
    "allowed_task_operations": [
      "normalize",
      "score",
      "compare",
      "validate",
      "merge",
      "summarize",
      "aggregate"
    ]
  },
  "paths": {
    "catalog": "agent-multitasking-orchestration/asset-catalog.json",
    "profiles": "agent-multitasking-orchestration/asset-capability-profiles.json",
    "policy": "agent-multitasking-orchestration/asset-policy.json",
    "prompts": "agent-multitasking-orchestration/asset-reasoning-lenses.json",
    "role_blueprints": "agent-multitasking-orchestration/asset-role-blueprints.json",
    "schemas": "agent-multitasking-orchestration/asset-schemas.json",
    "sample_mission": "agent-multitasking-orchestration/asset-sample-mission.json",
    "sample_source_html": "agent-multitasking-orchestration/asset-sample-source.html",
    "sample_source_markdown": "agent-multitasking-orchestration/asset-sample-source.md",
    "sample_source_text": "agent-multitasking-orchestration/asset-sample-source.txt"
  }
}
