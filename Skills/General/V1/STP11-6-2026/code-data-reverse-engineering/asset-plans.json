{
 "schema": "retool.plans.v1",
 "note": "Bounded, authorized runbook templates. {target} is replaced with the artifact path; {outdir} with a fresh output directory. Commands are never auto-executed by the tool. Dynamic steps require an isolated, authorized environment and explicit operator approval.",
 "templates": {
  "static-survey": {
   "title": "Read-only static survey",
   "purpose": "defensive",
   "authorization": "Confirm ownership or written authorization for the artifact.",
   "prerequisites": [
    "python3 >= 3.10",
    "optional: file, readelf, objdump, nm, strings"
   ],
   "steps": [
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py survey {target} --format json",
     "expected": "Identification, hashes, entropy, strings, format summary",
     "checkpoint": "Record sha256 in the case ledger"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py parse {target} --format json",
     "expected": "Format-specific structure",
     "checkpoint": "Note parser limits"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py strings {target} --limit 200 --format json",
     "expected": "Strings with offsets",
     "checkpoint": "Flag sensitive material for redacted handling"
    },
    {
     "tool": "file",
     "command": "file --brief {target}",
     "expected": "Independent type opinion",
     "checkpoint": "Compare with retool identify; explain disagreement"
    }
   ],
   "limits": "Read-only. No execution of the artifact. Cap string and parse output with the tool limits.",
   "verification": "Re-run survey from a clean directory and compare sha256 of inputs and JSON result payloads."
  },
  "dynamic-sandbox": {
   "title": "Authorized isolated dynamic analysis (plan only)",
   "purpose": "defensive",
   "authorization": "Written authorization + isolated VM/sandbox with snapshots and no production network. Operator must approve each dynamic step.",
   "prerequisites": [
    "isolated VM or container with snapshot/rollback",
    "no host shares",
    "network disabled or simulated",
    "monitoring tools installed in the sandbox"
   ],
   "steps": [
    {
     "tool": "operator",
     "command": "# Create a snapshot of the isolated environment before any execution",
     "expected": "Revertible state",
     "checkpoint": "Snapshot id recorded"
    },
    {
     "tool": "operator",
     "command": "# Transfer a verified copy (sha256 recorded) into the sandbox; never the original",
     "expected": "Copy hash matches case record",
     "checkpoint": "Hash verified"
    },
    {
     "tool": "strace",
     "command": "strace -f -tt -s 256 -o {outdir}/syscalls.log <target-copy> <args>",
     "expected": "System call trace",
     "checkpoint": "Trace captured; timeout enforced by operator"
    },
    {
     "tool": "operator",
     "command": "# Observe file/registry/process/network effects; collect logs into {outdir}",
     "expected": "Behavior notes",
     "checkpoint": "Indicators recorded defensively"
    },
    {
     "tool": "operator",
     "command": "# Revert the snapshot after collection",
     "expected": "Clean state restored",
     "checkpoint": "Revert confirmed"
    }
   ],
   "limits": "Never run on a host with production data or network access. Time-box execution. This tool does not execute these steps.",
   "verification": "Compare pre/post hashes of the environment; retain failing cases and logs."
  },
  "debugger-session": {
   "title": "Debugger-assisted behavior analysis (plan only)",
   "purpose": "research",
   "authorization": "Authorized artifact and isolated environment; operator approval per breakpoint/run.",
   "prerequisites": [
    "gdb or lldb or WinDbg installed",
    "symbols if available",
    "snapshot/rollback"
   ],
   "steps": [
    {
     "tool": "gdb",
     "command": "gdb -q --batch -ex 'set pagination off' -ex 'info functions' -ex 'info sharedlibrary' <target-copy>",
     "expected": "Functions and modules",
     "checkpoint": "Module list recorded"
    },
    {
     "tool": "gdb",
     "command": "gdb -q --batch -ex 'break main' -ex 'run' -ex 'info registers' -ex 'x/16i $pc' <target-copy>",
     "expected": "Entry state",
     "checkpoint": "Registers/stack recorded"
    },
    {
     "tool": "operator",
     "command": "# Set watchpoints on interesting buffers; single-step sparingly; record addresses and conditions",
     "expected": "Behavior notes",
     "checkpoint": "Addresses tied to static offsets"
    }
   ],
   "limits": "Plan only; no automatic execution. Anti-debug behavior is reported, never bypassed.",
   "verification": "Cross-check observed addresses against static section maps."
  },
  "adb-session": {
   "title": "Authorized Android device/emulator observation (plan only)",
   "purpose": "interoperability",
   "authorization": "Device owner authorization; test device or emulator only.",
   "prerequisites": [
    "adb installed",
    "authorized test device/emulator",
    "backup of app data if needed"
   ],
   "steps": [
    {
     "tool": "adb",
     "command": "adb devices",
     "expected": "Only authorized devices listed",
     "checkpoint": "Serial recorded"
    },
    {
     "tool": "adb",
     "command": "adb -s <serial> shell pm path <package>",
     "expected": "APK paths",
     "checkpoint": "Paths recorded"
    },
    {
     "tool": "adb",
     "command": "adb -s <serial> pull <apk-path> {outdir}/base.apk",
     "expected": "APK copy",
     "checkpoint": "sha256 recorded"
    },
    {
     "tool": "adb",
     "command": "adb -s <serial> logcat -d > {outdir}/logcat.txt",
     "expected": "Recent logs",
     "checkpoint": "Logs preserved"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py parse {outdir}/base.apk --format json",
     "expected": "APK structure, manifest, signatures",
     "checkpoint": "Components and permissions summarized"
    }
   ],
   "limits": "No install/uninstall/state changes without explicit operator approval. Plan only.",
   "verification": "Reopen pulled APK with archive and parse; compare hashes."
  },
  "ghidra-headless": {
   "title": "Ghidra headless cross-check (plan only)",
   "purpose": "research",
   "authorization": "Authorized artifact.",
   "prerequisites": [
    "Ghidra installed",
    "Java runtime"
   ],
   "steps": [
    {
     "tool": "ghidra",
     "command": "analyzeHeadless {outdir}/ghidra-proj retool -import {target} -postScript ExportDisassembly.py -deleteProject",
     "expected": "Independent disassembly/decompilation",
     "checkpoint": "Export saved"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py cfg {target} --arch x64 --format json",
     "expected": "Built-in CFG/pseudocode for comparison",
     "checkpoint": "Differences documented"
    }
   ],
   "limits": "External tool required; this tool only checks availability and emits the plan.",
   "verification": "Compare function boundaries and call edges; explain disagreements."
  },
  "unpacking": {
   "title": "Packed binary investigation (plan only for dynamic part)",
   "purpose": "defensive",
   "authorization": "Authorized artifact; isolated environment for any dynamic step.",
   "prerequisites": [
    "static indicators collected",
    "sandbox with snapshot for dynamic unpacking"
   ],
   "steps": [
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py entropy {target} --format json",
     "expected": "High-entropy regions",
     "checkpoint": "Regions recorded"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py triage {target} --purpose defensive --format json",
     "expected": "Packer/anti-analysis indicators",
     "checkpoint": "Indicators recorded"
    },
    {
     "tool": "operator",
     "command": "# If authorized, run in sandbox and dump memory at the unpacking transition (operator-driven)",
     "expected": "Unpacked image candidate",
     "checkpoint": "Dump hashed and carved"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py carve {outdir}/dump.bin --format json",
     "expected": "Embedded executables/resources",
     "checkpoint": "Carved blobs validated"
    }
   ],
   "limits": "No anti-debug bypass guidance. Dynamic unpacking is operator-driven in isolation.",
   "verification": "Validate carved images with parse/identify; compare imports with the packed original."
  },
  "firmware-extract": {
   "title": "Firmware extraction and triage",
   "purpose": "preservation",
   "authorization": "Device owner authorization.",
   "prerequisites": [
    "optional: binwalk, unsquashfs, jefferson, ubi_reader",
    "fresh output directory"
   ],
   "steps": [
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py identify {target} --format json",
     "expected": "Container/filesystem signatures",
     "checkpoint": "Offsets recorded"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py carve {target} --format json",
     "expected": "Embedded candidates with offsets",
     "checkpoint": "False positives filtered by parse"
    },
    {
     "tool": "binwalk",
     "command": "binwalk -e --directory {outdir} {target}",
     "expected": "Extracted filesystem tree",
     "checkpoint": "Extraction log kept"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py inventory {outdir} --format json",
     "expected": "Extracted inventory",
     "checkpoint": "Hashes recorded"
    }
   ],
   "limits": "Extraction size/depth limits apply. Unknown filesystems require format-specific tools.",
   "verification": "Reopen extracted files; compare sizes/hashes; retain unextractable regions."
  },
  "android-rebuild": {
   "title": "Android package rebuild validation (plan only for device steps)",
   "purpose": "interoperability",
   "authorization": "Authorized app; test device only.",
   "prerequisites": [
    "apktool, uber-apk-signer or apksigner",
    "test device/emulator"
   ],
   "steps": [
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py archive {target} --mode validate --format json",
     "expected": "ZIP safety and integrity report",
     "checkpoint": "Issues recorded"
    },
    {
     "tool": "retool",
     "command": "python3 code-data-reverse-engineering/tools-retool.py archive {target} --mode repack --out {outdir}/repacked.apk --format json",
     "expected": "Deterministic repack",
     "checkpoint": "Entry order and CRCs preserved"
    },
    {
     "tool": "apksigner",
     "command": "apksigner sign --ks <keystore> {outdir}/repacked.apk",
     "expected": "Re-signed package",
     "checkpoint": "Signature verified"
    },
    {
     "tool": "apksigner",
     "command": "apksigner verify --verbose {outdir}/repacked.apk",
     "expected": "Verification result",
     "checkpoint": "Result recorded"
    },
    {
     "tool": "adb",
     "command": "adb -s <serial> install -r {outdir}/repacked.apk",
     "expected": "Install result",
     "checkpoint": "Operator-approved only"
    }
   ],
   "limits": "Signing keys and device operations are operator-supplied and never handled by this tool.",
   "verification": "Reopen repacked APK; compare entry list, CRCs, and manifest."
  },
  "macos-compat": {
   "title": "macOS compatibility investigation (plan only)",
   "purpose": "interoperability",
   "authorization": "Authorized app.",
   "prerequisites": [
