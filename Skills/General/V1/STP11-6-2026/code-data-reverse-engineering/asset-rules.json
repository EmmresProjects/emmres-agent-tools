{"schema": "retool.rules.v1", "note": "Evidence-based detection rules. Each hit reports rule id, severity, line/offset, and a short defensive message. Patterns are Python regular expressions applied per line unless noted. Secrets findings are redacted by default.", "code": [{"id": "py-eval-exec", "lang": ["python"], "pattern": "\\b(eval|exec)\\s*\\(", "severity": "high", "message": "Dynamic code execution on possibly untrusted input; prefer ast.literal_eval or explicit dispatch."}, {"id": "py-pickle-load", "lang": ["python"], "pattern": "\\b(pickle\\.load|pickle\\.loads|cPickle\\.load|shelve\\.open|joblib\\.load|torch\\.load)\\s*\\(", "severity": "high", "message": "Deserialization can execute code; use safe formats or restricted loaders for untrusted data."}, {"id": "py-yaml-load", "lang": ["python"], "pattern": "\\byaml\\.load\\s*\\((?![^)]*SafeLoader)", "severity": "medium", "message": "yaml.load without SafeLoader can instantiate arbitrary objects; use yaml.safe_load."}, {"id": "py-subprocess-shell", "lang": ["python"], "pattern": "subprocess\\.[A-Za-z_]+\\([^)]*shell\\s*=\\s*True", "severity": "high", "message": "shell=True enables injection; pass argument lists and validate inputs."}, {"id": "py-os-system", "lang": ["python"], "pattern": "\\bos\\.(system|popen)\\s*\\(", "severity": "medium", "message": "Shell invocation; prefer subprocess with argument lists."}, {"id": "py-weak-hash", "lang": ["python", "java", "javascript", "csharp", "go", "rust", "php"], "pattern": "\\b(md5|MD5|sha1|SHA1|DES|RC4)\\b", "severity": "low", "message": "Legacy hash/cipher; acceptable for checksums only, not for security. Verify context."}, {"id": "py-ecb-mode", "lang": ["python", "java", "csharp"], "pattern": "MODE_ECB|/ECB/|Cipher\\.getInstance\\(\\s*\"[^\"]*ECB", "severity": "medium", "message": "ECB mode leaks structure; prefer authenticated encryption (GCM/ChaCha20-Poly1305)."}, {"id": "py-ssl-verify-off", "lang": ["python"], "pattern": "verify\\s*=\\s*False|_create_unverified_context|CERT_NONE", "severity": "high", "message": "TLS verification disabled; vulnerable to interception."}, {"id": "c-unsafe-funcs", "lang": ["c", "cpp", "objc"], "pattern": "\\b(strcpy|strcat|sprintf|vsprintf|gets|scanf)\\s*\\(", "severity": "high", "message": "Unbounded memory operation; use bounded variants and length checks."}, {"id": "c-memcpy-var", "lang": ["c", "cpp"], "pattern": "\\bmemcpy\\s*\\([^,]+,[^,]+,\\s*[a-z_][A-Za-z0-9_]*\\s*\\)", "severity": "medium", "message": "memcpy with variable length; verify bounds against destination capacity."}, {"id": "c-system", "lang": ["c", "cpp"], "pattern": "\\b(system|popen|execlp|execvp)\\s*\\(", "severity": "medium", "message": "Process/shell execution; validate arguments and avoid attacker-controlled strings."}, {"id": "js-eval", "lang": ["javascript", "typescript"], "pattern": "\\beval\\s*\\(|new\\s+Function\\s*\\(|setTimeout\\s*\\(\\s*[\"'`]", "severity": "high", "message": "Dynamic code execution from strings; avoid or strictly validate."}, {"id": "js-innerhtml", "lang": ["javascript", "typescript"], "pattern": "\\.innerHTML\\s*=|document\\.write\\s*\\(|dangerouslySetInnerHTML", "severity": "medium", "message": "HTML injection surface; sanitize or use textContent."}, {"id": "js-childproc", "lang": ["javascript", "typescript"], "pattern": "child_process\\.(exec|execSync|spawn)\\s*\\(", "severity": "medium", "message": "Command execution; validate arguments, prefer execFile with lists."}, {"id": "sql-string-concat", "lang": ["python", "java", "javascript", "csharp", "php", "go", "ruby"], "pattern": "(SELECT|INSERT|UPDATE|DELETE)[^;\"']*(\"\\s*\\+|'\\s*\\.|f\"|f'|\\$\\{|%s?\"\\s*%)", "severity": "high", "message": "SQL built by concatenation/interpolation; use parameterized queries."}, {"id": "java-deserialize", "lang": ["java"], "pattern": "ObjectInputStream|readObject\\s*\\(|XMLDecoder", "severity": "high", "message": "Java deserialization of untrusted data can execute code; use allowlists or safe formats."}, {"id": "java-xxe", "lang": ["java"], "pattern": "DocumentBuilderFactory|SAXParserFactory|XMLInputFactory", "severity": "medium", "message": "XML parser; confirm external entities and DTDs are disabled (XXE)."}, {"id": "cs-binaryformatter", "lang": ["csharp"], "pattern": "BinaryFormatter|NetDataContractSerializer|LosFormatter|ObjectStateFormatter|SoapFormatter", "severity": "high", "message": "Unsafe .NET deserializers; use System.Text.Json or typed contracts."}, {"id": "go-sql-concat", "lang": ["go"], "pattern": "fmt\\.Sprintf\\(\\s*\"(SELECT|INSERT|UPDATE|DELETE)", "severity": "high", "message": "SQL via Sprintf; use database/sql placeholders."}, {"id": "rust-unsafe", "lang": ["rust"], "pattern": "\\bunsafe\\s*\\{", "severity": "info", "message": "unsafe block; document invariants and audit pointer/FFI boundaries."}, {"id": "hardcoded-secret-assign", "lang": ["*"], "pattern": "(?i)(password|passwd|secret|api[_-]?key|token|private[_-]?key)\\s*[:=]\\s*[\"'][^\"']{8,}[\"']", "severity": "high", "message": "Possible hardcoded credential; move to a secret store and rotate."}, {"id": "debug-endpoint", "lang": ["*"], "pattern": "(?i)(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0):(\\d{2,5})/(debug|admin|actuator|console)", "severity": "medium", "message": "Debug/admin endpoint reference; confirm it is not exposed in production."}, {"id": "todo-fixme-security", "lang": ["*"], "pattern": "(?i)(TODO|FIXME|HACK|XXX).{0,40}(security|auth|vuln|unsafe|password|token)", "severity": "info", "message": "Security-related work marker; review before release."}], "secrets": [{"id": "aws-access-key", "pattern": "\\b(AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b", "severity": "high", "message": "AWS access key id."}, {"id": "aws-secret-key", "pattern": "(?i)aws(.{0,20})?(secret|sk)['\"]?\\s*[:=]\\s*['\"]?[A-Za-z0-9/+=]{40}", "severity": "high", "message": "Possible AWS secret access key."}, {"id": "github-token", "pattern": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{22,}\\b", "severity": "high", "message": "GitHub token."}, {"id": "gitlab-token", "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b", "severity": "high", "message": "GitLab personal access token."}, {"id": "slack-token", "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b", "severity": "high", "message": "Slack token."}, {"id": "stripe-key", "pattern": "\\b(sk|rk)_(live|test)_[A-Za-z0-9]{16,}\\b", "severity": "high", "message": "Stripe secret/restricted key."}, {"id": "google-api-key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "severity": "high", "message": "Google API key."}, {"id": "openai-key", "pattern": "\\bsk-[A-Za-z0-9_-]{20,}\\b", "severity": "high", "message": "Possible OpenAI-style API key."}, {"id": "private-key-block", "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----", "severity": "critical", "message": "Private key material."}, {"id": "jwt", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b", "severity": "medium", "message": "JSON Web Token; decode header/payload for review, never treat as verified."}, {"id": "basic-auth-url", "pattern": "[a-z][a-z0-9+.-]*://[^/\\s:@]+:[^/\\s:@]+@", "severity": "high", "message": "Credentials embedded in URL."}, {"id": "generic-assignment", "pattern": "(?i)\\b(password|passwd|pwd|secret|client_secret|api[_-]?key|access[_-]?token|auth[_-]?token)\\b\\s*[:=]\\s*['\"]?[A-Za-z0-9_./+=-]{8,}", "severity": "medium", "message": "Possible credential assignment; verify context."}, {"id": "connection-string", "pattern": "(?i)(mysql|postgres|postgresql|mongodb|redis|amqp|mssql|sqlserver)://[^\\s\"']+", "severity": "medium", "message": "Database/service connection string; may contain credentials."}, {"id": "azure-storage-key", "pattern": "(?i)AccountKey=[A-Za-z0-9+/=]{40,}", "severity": "high", "message": "Azure storage account key."}, {"id": "sendgrid-key", "pattern": "\\bSG\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\b", "severity": "high", "message": "SendGrid API key."}, {"id": "twilio-key", "pattern": "\\bSK[0-9a-fA-F]{32}\\b", "severity": "medium", "message": "Possible Twilio API key SID."}, {"id": "npm-token", "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b", "severity": "high", "message": "npm access token."}, {"id": "pypi-token", "pattern": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}\\b", "severity": "high", "message": "PyPI API token."}], "shell": [{"id": "sh-unquoted-var", "pattern": "(?<!['\"])\\$[A-Za-z_][A-Za-z0-9_]*(?!['\"])", "severity": "low", "message": "Unquoted variable expansion; quote to prevent word splitting/globbing."}, {"id": "sh-no-strict", "pattern": "^\\s*#!.*(ba)?sh", "severity": "info", "message": "Check for 'set -euo pipefail' (bash) or explicit error handling (POSIX sh).", "invert": true}, {"id": "sh-rm-rf-var", "pattern": "rm\\s+-[a-z]*r[a-z]*f[a-z]*\\s+[\"']?\\$", "severity": "high", "message": "Recursive forced delete on a variable path; validate and guard the target."}, {"id": "sh-eval", "pattern": "\\beval\\b", "severity": "medium", "message": "eval executes constructed strings; avoid or strictly validate."}, {"id": "sh-curl-pipe-sh", "pattern": "(curl|wget)[^|]*\\|\\s*(ba)?sh", "severity": "high", "message": "Piping downloaded content to a shell; pin, verify checksum, then execute."}, {"id": "sh-mktemp-missing", "pattern": ">/tmp/[A-Za-z0-9_.-]+", "severity": "medium", "message": "Predictable temp file; use mktemp."}, {"id": "sh-cd-no-check", "pattern": "^\\s*cd\\s+[^;|&]+$(?![^\\n]*\\|\\|)", "severity": "low", "message": "cd without error check can run subsequent commands in the wrong directory."}], "docker": [{"id": "dk-latest", "pattern": "^\\s*FROM\\s+\\S+:latest\\b|^\\s*FROM\\s+(?!scratch\\b)[^:\\s]+\\s*$", "severity": "medium", "message": "Unpinned base image; pin a digest for reproducibility."}, {"id": "dk-root-user", "pattern": "^\\s*USER\\s+root\\b", "severity": "medium", "message": "Running as root; use a non-root USER."}, {"id": "dk-add-url", "pattern": "^\\s*ADD\\s+https?://", "severity": "medium", "message": "ADD from URL without checksum; prefer COPY plus verified download."}, {"id": "dk-curl-bash", "pattern": "(curl|wget)[^|]*\\|\\s*(ba)?sh", "severity": "high", "message": "Unverified remote script execution in build."}, {"id": "dk-secret-arg", "pattern": "^\\s*(ARG|ENV)\\s+\\S*(PASSWORD|SECRET|TOKEN|KEY)\\b", "severity": "high", "message": "Secret in ARG/ENV persists in image layers; use build secrets."}, {"id": "dk-apt-no-clean", "pattern": "apt-get\\s+install(?![^\\n]*rm\\s+-rf\\s+/var/lib/apt/lists)", "severity": "low", "message": "apt lists not cleaned in the same layer; increases image size."}], "ci": [{"id": "ci-pull-request-target", "pattern": "pull_request_target", "severity": "high", "message": "pull_request_target runs with base privileges on fork PRs; never check out and run untrusted PR code."}, {"id": "ci-write-all", "pattern": "permissions:\\s*write-all", "severity": "high", "message": "Overly broad token permissions; use least privilege per job."}, {"id": "ci-script-injection", "pattern": "\\$\\{\\{\\s*github\\.event\\.(issue|pull_request|comment|review)", "severity": "high", "message": "Untrusted event text interpolated into run/script; pass via env and quote."}, {"id": "ci-unpinned-action", "pattern": "uses:\\s*[^@\\s]+@(main|master|v\\d+)\\s*$", "severity": "medium", "message": "Action pinned to a branch/major tag; pin a full commit SHA."}, {"id": "ci-secrets-echo", "pattern": "echo\\s+.*\\$\\{\\{\\s*secrets\\.", "severity": "high", "message": "Secret echoed to logs."}, {"id": "ci-curl-bash", "pattern": "(curl|wget)[^|]*\\|\\s*(ba)?sh", "severity": "high", "message": "Unverified remote script in pipeline."}], "iac": [{"id": "tf-open-cidr", "pattern": "0\\.0\\.0\\.0/0", "severity": "medium", "message": "World-open CIDR; confirm intent and restrict where possible."}, {"id": "tf-hardcoded-secret", "pattern": "(?i)(password|secret|token)\\s*=\\s*\"[^\"]{8,}\"", "severity": "high", "message": "Hardcoded secret in IaC; use a secret manager."}, {"id": "tf-state-risk", "pattern": "backend\\s+\"local\"", "severity": "medium", "message": "Local state lacks locking/encryption; consider a remote backend with locking."}, {"id": "tf-destroy-provisioner", "pattern": "provisioner\\s+\"(local|remote)-exec\"", "severity": "medium", "message": "Exec provisioners are fragile and non-idempotent; prefer native resources."}, {"id": "ans-shell", "pattern": "^\\s*(shell|command|raw):", "severity": "low", "message": "Shell/command task; ensure creates/removes guards for idempotence."}, {"id": "ans-no-log-false", "pattern": "no_log:\\s*false", "severity": "medium", "message": "Sensitive task logging enabled; set no_log: true for secret handling."}, {"id": "ans-ignore-errors", "pattern": "ignore_errors:\\s*(true|yes)", "severity": "medium", "message": "Errors ignored; failures may be silently skipped."}], "documents": [{"id": "pdf-javascript", "pattern": "/JavaScript|/JS\\b", "severity": "high", "message": "PDF contains JavaScript; review actions and embedded code."}, {"id": "pdf-openaction", "pattern": "/OpenAction|/AA\\b", "severity": "medium", "message": "Automatic action on open/additional actions."}, {"id": "pdf-embedded-file", "pattern": "/EmbeddedFile|/Filespec|/EmbeddedFiles", "severity": "medium", "message": "Embedded file attachment; extract and triage separately."}, {"id": "pdf-launch", "pattern": "/Launch|/SubmitForm|/GoToR|/URI", "severity": "medium", "message": "External launch/URI action; review destinations."}, {"id": "pdf-objstm", "pattern": "/ObjStm", "severity": "info", "message": "Object streams present; some scanners miss content inside them."}, {"id": "ole-vba", "pattern": "VBA|_VBA_PROJECT|ThisDocument|Macros", "severity": "high", "message": "VBA macro storage present in compound document."}, {"id": "ooxml-macro", "pattern": "vbaProject\\.bin|xl/macrosheets|word/vbaData\\.xml", "severity": "high", "message": "Macro part inside OOXML package."}, {"id": "script-wscript", "pattern": "WScript\\.|CreateObject\\(|ActiveXObject|Shell\\.Application|powershell|cmd\\.exe", "severity": "high", "message": "Scripting host/COM/process launch indicators."}, {"id": "script-encoded-ps", "pattern": "(?i)-(enc|encodedcommand|e)\\s+[A-Za-z0-9+/=]{40,}", "severity": "high", "message": "Encoded PowerShell command; decode for review only."}, {"id": "script-download", "pattern": "(?i)(DownloadString|DownloadFile|Invoke-WebRequest|Invoke-RestMethod|URLDownloadToFile|MSXML2\\.XMLHTTP|WinHttp)", "severity": "medium", "message": "Network download capability in script/document."}], "persistence": [{"id": "persist-run-key", "pattern": "(?i)(CurrentVersion\\\\Run|CurrentVersion/Run|RunOnce|StartupApproved)", "severity": "high", "message": "Autorun registry path reference."}, {"id": "persist-service", "pattern": "(?i)(CreateService|sc\\.exe\\s+create|New-Service|systemctl\\s+enable|LaunchAgents|LaunchDaemons)", "severity": "medium", "message": "Service/launch persistence indicator."}, {"id": "persist-scheduled", "pattern": "(?i)(schtasks|Register-ScheduledTask|crontab|/etc/cron)", "severity": "medium", "message": "Scheduled task/cron persistence indicator."}, {"id": "persist-wmi", "pattern": "(?i)(Win32_ActiveScriptConsumer|__EventFilter|CommandLineEventConsumer)", "severity": "high", "message": "WMI event subscription persistence indicator."}, {"id": "persist-lnk-startup", "pattern": "(?i)(Startup\\\\|Start Menu\\\\Programs\\\\Startup|\\.lnk)", "severity": "low", "message": "Startup folder / shortcut reference."}], "anti_analysis": [{"id": "anti-debug-api", "pattern": "IsDebuggerPresent|CheckRemoteDebuggerPresent|NtQueryInformationProcess|OutputDebugString|ZwQueryInformationProcess|ptrace|PTRACE_TRACEME|sysctl.*P_TRACED", "severity": "medium", "message": "Debugger detection indicator (report only)."}, {"id": "anti-vm-strings", "pattern": "(?i)(VMware|VirtualBox|VBOX|QEMU|Xen|Sandboxie|Cuckoo|VIRTUAL\\s*HD|vboxservice|vmtoolsd)", "severity": "low", "message": "Virtualization/sandbox artifact string (report only)."}, {"id": "anti-timing", "pattern": "QueryPerformanceCounter|GetTickCount|rdtsc|clock_gettime|timeGetTime", "severity": "info", "message": "Timing API; may be used for timing checks (context needed)."}, {"id": "anti-selfmod", "pattern": "(?i)(VirtualProtect|VirtualAlloc|WriteProcessMemory|NtProtectVirtualMemory|mprotect|MAP_JIT)", "severity": "medium", "message": "Memory permission change / self-modification capability."}, {"id": "anti-exception", "pattern": "(?i)(SetUnhandledExceptionFilter|AddVectoredExceptionHandler|EXCEPTION_BREAKPOINT|INT\\s*3|ud2)", "severity": "info", "message": "Exception-based control flow indicator."}], "packers": [{"id": "pack-upx", "pattern": "UPX[0-9!]|UPX0|UPX1", "severity": "info", "message": "UPX packer markers."}, {"id": "pack-aspack", "pattern": "ASPack|aspack", "severity": "info", "message": "ASPack markers."}, {"id": "pack-mpress", "pattern": "MPRESS|mpress", "severity": "info", "message": "MPRESS markers."}, {"id": "pack-themida", "pattern": "Themida|WinLicense|VMProtect|\\.vmp0|\\.vmp1", "severity": "medium", "message": "Commercial protector markers."}, {"id": "pack-enigma", "pattern": "Enigma protector|\\.enigma1|\\.enigma2", "severity": "medium", "message": "Enigma protector markers."}, {"id": "pack-petite", "pattern": "Petite|\\.petite", "severity": "info", "message": "Petite packer markers."}, {"id": "pack-nspack", "pattern": "NsPack|nspack|\\.nsp0|\\.nsp1", "severity": "info", "message": "NsPack markers."}, {"id": "pack-generic", "pattern": "(?i)packed by|packer|compressor|protect", "severity": "info", "message": "Generic packing/protection wording; confirm with entropy and sections."}], "crypto_api": [{"id": "crypto-aes", "pattern": "\\b(AES|AES_|EVP_aes|CryptEncrypt|BCryptEncrypt|CCCrypt|Cipher\\.getInstance)\\b", "severity": "info", "message": "Symmetric encryption API usage."}, {"id": "crypto-rsa", "pattern": "\\b(RSA|RSA_|EVP_PKEY_RSA|RSACryptoServiceProvider)\\b", "severity": "info", "message": "RSA usage."}, {"id": "crypto-ecc", "pattern": "\\b(ECDSA|ECDH|secp256r1|secp256k1|curve25519|Ed25519|NIST P-256)\\b", "severity": "info", "message": "Elliptic-curve usage."}, {"id": "crypto-chacha", "pattern": "ChaCha|chacha20|Salsa20", "severity": "info", "message": "ChaCha/Salsa stream cipher usage."}, {"id": "crypto-kdf", "pattern": "(?i)(PBKDF2|bcrypt|scrypt|argon2|HKDF|CryptDeriveKey)", "severity": "info", "message": "Key derivation usage."}, {"id": "crypto-random", "pattern": "(?i)(rand\\(\\)|Math\\.random|Random\\(\\)|mt19937|srand\\()", "severity": "medium", "message": "Non-cryptographic randomness; confirm it is not used for keys/tokens."}, {"id": "crypto-const", "pattern": "(?i)(0x67452301|0xefcdab89|0x98badcfe|0x10325476|0x6a09e667|0xbb67ae85)", "severity": "info", "message": "Hash/cipher initialization constant (MD5/SHA family)."}], "suspicious_imports": {"network": ["socket", "connect", "WSAStartup", "InternetOpen", "InternetOpenUrl", "HttpSendRequest", "WinHttpOpen", "URLDownloadToFile", "send", "recv", "getaddrinfo", "curl_easy_perform"], "process": ["CreateProcess", "WinExec", "ShellExecute", "system", "popen", "fork", "execve", "posix_spawn", "NtCreateProcess"], "injection": ["VirtualAllocEx", "WriteProcessMemory", "CreateRemoteThread", "NtMapViewOfSection", "QueueUserAPC", "SetWindowsHookEx", "LoadLibrary", "GetProcAddress", "dlopen", "dlsym"], "filesystem": ["CreateFile", "WriteFile", "DeleteFile", "MoveFile", "CopyFile", "FindFirstFile", "fopen", "fwrite", "unlink", "rename"], "registry": ["RegOpenKey", "RegSetValue", "RegCreateKey", "RegQueryValue"], "crypto": ["CryptEncrypt", "CryptDecrypt", "BCryptEncrypt", "EVP_EncryptInit", "CCCrypt"], "anti_debug": ["IsDebuggerPresent", "CheckRemoteDebuggerPresent", "NtQueryInformationProcess", "ptrace", "OutputDebugString"]}}