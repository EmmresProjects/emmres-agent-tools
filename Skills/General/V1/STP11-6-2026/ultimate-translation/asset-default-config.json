{
  "version": 1,
  "limits": {
    "max_input_bytes": 52428800,
    "max_output_bytes": 104857600,
    "max_segments": 50000,
    "max_segment_chars": 12000,
    "batch_segments": 12,
    "batch_chars": 18000,
    "context_chars": 3000,
    "http_timeout_seconds": 45,
    "http_retries": 3,
    "http_response_bytes": 4194304,
    "retry_backoff_seconds": 1.0,
    "checkpoint_every_batches": 1,
    "max_audio_chunks": 500,
    "max_repository_files": 5000
  },
  "provider": {
    "name": "glossary",
    "model_env": "ULTIMATE_TRANSLATION_MODEL",
    "endpoint_env": "ULTIMATE_TRANSLATION_ENDPOINT",
    "api_key_env": "ULTIMATE_TRANSLATION_API_KEY",
    "organization_env": "ULTIMATE_TRANSLATION_ORGANIZATION",
    "extra_headers": {},
    "request_options": {}
  },
  "translation": {
    "formality": "natural",
    "preserve_tokens": true,
    "allow_network": false,
    "review_confidence_below": 0.8,
    "require_human_review_domains": ["legal", "medical", "pharmaceutical", "financial", "safety", "patent"],
    "prohibited_claims": [],
    "parallel_examples": []
  },
  "subtitles": {
    "max_chars_per_line": 42,
    "max_lines": 2,
    "max_cps": 20,
    "min_duration_seconds": 0.8,
    "max_duration_seconds": 7.0
  },
  "review": {
    "sample_rate": 0.1,
    "high_risk_sample_rate": 1.0,
    "defect_escalation_threshold": 0.05,
    "seed": 417
  },
  "pdf": {
    "font_path": null,
    "font_size": 11
  },
  "output": {
    "atomic": true,
    "report_suffix": ".report.json",
    "checkpoint_suffix": ".checkpoint.json"
  }
}
