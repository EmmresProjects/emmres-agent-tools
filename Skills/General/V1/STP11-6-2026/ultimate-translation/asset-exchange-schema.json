{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultimate Translation Exchange Package",
  "type": "object",
  "required": ["version", "source_fingerprint", "source_locale", "target_locale", "kind", "segments"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "source_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
    "source_locale": {"type": "string", "minLength": 2},
    "target_locale": {"type": "string", "minLength": 2},
    "kind": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "context", "metadata"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "context": {"type": "string"},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
