{
  "schema_id": "ugm-brief-schema-1.0",
  "description": "Minimal custom schema implemented by tools-validation.py; no external validator is required.",
  "type": "object",
  "required": [
    "goal",
    "genre",
    "engine",
    "language",
    "target_platform",
    "acceptance_criteria"
  ],
  "additionalProperties": true,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "genre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "engine": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "language_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "target_platform": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source": {
            "type": "string",
            "maxLength": 200
          },
          "license": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "repository": {
      "type": "string",
      "maxLength": 200
    },
    "build_environment": {
      "type": "object",
      "additionalProperties": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": true
    },
    "categories": {
      "type": "array",
      "maxItems": 33,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 330,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "version_notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "quality": {
      "type": "string",
      "enum": [
        "prototype",
        "vertical-slice",
        "production"
      ]
    },
    "performance_budget": {
      "type": "object",
      "additionalProperties": true
    },
    "accessibility": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "approval_gates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  }
}
