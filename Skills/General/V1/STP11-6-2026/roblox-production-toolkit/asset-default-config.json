{
  "schema_version": 1,
  "output_root": "roblox-output",
  "limits": {
    "input_bytes": 8388608,
    "source_bytes": 2097152,
    "timeout_seconds": 30,
    "max_timeout_seconds": 300,
    "batch_capabilities": 340,
    "output_files": 400,
    "output_bytes": 33554432,
    "simulation_steps": 10000,
    "http_response_bytes": 2097152,
    "batch_output_files": 1000,
    "cloud_response_bytes": 2097152,
    "cloud_retries": 2
  },
  "runtime": {
    "python_minimum": "3.10",
    "luau_checker": null,
    "provider": "local-deterministic",
    "model": null,
    "prompt_policy": "asset-policy.json"
  },
  "network": {
    "enabled": false,
    "allowed_hosts": [
      "apis.roblox.com"
    ],
    "allowed_operations": [],
    "api_key_env": "ROBLOX_OPEN_CLOUD_API_KEY",
    "auth_header": "x-api-key",
    "auth_prefix": "",
    "timeout_seconds": 15,
    "retries": 2,
    "backoff_seconds": 0.5,
    "max_retry_wait_seconds": 8,
    "allow_http": false,
    "max_upload_bytes": 104857600
  },
  "policy": {
    "require_approval_for_network": true,
    "require_approval_for_overwrite": true,
    "allow_arbitrary_code_execution": false,
    "allow_shell_execution": false,
    "live_service_default": "dry-run",
    "publishing_version_type": "Saved",
    "external_spec_required": true
  },
  "studio": {
    "collision_groups": [
      "Default",
      "Characters",
      "Projectiles",
      "Environment",
      "Debris"
    ],
    "tags": [
      "Interactive",
      "Hazard",
      "Checkpoint",
      "StreamingRegion"
    ],
    "streaming_enabled": true,
    "workspace_filtering_enabled": true,
    "part_size_min": 0.05,
    "part_size_max": 2048,
    "luau_script_chars": 200000
  },
  "paths": {
    "catalog": "roblox-production-toolkit/asset-catalog.json",
    "recipes": "roblox-production-toolkit/asset-recipes.json",
    "policy": "roblox-production-toolkit/asset-policy.json",
    "luau_runtime": "roblox-production-toolkit/asset-luau-runtime.luau",
    "place_templates": "roblox-production-toolkit/asset-place-templates.json",
    "ui_tokens": "roblox-production-toolkit/asset-ui-tokens.json",
    "avatar_rules": "roblox-production-toolkit/asset-avatar-rules.json",
    "request_schema": "roblox-production-toolkit/asset-request-schema.json",
    "openapi_example": "roblox-production-toolkit/asset-openapi-example.json"
  }
}
