{
  "version": "1.0.0",
  "comment": "Default runtime configuration for the image-creation-editing Skill Tool. Copy, edit, and pass with --config to override any branch.",
  "paths": {
    "output_dir": "output",
    "library_dir": "library",
    "work_dir": "work"
  },
  "limits": {
    "max_input_bytes": 104857600,
    "max_pixels": 80000000,
    "max_output_dimension": 8192,
    "max_batch_items": 500,
    "max_frames": 240,
    "default_timeout_s": 300,
    "max_retries": 3,
    "max_workers": 4,
    "max_text_chars": 20000
  },
  "naming": {
    "pattern": "{project}-{content}-{variant}-{dimensions}-v{version}-{status}",
    "separator": "-",
    "max_length": 96
  },
  "formats": {
    "preferred_master": "png",
    "web": "webp",
    "print": "tiff",
    "social": "jpg",
    "transparency": "png",
    "dpi_presets": {
      "web": 72,
      "screen-retina": 144,
      "social": 72,
      "print": 300,
      "large-format": 150,
      "archive": 300
    }
  },
  "typography": {
    "env_override": "IMAGEKIT_FONT",
    "note": "Fonts are discovered from standard OS font directories. Set IMAGEKIT_FONT to a .ttf/.otf path to force a specific face.",
    "default_heading_serif": false,
    "default_body_serif": false
  },
  "render": {
    "default_size": [1024, 1024],
    "grain": 0.035,
    "vignette": 0.28,
    "quality": 92
  },
  "quality": {
    "policy_file": "asset-quality-policy.json",
    "fail_on": "error",
    "auto_retry_on_fail": 1
  },
  "safety": {
    "policy_file": "asset-quality-policy.json",
    "enforce_text_scan": true,
    "disclosure_default": true,
    "approval_gated_operations": [
      "library.dedupe.apply",
      "library.rename.apply",
      "handoff.publish",
      "provider.generate",
      "convert.overwrite",
      "safety.consent"
    ]
  },
  "providers": {
    "active": null,
    "allow_network": false,
    "require_approval": true,
    "default_timeout_s": 120,
    "default_retries": 2,
    "list": {
      "mock-local": {
        "kind": "mock",
        "description": "Offline provider used to exercise the adapter contract in tests. Not a model.",
        "enabled": true
      },
      "generic-http-image": {
        "kind": "http",
        "description": "Template adapter for any JSON image API. Disabled until you fill endpoint and env var names.",
        "enabled": false,
        "endpoint": "",
        "method": "POST",
        "auth_env": "",
        "extra_headers_env": {},
        "request_template": {
          "prompt": "{{prompt}}",
          "width": "{{width}}",
          "height": "{{height}}",
          "seed": "{{seed}}"
        },
        "response_image_base64_pointer": "/data/0/b64_json",
        "response_image_url_pointer": "/data/0/url",
        "timeout_s": 120,
        "retries": 2,
        "max_response_bytes": 41943040
      }
    }
  },
  "pipeline": {
    "checkpoint": true,
    "continue_on_error": false,
    "state_file": "pipeline-state.json"
  },
  "catalog_file": "asset-skill-catalog.json",
  "quality_policy_file": "asset-quality-policy.json",
  "render_presets_file": "asset-render-presets.json",
  "brief_template_file": "asset-brief-template.json"
}
