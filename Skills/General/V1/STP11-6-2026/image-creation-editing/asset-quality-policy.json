{
  "version": "1.0.0",
  "comment": "Single policy source for safety screening, approval gating, disclosure text and QA gates. Consumed by tools-imagekit-core.py (scan_text/enforce_policy) and tools-imagekit-qa.py (gate).",
  "severity_scale": ["block", "approval", "disclose", "review", "info"],
  "text_rules": [
    {
      "id": "csae",
      "category": "child-safety",
      "severity": "block",
      "action": "refuse",
      "message": "Any request sexualising, exposing or endangering minors is refused without exception.",
      "gates": ["child-safety"],
      "terms": [
        "nude child", "naked child", "child nude", "child porn", "csam", "underage nude",
        "sexualized minor", "sexualised minor", "lolicon", "shotacon", "minor in bikini",
        "nude teen", "naked teen", "nude minor", "nude schoolgirl", "nude schoolboy"
      ]
    },
    {
      "id": "nonconsensual-intimate",
      "category": "privacy-intimate",
      "severity": "block",
      "action": "refuse",
      "message": "Non-consensual intimate imagery and undressing/body-swap edits of real people are refused.",
      "gates": ["consent", "privacy"],
      "terms": [
        "nudify", "nude filter", "undress her", "undress him", "remove her clothes", "remove his clothes",
        "deepnude", "revenge porn", "nonconsensual nude", "non-consensual nude", "fake nude",
        "make her naked", "make him naked", "strip the person"
      ]
    },
    {
      "id": "minors-general",
      "category": "child-safety",
      "severity": "approval",
      "action": "approve",
      "message": "Imagery of minors requires an explicit safeguarding review and a documented legitimate purpose.",
      "gates": ["child-safety"],
      "terms": ["child", "children", "toddler", "infant", "teenager", "teen", "minor", "schoolkid", "kids"]
    },
    {
      "id": "real-person-likeness",
      "category": "likeness",
      "severity": "approval",
      "action": "approve",
      "message": "Edits that reproduce or replace a real, identifiable person need documented consent.",
      "gates": ["consent", "likeness"],
      "terms": [
        "face swap", "faceswap", "deepfake", "deep fake", "make me look like", "put my face",
        "put her face", "put his face", "impersonate", "lookalike of", "same face as",
        "digital twin of", "clone of the actor", "clone of the celebrity", "celebrity", "politician",
        "public figure", "real person", "passport photo of"
      ]
    },
    {
      "id": "deceptive-context",
      "category": "deception",
      "severity": "approval",
      "action": "approve",
      "message": "Realistic depictions of real events, evidence, or endorsements carry deception risk and need review plus disclosure.",
      "gates": ["deception", "disclosure"],
      "terms": [
        "fake news photo", "fake evidence", "fake screenshot", "forged document", "photoshop the receipt",
        "endorsement by", "product claim", "before and after proof", "prove that it happened",
        "fabricate the event", "fake protest", "fake accident", "fake crime scene", "fake medical scan",
        "fake x-ray", "false document", "counterfeit", "fake id", "fake passport", "fake currency"
      ]
    },
    {
      "id": "trademark-risk",
      "category": "trademark",
      "severity": "review",
      "action": "review",
      "message": "Requests that reproduce protected marks, characters or trade dress need a rights check before delivery.",
      "gates": ["rights", "trademark"],
      "terms": [
        "disney", "mickey mouse", "marvel", "pokemon", "nintendo", "star wars", "harry potter",
        "coca-cola logo", "nike swoosh", "apple logo", "gucci", "louis vuitton", "hello kitty",
        "batman", "superman", "spider-man", "spiderman", "mario", "sonic the hedgehog", "minecraft",
        "lego", "barbie", "taylor swift", "messi", "ronaldo"
      ]
    },
    {
      "id": "style-attribution",
      "category": "style-rights",
      "severity": "review",
      "action": "review",
      "message": "Named-artist style requests are converted to descriptive style language; attributing work to a living artist is not supported.",
      "gates": ["rights"],
      "terms": ["in the style of", "style of a living artist", "copy the style of", "exactly like the artist"]
    },
    {
      "id": "graphic-violence",
      "category": "harm",
      "severity": "review",
      "action": "review",
      "message": "Graphic injury, gore or cruelty content needs editorial justification and audience review.",
      "gates": ["harm-review"],
      "terms": ["gore", "dismember", "mutilat", "torture", "beheading", "graphic injury", "animal cruelty", "execution scene"]
    },
    {
      "id": "medical-private",
      "category": "sensitive-context",
      "severity": "review",
      "action": "review",
      "message": "Medical, disaster, conflict and private-context imagery needs privacy review and careful framing.",
      "gates": ["privacy", "sensitive-context"],
      "terms": ["patient photo", "medical record", "diagnosis photo", "war casualty", "mass casualty", "disaster victim", "refugee child", "crime victim", "autopsy"]
    },
    {
      "id": "synthetic-disclosure",
      "category": "synthesis",
      "severity": "disclose",
      "action": "disclose",
      "message": "Synthetic or materially altered imagery must carry an authenticity disclosure.",
      "gates": ["disclosure"],
      "terms": ["photorealistic", "photo-real", "hyperrealistic", "lifelike", "indistinguishable from a photo", "as a real photo", "documentary photo", "news photo"]
    }
  ],
  "disclosures": {
    "synthesis": "Synthetic image generated with AI assistance; not a photograph of a real event or person.",
    "deception": "Illustrative composite created for internal review; not evidence of a real event.",
    "likeness": "Likeness used with documented consent of the depicted person.",
    "style-rights": "Style described descriptively; no attribution to, or endorsement by, any artist is implied."
  },
  "approval_rules": [
    {
      "id": "destructive-file-ops",
      "applies_to": ["library.dedupe.apply", "library.rename.apply", "convert.overwrite"],
      "reason": "Renames, moves or deletions change delivered files and are hard to reverse.",
      "requires": ["dry-run reviewed", "backup location confirmed"]
    },
    {
      "id": "external-provider",
      "applies_to": ["provider.generate"],
      "reason": "Sends prompts and references to a third-party service that may bill and log requests.",
      "requires": ["provider credentials present in environment", "data handling reviewed"]
    },
    {
      "id": "publish",
      "applies_to": ["handoff.publish"],
      "reason": "Publishing or transmitting assets outside the workspace is irreversible.",
      "requires": ["rights cleared", "disclosures attached", "QA gates passed"]
    },
    {
      "id": "consent",
      "applies_to": ["safety.consent", "identity-edit"],
      "reason": "Identity-sensitive edits require documented consent for the depicted person.",
      "requires": ["consent reference recorded", "audience and distribution scope reviewed"]
    }
  ],
  "qa": {
    "resolution": {"min_dimension": 256, "min_effective_dpi": 72, "max_aspect_drift": 0.01},
    "sharpness": {"min_laplacian_variance": 18.0, "max_blur_ratio": 0.92},
    "contrast": {"min_rms": 18.0, "max_rms": 92.0},
    "clipping": {"max_black_clip_pct": 8.0, "max_white_clip_pct": 6.0},
    "banding": {"max_gap_ratio": 0.35},
    "color": {"max_cast_delta": 26.0, "max_saturation_mean": 0.86},
    "noise": {"max_highfreq_ratio": 0.62},
    "text": {"min_text_height_ratio": 0.012, "min_local_contrast": 3.0},
    "transparency": {"require_for": ["cutout", "logo", "icon"]},
    "naming": {"pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+$", "max_length": 96},
    "delivery": {"allowed_formats": ["png", "jpg", "jpeg", "webp", "gif", "tif", "tiff", "avif", "bmp", "pdf"]},
    "gates": {
      "technical": ["resolution", "sharpness", "clipping", "banding", "noise"],
      "visual": ["contrast", "color", "sharpness"],
      "brand": ["palette", "naming"],
      "delivery": ["delivery", "naming", "transparency"]
    }
  },
  "artifact_heuristics": {
    "comment": "Heuristic defect screening only. No trained detector is bundled; findings are advisory and must be reviewed by a human.",
    "edge_halo_threshold": 0.34,
    "repeated_block_threshold": 0.55,
    "flat_region_threshold": 0.72,
    "noise_uniformity_threshold": 0.9
  }
}
