        "Write deterministic tests",
        "Execute and triage results",
        "Turn failures into tracked issues"
      ],
      "secure": [
        "Enumerate entry points and trust boundaries",
        "Scan code and dependencies",
        "Reproduce and prioritize findings",
        "Apply fixes with regression coverage"
      ],
      "fix": [
        "Reproduce the failure",
        "Isolate the earliest root cause",
        "Apply the smallest responsible fix",
        "Add a regression test"
      ],
      "document": [
        "Inventory real contracts and commands",
        "Write docs against observed behavior",
        "Validate every example",
        "Record version and compatibility notes"
      ],
      "package": [
        "Build release artifacts",
        "Assemble metadata, notes, and checksums",
        "Validate the package by reinstalling",
        "Hand off for approved publishing"
      ],
      "deliver": [
        "Define pipeline stages and gates",
        "Wire secrets through the CI secret store",
        "Verify on a test branch",
        "Promote with approvals and rollback ready"
      ],
      "operate": [
        "Instrument logs, metrics, traces",
        "Build dashboards and alerts",
        "Write runbooks for known failures",
        "Review toil and reliability metrics"
      ],
      "modernize": [
        "Characterize current behavior with tests",
        "Stage the migration with rollback points",
        "Upgrade in compatible increments",
        "Re-verify behavior at each stage"
      ],
      "orchestrate": [
        "Route the request to specialist stages",
        "Track shared state across handoffs",
        "Gate each transition on executed checks",
        "Aggregate the final completion report"
      ]
