      "framework",
      "delivery"
    ],
    "common_inputs": [
      "Clear statement of the user goal, target users, and success criteria",
      "Target platforms, languages, frameworks, and their exact versions",
      "Existing repository files, contracts, data samples, or credentials configured by the user (never invented)",
      "Constraints: security, privacy, accessibility, licensing, budget, deadlines",
      "Explicit approval boundaries for destructive, publishing, financial, or credential-using actions"
    ],
    "common_outputs": [
      "Editable source artifacts in the requested stack with exact filenames",
      "Exact build, run, and test commands with expected results",
      "Summary of decisions taken, limitations found, and follow-up work"
    ],
    "stage_io": {
      "design": {
        "inputs": [
          "Business context, personas, and nonfunctional requirements",
          "Current-state systems, data flows, and constraints for brownfield work"
        ],
        "outputs": [
          "Architecture document with components, contracts, data stores, and deployment targets",
          "Risk register, milestones, and acceptance checks"
        ],
        "verification": [
          "Every selected technology is version-resolved against authoritative documentation",
          "Architecture covers each stated requirement or records it as an explicit gap"
        ],
        "boundaries": [
          "Architecture advice only - no code execution required",
          "Vendor or service choices remain configurable; no locked-in paid services"
        ]
      },
      "build": {
        "inputs": [
          "Feature list or user stories with acceptance criteria",
          "Chosen stack with exact versions"
        ],
        "outputs": [
          "Runnable source tree with dependency manifests and configuration",
          "Tests covering core behavior",
          "Setup and run instructions"
        ],
        "verification": [
          "Project compiles/parses in the target runtime",
          "Tests execute and pass",
          "Application starts and serves the primary flow"
        ],
        "boundaries": [
          "No store submission, publishing, or deployment without explicit approval",
          "Third-party paid services replaced with configurable placeholders"
        ]
      },
      "verify": {
        "inputs": [
          "System under test with build/run instructions",
          "Risk areas and quality targets"
        ],
        "outputs": [
          "Test plan mapped to risks",
          "Executable tests with deterministic fixtures",
          "Results report with failures and reproduction steps"
        ],
        "verification": [
          "Tests run green on a clean checkout",
          "Flaky or environment-dependent tests are marked and quarantined"
        ],
        "boundaries": [
          "No production traffic or real user data in tests",
          "Destructive test actions run only against disposable environments"
        ]
      },
      "secure": {
        "inputs": [
          "Code, dependencies, and data-flow description",
          "Compliance or policy targets"
        ],
        "outputs": [
          "Prioritized findings with locations and fixes",
          "Hardening changes with regression tests",
          "Threat model or review record"
        ],
        "verification": [
          "Each finding has a reproduction or evidence reference",
          "Fixes verified by re-running the check"
        ],
        "boundaries": [
          "Offensive testing only against systems the user owns or has written permission to test",
          "Never embed or log real secrets or credentials"
        ]
      },
      "fix": {
        "inputs": [
          "Failing behavior: error messages, stack traces, logs, or reproduction steps",
          "Repository at the failing revision"
        ],
        "outputs": [
          "Smallest responsible fix with explanation",
          "Regression test that fails before and passes after the fix"
        ],
        "verification": [
          "Original failure no longer reproduces",
          "Existing test suite still passes"
        ],
        "boundaries": [
          "Preserve user code and edits; no opportunistic rewrites",
          "Root cause reported even when a workaround is applied"
        ]
      },
      "document": {
        "inputs": [
          "Actual code, contracts, or CLI behavior to describe",
          "Audience and depth"
        ],
        "outputs": [
          "Documentation tied to real artifacts (endpoints, schemas, commands, examples)",
          "Version and compatibility notes"
        ],
        "verification": [
          "Every documented command or example is executed or parsed successfully",
          "Docs match the current contract, not an assumed one"
        ],
        "boundaries": [
          "No invented endpoints, parameters, or results",
          "Sensitive values shown only as placeholders"
        ]
      },
      "package": {
        "inputs": [
          "Build outputs and target distribution channel",
          "Signing identity configured by the user (never stored by the skill)"
        ],
        "outputs": [
          "Installers/archives with checksums",
          "Release notes and upgrade paths",
          "SBOM when the channel requires it"
        ],
        "verification": [
          "Package reinstalls cleanly and the artifact reopens/runs",
          "Metadata, icons, and manifests match store or registry requirements"
        ],
        "boundaries": [
          "Publishing to stores or registries requires explicit user approval",
          "Signing keys and credentials stay in the user's environment"
        ]
      },
      "deliver": {
        "inputs": [
          "Repository, target environments, and promotion rules",
          "Approval requirements per environment"
        ],
        "outputs": [
          "Pipeline definitions with stages, caches, and artifacts",
          "Rollback procedure and verification gates"
        ],
        "verification": [
          "Pipeline runs green on a test branch",
          "Promotion gates block unverified changes"
        ],
        "boundaries": [
          "No production deployment without explicit approval",
          "Secrets referenced through the CI system's secret store, never inline"
        ]
      },
      "operate": {
        "inputs": [
          "Running system access (read-only where possible)",
          "Service objectives and alerting targets"
        ],
        "outputs": [
          "Instrumentation: logs, metrics, traces with correlation ids",
          "Dashboards, alerts, and runbooks"
        ],
        "verification": [
          "Signals visible in the observability backend",
          "Alerts fire on injected test failures"
        ],
        "boundaries": [
          "Privacy controls on all telemetry",
          "No destructive operations on live systems without approval"
        ]
      },
      "modernize": {
        "inputs": [
          "Current versions, dependencies, and observed behavior",
          "Target versions and compatibility requirements"
        ],
        "outputs": [
          "Staged migration plan with rollback points",
          "Characterization tests before behavior changes",
          "Updated code with compatibility notes"
        ],
        "verification": [
          "Behavior preserved: characterization tests pass pre- and post-change",
          "No mixed-version syntax or APIs in the result"
        ],
        "boundaries": [
          "One migration stage at a time; each stage independently rollback-ready",
          "Legacy support windows documented, not assumed"
        ]
      },
      "orchestrate": {
        "inputs": [
          "End-to-end request with acceptance criteria",
          "Available specialist skills and environment constraints"
        ],
        "outputs": [
          "Routed plan with explicit handoffs between stages",
          "Aggregated state: decisions, artifacts, unresolved risks",
          "Completion report with only executed checks"
        ],
        "verification": [
          "Each stage's completion checks actually ran",
          "Handoff artifacts exist and are referenced by path"
        ],
        "boundaries": [
          "Escalate missing tools, credentials, or hardware instead of simulating them",
          "Never claim success for stages that were skipped"
        ]
      }
    },
    "workflow_common": [
      "Resolve exact target versions and locate authoritative documentation",
      "Inspect the real files, repository, and environment before changing anything",
      "Plan the smallest correct set of changes or artifacts",
      "Implement, then run the verification checks for this stage",
      "Report results honestly: what ran, what passed, what remains open"
    ],
