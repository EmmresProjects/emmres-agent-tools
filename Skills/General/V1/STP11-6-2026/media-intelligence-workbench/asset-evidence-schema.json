{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-evidence-schema.json",
  "title": "Media Intelligence Workbench output contracts",
  "description": "JSON Schema for the two documents every downstream consumer relies on: the work plan emitted by `plan` and the evidence-first report emitted by `report`. A copy is included inside the package so the schema resolves offline; `tools-plan.py` enforces the same rules with a standard-library validator.",
  "type": "object",
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["id", "title", "required_action"],
      "properties": {
        "id": {"type": "string", "pattern": "^gate-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "approval_required": {"type": "boolean"},
        "blocks_release": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "unit": {
      "type": "object",
      "required": ["unit_id", "skill_id", "skill_name", "category",
                   "responsibility", "analysis_steps", "required_evidence",
                   "produces", "gates"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^U[0-9]{2,3}$"},
        "skill_id": {"type": "string", "pattern": "^mi-[0-9]{2}-[0-9]{2}$"},
        "skill_name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 10},
        "policy_class": {"type": "string"},
        "accepted_inputs": {"type": "array", "items": {"type": "string"}},
        "analysis_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "local_commands": {"type": "array", "items": {"type": "string"}},
        "external_dependency": {"type": ["string", "null"]},
        "confidence_policy": {
          "type": "object",
          "required": ["review_below", "abstain_below"],
          "properties": {
            "review_below": {"type": "number", "minimum": 0, "maximum": 1},
            "abstain_below": {"type": "number", "minimum": 0, "maximum": 1},
            "must_label_inference": {"type": "boolean"}
          }
        },
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
        "requires_human_approval": {"type": "boolean"},
        "runtime": {"type": "string", "enum": ["local-measurement", "plan-only"]}
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "required": ["plan_version", "umbrella", "policy_preset", "units", "pipeline",
                   "gates", "abstention_rules", "contract"],
      "properties": {
        "plan_version": {"const": "1.0.0"},
        "generated_by": {"type": "string"},
        "request": {"type": "string"},
        "umbrella": {"type": "string", "minLength": 1},
        "policy_preset": {"type": "string", "enum": ["draft", "standard", "conservative"]},
        "policy_summary": {"type": "string"},
        "catalog": {
          "type": "object",
          "properties": {
            "category_count": {"type": "integer", "minimum": 1},
            "skill_count": {"type": "integer", "minimum": 1},
            "matched_units": {"type": "integer", "minimum": 1},
            "categories_touched": {"type": "array", "items": {"type": "string"}}
          }
        },
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
        "pipeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "description"],
            "properties": {
              "stage": {"type": "string"},
              "description": {"type": "string"},
              "units": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "stage_order": {"type": "array", "items": {"type": "string"}},
        "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
        "requires_human_approval": {"type": "boolean"},
        "abstention_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "contract": {"type": "object"},
        "next_commands": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "object"}
      },
      "additionalProperties": true
    },
    "evidenceRow": {
      "type": "object",
      "required": ["claim", "source", "kind", "confidence"],
      "properties": {
        "claim": {"type": "string", "minLength": 5},
        "source": {"type": "string", "minLength": 1},
        "kind": {"enum": ["observation", "interpretation"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "timecode": {"type": ["string", "null"],
                     "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"},
        "start_s": {"type": ["number", "null"], "minimum": 0},
        "region": {
          "type": ["array", "object", "null"],
          "description": "[x0,y0,x1,y1] in pixels or an object with absolute and relative boxes",
          "items": {"type": "number"}
        },
        "offset": {"type": ["string", "null"],
                   "description": "byte offset or content-hash prefix anchoring the claim"},
        "basis": {"type": ["string", "null"],
                  "description": "required for kind=interpretation: what the reading rests on"},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "observation"}}},
          "then": {
            "anyOf": [
              {"required": ["timecode"]},
              {"required": ["start_s"]},
              {"required": ["region"]},
              {"required": ["offset"]}
            ]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "interpretation"}}},
          "then": {"required": ["basis"]}
        }
      ],
      "additionalProperties": true
    },
    "report": {
      "type": "object",
      "required": ["report_version", "title", "scope", "sources", "observations",
                   "interpretation", "evidence_table", "limits", "next_steps"],
      "properties": {
        "report_version": {"const": "1.0.0"},
        "title": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string"},
        "plan_ref": {"type": "string"},
        "umbrella": {"type": ["string", "null"]},
        "policy_preset": {"type": "string"},
        "scope": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string"}},
        "observations": {"type": "array"},
        "interpretation": {"type": "array", "items": {"type": "string"}},
        "evidence_table": {"type": "array", "items": {"$ref": "#/$defs/evidenceRow"}},
        "limits": {"type": "array", "items": {"type": "string"}},
        "next_steps": {"type": "array", "items": {"type": "string"}},
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/report"}
  ]
}
