{
  "skill_tool_name": "data-web-app-interaction",
  "version": "1.0.0",
  "paths": {
    "catalog_path": "data-web-app-interaction/asset-skill-catalog.json",
    "policy_path": "data-web-app-interaction/asset-safety-policy.json",
    "schemas_path": "data-web-app-interaction/asset-io-schemas.json",
    "prompts_path": "data-web-app-interaction/asset-prompt-templates.json",
    "sample_html_path": "data-web-app-interaction/asset-sample-page.html",
    "sample_csv_path": "data-web-app-interaction/asset-sample-records.csv",
    "sample_events_path": "data-web-app-interaction/asset-sample-events.jsonl",
    "sample_geojson_path": "data-web-app-interaction/asset-sample-spatial.geojson"
  },
  "execution": {
    "default_mode": "read-only",
    "timeout_seconds": 25.0,
    "max_timeout_seconds": 300.0,
    "max_retries": 2,
    "retry_backoff_seconds": 0.5,
    "retry_backoff_multiplier": 2.0,
    "rate_limit_requests_per_second": 2.0,
    "max_crawl_pages": 25,
    "max_crawl_depth": 3,
    "max_pagination_pages": 20,
    "max_file_bytes": 52428800,
    "max_archive_entries": 2000,
    "max_archive_uncompressed_bytes": 104857600,
    "max_archive_compression_ratio": 100.0,
    "max_simulation_iterations": 100000,
    "default_random_seed": 42,
    "cleanup_temp_on_exit": true
  },
  "network": {
    "allow_live_network": false,
    "user_agent": "DataWebAppInteractionSkillTool/1.0 (+authorized-inspection; read-only-default)",
    "respect_robots_txt": true,
    "allowed_schemes": ["https", "http"],
    "block_private_ip_ranges": true,
    "verify_tls": true
  },
  "providers": {
    "search_provider": {
      "driver": "offline-corpus-or-configured-http",
      "endpoint": "",
      "api_key_env": "DWAI_SEARCH_API_KEY",
      "timeout_seconds": 15.0
    },
    "browser_provider": {
      "driver": "stdlib-dom-or-playwright",
      "headless": true,
      "executable_path": ""
    },
    "ocr_provider": {
      "driver": "tesseract-or-supplied-text",
      "binary_name": "tesseract",
      "default_language": "eng"
    },
    "llm_provider": {
      "driver": "disabled",
      "model": "",
      "endpoint": "",
      "api_key_env": "DWAI_MODEL_API_KEY"
    },
    "storage_provider": {
      "driver": "local-filesystem",
      "staging_prefix": ""
    }
  },
  "output": {
    "default_format": "json",
    "pretty_json": true,
    "redact_secrets": true,
    "redact_personal_data_in_logs": true,
    "include_provenance": true
  }
}
