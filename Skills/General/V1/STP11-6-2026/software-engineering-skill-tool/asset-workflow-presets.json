{
  "version": "1.0.0",
  "skill_tool_name": "software-engineering",
  "workflows": {
    "greenfield-service-delivery": {
      "description": "End-to-end decomposition, ADR, OpenAPI contract, SQLite schema validation, Python implementation check, SAST review, and Definition-of-Done gate.",
      "steps": [
        {"step_id": "decompose", "skill": "requirement-decomposition", "depends_on": []},
        {"step_id": "adr", "skill": "architecture-decision-records", "depends_on": ["decompose"]},
        {"step_id": "api", "skill": "openapi-specification", "depends_on": ["adr"]},
        {"step_id": "db", "skill": "relational-schema-design", "depends_on": ["adr"]},
        {"step_id": "security", "skill": "static-application-security-testing", "depends_on": ["api", "db"]},
        {"step_id": "dod", "skill": "definition-of-done-enforcement", "depends_on": ["security"]}
      ]
    },
    "security-and-supply-chain-gate": {
      "description": "STRIDE threat model, SAST scan, secrets scan, Dockerfile audit, SBOM generation, and provenance attestation.",
      "steps": [
        {"step_id": "threat", "skill": "threat-modeling", "depends_on": []},
        {"step_id": "sast", "skill": "static-application-security-testing", "depends_on": ["threat"]},
        {"step_id": "secrets", "skill": "secrets-detection", "depends_on": ["threat"]},
        {"step_id": "sbom", "skill": "software-bill-of-materials", "depends_on": ["sast", "secrets"]},
        {"step_id": "provenance", "skill": "provenance-attestation", "depends_on": ["sbom"]},
        {"step_id": "gate", "skill": "verification-gate", "depends_on": ["provenance"]}
      ]
    },
    "incident-root-cause-and-patch": {
      "description": "Stack trace parsing, log burst clustering, deadlock analysis, root cause report, and minimal corrective patch verification.",
      "steps": [
        {"step_id": "trace", "skill": "stack-trace-analysis", "depends_on": []},
        {"step_id": "logs", "skill": "log-based-debugging", "depends_on": []},
        {"step_id": "deadlock", "skill": "deadlock-debugging", "depends_on": ["trace", "logs"]},
        {"step_id": "rca", "skill": "root-cause-analysis-report", "depends_on": ["deadlock"]},
        {"step_id": "patch", "skill": "minimal-corrective-patch", "depends_on": ["rca"]}
      ]
    },
    "data-and-ml-pipeline-validation": {
      "description": "ETL execution, data quality checks, schema evolution check, baseline ML evaluation, drift detection, and numerical stability check.",
      "steps": [
        {"step_id": "etl", "skill": "etl-pipeline-builder", "depends_on": []},
        {"step_id": "dq", "skill": "data-quality-framework", "depends_on": ["etl"]},
        {"step_id": "ml", "skill": "model-evaluation", "depends_on": ["dq"]},
        {"step_id": "drift", "skill": "model-drift-detection", "depends_on": ["ml"]},
        {"step_id": "num", "skill": "numerical-stability-analysis", "depends_on": ["drift"]}
      ]
    }
  }
}
