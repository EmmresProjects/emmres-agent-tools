{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-engineering/asset-output-schema.json",
  "title": "Software Engineering Skill Tool Execution Envelope",
  "type": "object",
  "required": [
    "status",
    "run_id",
    "tool",
    "command",
    "timestamp_utc",
    "duration_ms",
    "inputs_validated",
    "approval",
    "results",
    "verification_checks",
    "artifacts",
    "limitations",
    "errors"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "failed", "approval_required", "recovered"]
    },
    "run_id": {
      "type": "string",
      "minLength": 6
    },
    "tool": {
      "type": "string",
      "const": "software-engineering"
    },
    "command": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "inputs_validated": {
      "type": "boolean"
    },
    "approval": {
      "type": "object",
      "required": ["required", "granted", "scope", "action_mode"],
      "properties": {
        "required": {"type": "boolean"},
        "granted": {"type": "boolean"},
        "scope": {"type": "string"},
        "action_mode": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "results": {
      "type": "object"
    },
    "verification_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "name", "status", "details"],
        "properties": {
          "check_id": {"type": "string"},
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "skipped", "warning"]},
          "details": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  }
}
