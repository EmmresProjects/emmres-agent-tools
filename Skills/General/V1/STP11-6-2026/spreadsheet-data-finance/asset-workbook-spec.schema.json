{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asset-workbook-spec.schema.json",
  "title": "spreadsheet-data-finance workbook build specification",
  "description": "Schema for the JSON accepted by `tools-sdf.py build` and (partially) by `dashboard`. Unknown keys are ignored by the runtime, so keep specs minimal and documented.",
  "type": "object",
  "required": ["sheets"],
  "properties": {
    "title": {"type": "string", "description": "Workbook title used in properties, print header and the Index sheet."},
    "nav": {"type": "boolean", "default": false, "description": "Create an Index sheet with hyperlinks and return links."},
    "properties": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "creator": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "print": {
      "type": "object",
      "properties": {
        "orientation": {"enum": ["portrait", "landscape"]},
        "fit_width": {"type": "integer", "minimum": 1, "default": 1},
        "repeat_rows": {"type": "string", "description": "Excel row range, for example \"1:1\"."},
        "margin": {"type": "number", "default": 0.5},
        "header": {"type": "string"},
        "footer": {"type": "string"}
      }
    },
    "named_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ref"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
          "ref": {"type": "string", "description": "Sheet-qualified reference, for example Inputs!$B$2:$B$20"}
        }
      }
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "maxLength": 31},
          "role": {"enum": ["doc", "input", "calc", "output", "check", "data"]},
          "purpose": {"type": "string", "description": "Shown on the Index sheet."},
          "title": {"type": "string"},
          "intro": {"type": "string"},
          "columns": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array", "items": ["string", "number", "boolean", "null"]}},
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cell": {"type": "string", "pattern": "^[A-Za-z]{1,3}\\d{1,7}$"},
                "value": {},
                "formula": {"type": "string"},
                "role": {"enum": ["title", "subtitle", "header", "input", "formula", "output", "total", "warning", "assumption", "note", "label"]},
                "number_format": {"type": "string"},
                "comment": {"type": "string"}
              },
              "anyOf": [{"required": ["cell", "value"]}, {"required": ["cell", "formula"]}]
            }
          },
          "number_formats": {
            "type": "object",
            "description": "Column letter to Excel number-format pattern, applied to data rows.",
            "additionalProperties": {"type": "string"}
          },
          "rows_to_style": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["row"],
              "properties": {
                "row": {"type": "integer", "minimum": 1},
                "role": {"enum": ["title", "subtitle", "header", "input", "formula", "output", "total", "warning", "assumption", "note", "label"]},
                "last_column": {"type": "integer", "minimum": 1}
              }
            }
          },
          "freeze": {"type": "string", "description": "Cell reference for the frozen pane, for example A2."},
          "widths": {"type": "object", "additionalProperties": {"type": "number"}},
          "tab_color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
          "table": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "description": "Must start with a letter; underscores replace invalid characters."},
              "style": {"type": "string", "default": "TableStyleMedium2"}
            }
          },
          "validations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["range"],
              "properties": {
                "range": {"type": "string"},
                "type": {"enum": ["list", "whole", "decimal", "date", "time", "textLength", "custom"]},
                "operator": {"enum": ["between", "notBetween", "equal", "notEqual", "greaterThan", "lessThan", "greaterThanOrEqual", "lessThanOrEqual"]},
                "formula1": {"type": "string"},
                "formula2": {"type": "string"},
                "allow_blank": {"type": "boolean", "default": true},
                "error_title": {"type": "string"},
                "error": {"type": "string"},
                "prompt_title": {"type": "string"},
                "prompt": {"type": "string"}
              }
            }
          },
          "protection": {
            "type": "object",
            "properties": {
              "sheet": {"type": "boolean", "default": true},
              "format_cells": {"type": "boolean", "default": false}
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "title": "Monthly variance pack",
      "nav": true,
      "print": {"orientation": "landscape", "fit_width": 1, "repeat_rows": "1:1"},
      "sheets": [
        {"name": "Inputs", "purpose": "User inputs", "columns": ["Line item", "Actual", "Budget"],
         "rows": [["Revenue", 120000, 115000], ["Cost of sales", 54000, 52000]],
         "number_formats": {"B": "#,##0", "C": "#,##0"},
         "validations": [{"range": "B2:C3", "type": "decimal", "operator": "greaterThanOrEqual",
                          "formula1": "0", "error": "Enter a non-negative amount.",
                          "prompt": "Amount in reporting currency"}]},
        {"name": "Checks", "purpose": "Control totals",
         "cells": [{"cell": "A1", "value": "Total actual", "role": "label"},
                   {"cell": "B1", "formula": "=SUM(Inputs!B2:B3)", "role": "output", "number_format": "#,##0"}]}
      ]
    }
  ]
}
