{
  "description": "Curated formula patterns with verified expected results. Used to validate the formula engine and to give authors a starting pattern that is known-correct.",
  "suite": [
    {"id": "sum_range", "formula": "=SUM(A1:A5)", "cells": {"A1": 10, "A2": 20, "A3": 30, "A4": 40, "A5": 50}, "expect": 150},
    {"id": "average_guard", "formula": "=IFERROR(AVERAGE(B1:B4),0)", "cells": {"B1": 4, "B2": 8, "B3": "", "B4": 12}, "expect": 8},
    {"id": "division_guard", "formula": "=IFERROR(C1/C2,\"n/a\")", "cells": {"C1": 10, "C2": 0}, "expect": "n/a"},
    {"id": "nested_if", "formula": "=IF(D1>100,\"high\",IF(D1>50,\"medium\",\"low\"))", "cells": {"D1": 75}, "expect": "medium"},
    {"id": "countif", "formula": "=COUNTIF(E1:E5,\">10\")", "cells": {"E1": 5, "E2": 15, "E3": 25, "E4": 8, "E5": 30}, "expect": 3},
    {"id": "sumif", "formula": "=SUMIF(F1:F4,\"APAC\",G1:G4)", "cells": {"F1": "APAC", "F2": "EMEA", "F3": "APAC", "F4": "APAC", "G1": 10, "G2": 20, "G3": 30, "G4": 40}, "expect": 80},
    {"id": "rounding", "formula": "=ROUND(H1*1.05,2)", "cells": {"H1": 123.456}, "expect": 129.63},
    {"id": "percent_of_total", "formula": "=I1/SUM(I1:I3)", "cells": {"I1": 25, "I2": 25, "I3": 50}, "expect": 0.25},
    {"id": "pmt", "formula": "=ROUND(PMT(0.06/12,60,-10000),2)", "cells": {}, "expect": 193.33},
    {"id": "npv", "formula": "=ROUND(NPV(0.1,100,100,100),2)", "cells": {}, "expect": 248.69},
    {"id": "text_join", "formula": "=CONCAT(J1,\" -\",J2)", "cells": {"J1": "Region", "J2": "APAC"}, "expect": "Region -APAC"},
    {"id": "chained_refs", "formula": "=K1*K2+K3", "cells": {"K1": 2, "K2": 3, "K3": 4}, "expect": 10},
    {"id": "formula_cell_ref", "formula": "=L1*2", "cells": {"L1": "=M1+1", "M1": 4}, "expect": 10}
  ],
  "patterns": {
    "variance_with_direction": {
      "formula": "=IF(ABS(actual-budget)<=tolerance,\"on plan\",IF((actual-budget)*direction>0,\"favourable\",\"unfavourable\"))",
      "notes": ["direction = 1 when higher is better, -1 when lower is better", "always show the value, not only the label"]
    },
    "safe_ratio": {"formula": "=IFERROR(numerator/denominator,\"\")", "notes": ["blank over zero avoids fake precision"]},
    "period_flag": {"formula": "=AND(date>=start_date,date<=end_date)", "notes": ["use named ranges for start_date/end_date"]},
    "aging_bucket": {
      "formula": "=IF(days_overdue<=0,\"not due\",IF(days_overdue<=30,\"1-30\",IF(days_overdue<=60,\"31-60\",IF(days_overdue<=90,\"61-90\",\"90+\"))))",
      "notes": ["keep the bucket boundaries in an assumption cell so they are auditable"]
    },
    "lookup_safe": {
      "formula": "=IFERROR(INDEX(price_table,MATCH(key,key_list,0),1),\"not found\")",
      "notes": ["prefer INDEX/MATCH over VLOOKUP: it survives column inserts"]
    },
    "running_total": {"formula": "=SUM($B$2:B2)", "notes": ["anchored start row makes the pattern copyable"]},
    "guard_negative": {"formula": "=MAX(0,value)", "notes": ["only where a negative is genuinely impossible; otherwise keep the sign"]}
  },
  "engine_limits": [
    "No dynamic arrays, spilled ranges or implicit intersection.",
    "No LET, LAMBDA or LAMBDA helper functions.",
    "No external references, volatile RAND/NOW/INDIRECT/OFFSET semantics, or iterative calculation.",
    "Volatile TODAY() returns the sandbox date; treat that as an input, not a stable value."
  ]
}
