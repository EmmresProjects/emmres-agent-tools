{
  "schema_version": "1.0",
  "limits": {
    "max_input_bytes": 20971520,
    "max_slides": 500,
    "max_objects_per_slide": 1000,
    "max_csv_rows": 10000,
    "max_image_pixels": 40000000,
    "max_batch_items": 100,
    "max_text_chars": 200000,
    "max_svg_nodes": 20000
  },
  "defaults": {
    "theme": "neutral",
    "formats": [
      "json",
      "svg",
      "html",
      "pptx"
    ],
    "language": "en",
    "direction": "ltr",
    "canvas": {
      "width": 1280,
      "height": 720,
      "margin": 64,
      "grid": 12,
      "safe": 48
    },
    "timeout_seconds": 120
  },
  "paths": {
    "capabilities": "universal-presentation-design/asset-capabilities.json",
    "deck_schema": "universal-presentation-design/asset-deck.schema.json",
    "themes": "universal-presentation-design/asset-themes.json",
    "example_deck": "universal-presentation-design/asset-example-deck.json",
    "example_brief": "universal-presentation-design/asset-example-brief.md",
    "example_data": "universal-presentation-design/asset-example-data.csv",
    "example_request": "universal-presentation-design/asset-example-request.html",
    "example_translations": "universal-presentation-design/asset-example-translations.json",
    "example_image": "universal-presentation-design/asset-example-image.png"
  },
  "providers": {
    "text": "local-heuristic",
    "image": "local-procedural",
    "translation": "supplied-map",
    "qr": "segno",
    "network": false
  },
  "safety": {
    "require_approval_for": [
      "overwrite",
      "publish",
      "signoff",
      "privacy-redaction",
      "macro-handoff",
      "permission-change"
    ],
    "allow_network": false,
    "allow_shell": false,
    "allow_arbitrary_code": false
  },
  "accessibility": {
    "min_contrast": 4.5,
    "min_font_size": 18,
    "max_bullets": 6,
    "max_words_per_slide": 80,
    "max_motion_ms": 5000,
    "flash_hz_limit": 3
  },
  "retry": {
    "attempts": 2,
    "backoff_ms": 100
  },
  "locales": {
    "en": {
      "date": "%Y-%m-%d",
      "decimal": ".",
      "thousands": ",",
      "currency": "USD"
    },
    "de": {
      "date": "%d.%m.%Y",
      "decimal": ",",
      "thousands": ".",
      "currency": "EUR"
    },
    "fr": {
      "date": "%d/%m/%Y",
      "decimal": ",",
      "thousands": " ",
      "currency": "EUR"
    },
    "ar": {
      "date": "%d/%m/%Y",
      "decimal": ".",
      "thousands": ",",
      "currency": "SAR",
      "direction": "rtl"
    },
    "ja": {
      "date": "%Y/%m/%d",
      "decimal": ".",
      "thousands": ",",
      "currency": "JPY"
    }
  }
}
