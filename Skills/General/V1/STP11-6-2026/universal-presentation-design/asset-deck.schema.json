{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universal-presentation-design/asset-deck.schema.json",
  "title": "Universal Presentation Design deck model",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "slides"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl",
        "auto"
      ]
    },
    "theme": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 320,
          "maximum": 7680
        },
        "height": {
          "type": "number",
          "minimum": 180,
          "maximum": 4320
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "grid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "safe": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": true
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "layout": {
            "enum": [
              "title",
              "section",
              "bullets",
              "two-column",
              "chart",
              "table",
              "diagram",
              "timeline",
              "image",
              "quote",
              "kpi",
              "comparison",
              "quiz",
              "dashboard",
              "closing",
              "blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "alt_text": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "fade",
                  "push",
                  "wipe"
                ]
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "chart": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "bar",
                  "column",
                  "line",
                  "area",
                  "scatter",
                  "bubble",
                  "waterfall",
                  "funnel",
                  "heatmap",
                  "map",
                  "small-multiples",
                  "kpi",
                  "uncertainty"
                ]
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "values"
                  ],
                  "additionalProperties": true
                }
              },
              "x_label": {
                "type": "string"
              },
              "y_label": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "zero_baseline": {
                "type": "boolean"
              },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [],
                  "additionalProperties": true
                }
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "table": {
            "type": "object",
            "properties": {
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "diagram": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "flow",
                  "process",
                  "swimlane",
                  "architecture",
                  "network",
                  "mindmap",
                  "concept",
                  "causal",
                  "cycle",
                  "pyramid",
                  "venn",
                  "hierarchy",
                  "journey",
                  "blueprint"
                ]
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "lane": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": true
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "timeline": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "timeline",
                  "gantt",
                  "roadmap",
                  "now-next-later",
                  "horizon",
                  "milestones"
                ]
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "start": {
                      "type": "string"
                    },
                    "end": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "lane": {
                      "type": "string"
                    },
                    "dependencies": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "image": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "focal_x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "focal_y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fit": {
                "enum": [
                  "cover",
                  "contain",
                  "fill"
                ]
              },
              "credit": {
                "type": "string"
              },
              "license": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "kpis": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "delta": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": true
            }
          },
          "quiz": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "correct": {
                      "type": "boolean"
                    },
                    "feedback": {
                      "type": "string"
                    },
                    "next": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "question",
              "options"
            ],
            "additionalProperties": true
          },
          "link": {
            "type": "object",
            "properties": {
              "target_slide": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "text",
                    "rect",
                    "ellipse",
                    "line",
                    "image"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                },
                "fill": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "stroke": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "size": {
                  "type": "number"
                },
                "z": {
                  "type": "integer"
                }
              },
              "required": [],
              "additionalProperties": true
            }
          },
          "translations": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "published"
            ]
          },
          "owner": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "layout",
          "title"
        ],
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": true
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "localization": {
      "type": "object",
      "properties": {
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "translations": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "handoff": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  }
}
