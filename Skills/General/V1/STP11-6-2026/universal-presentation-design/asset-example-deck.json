    {
      "id": "problem",
      "section": "context",
      "layout": "bullets",
      "title": "Repeated flooding disrupts homes and services",
      "bullets": [
        "Three districts report repeated street flooding.",
        "Drainage upgrades are currently planned independently.",
        "Residents need a coordinated, measurable pilot."
      ],
      "notes": "Keep the problem factual and local.",
      "duration_seconds": 45
    },
    {
      "id": "trend",
      "section": "evidence",
      "layout": "chart",
      "title": "Reported flood incidents by quarter",
