{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-plan-schema.json",
  "title": "powerful-work-splitter plan",
  "type": "object",
  "required": ["schema_version", "goal", "stage_count", "stages", "requirements"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "goal": { "type": "string", "minLength": 3 },
    "single_response_feasible": { "type": "boolean" },
    "recommendation": {
      "type": "object",
      "required": ["recommended", "minimum", "maximum"],
      "properties": {
        "recommended": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stage_count": { "type": "integer", "minimum": 1, "maximum": 14 },
    "user_selected_stage_count": { "type": ["integer", "null"], "minimum": 1, "maximum": 14 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "role", "requirements"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "title": { "type": "string" },
          "role": { "enum": ["discovery", "build", "assembly"] },
          "objective": { "type": "string" },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^R[0-9]+$" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "entry_gate": { "type": ["string", "null"] },
          "exit_gate": { "type": ["string", "null"] },
          "status": { "enum": ["pending", "in-progress", "complete", "blocked", "repaired"] },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "owner_stage"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "text": { "type": "string" },
          "kind": { "enum": ["deliverable", "process", "quality"] },
          "owner_stage": { "type": ["string", "null"] },
          "acceptance": { "type": "string" },
          "status": { "enum": ["pending", "done", "verified", "blocked"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "required"],
        "properties": {
          "path": { "type": "string" },
          "role": { "enum": ["input", "output", "evidence"] },
          "required": { "type": "boolean" },
          "present": { "type": "boolean" },
          "status": { "enum": ["ok", "missing", "unreadable", "stale", "duplicate"] }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "impact": { "enum": ["low", "medium", "high"] },
          "recheck_trigger": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } },
        "deferred": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
