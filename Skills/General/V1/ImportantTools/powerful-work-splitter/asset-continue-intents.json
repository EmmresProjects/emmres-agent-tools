{
  "version": "1.0.0",
  "description": "Continuation lexicon for the Checkpoint and Continue Controller. Patterns are case-insensitive regular expressions matched against the whole normalized reply. Order of evaluation: hard_stop, scope_change, continue, ambiguous.",
  "continue_patterns": [
    "^c$",
    "^cont$",
    "^continue$",
    "^continue[.,!]*$",
    "^continue (?:please|now|on|with (?:the )?(?:next|stage))$",
    "^proceed$",
    "^proceed (?:please|now)$",
    "^go on$",
    "^go ahead$",
    "^keep going$",
    "^carry on$",
    "^next$",
    "^next stage$",
    "^next step$",
    "^resume$",
    "^resume (?:work|the plan)$",
    "^yes[,]? continue$",
    "^ok[,]? continue$",
    "^stage \\d+$",
    "^do it$",
    "^approved$",
    "^all good[,]? continue$"
  ],
  "hard_stop_patterns": [
    "^stop$",
    "^stop (?:now|here|everything)$",
    "^cancel$",
    "^abort$",
    "^pause$",
    "^halt$",
    "^quit$"
  ],
  "scope_change_patterns": [
    "\\bmore stages?\\b",
    "\\bfewer stages?\\b",
    "\\badd\\b.*\\b(?:requirement|stage|file|section)\\b",
    "\\bremove\\b.*\\b(?:requirement|stage|file|section)\\b",
    "\\breplace\\b",
    "\\binstead\\b",
    "\\bactually\\b",
    "\\bchange (?:the|it|this|plan|scope)\\b",
    "\\bnew requirement\\b",
    "\\bexpand\\b",
    "\\bcompress\\b",
    "^redo\\b",
    "^undo\\b",
    "^switch\\b",
    "^restart\\b",
    "\\bstart over\\b",
    "\\bnot what i\\b",
    "\\buse \\d+ stages?\\b"
  ],
  "ambiguous_patterns": [
    "^ok$",
    "^k$",
    "^sure$",
    "^maybe$",
    "^hmm+$",
    "^why\\b",
    "^what\\b",
    "^how\\b",
    "^\\?+$",
    "^yes$",
    "^no$"
  ],
  "notes": "A reply that matches no list is treated as ambiguous and reported as needs_clarification with exit code 2. Unknown intent never advances the plan."
}
