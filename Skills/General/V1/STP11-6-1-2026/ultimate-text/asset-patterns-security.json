{
  "schema": "ultimate-text/security-patterns-v1",
  "version": "1.0.0",
  "notes": "Detection patterns only. They are heuristics with reported confidence, not a compliance guarantee. Validate against your own policy before relying on any result.",
  "pii": {
    "email": {"pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "confidence": 0.95, "replacement": "[EMAIL]"},
    "phone_intl": {"pattern": "\\+?\\d{1,3}[\\s.-]?\\(?\\d{2,4}\\)?[\\s.-]?\\d{3,4}[\\s.-]?\\d{3,4}", "confidence": 0.7, "replacement": "[PHONE]"},
    "credit_card": {"pattern": "\\b(?:\\d[ -]?){13,19}\\b", "confidence": 0.75, "replacement": "[CARD]"},
    "ssn_us": {"pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "confidence": 0.9, "replacement": "[SSN]"},
    "iban": {"pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{10,30}\\b", "confidence": 0.7, "replacement": "[IBAN]"},
    "ipv4": {"pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b", "confidence": 0.8, "replacement": "[IP]"},
    "ipv6": {"pattern": "\\b(?:[A-Fa-f0-9]{1,4}:){2,7}[A-Fa-f0-9]{1,4}\\b", "confidence": 0.75, "replacement": "[IPV6]"},
    "date_of_birth": {"pattern": "\\b(?:DOB|date of birth|born)[:\\s]+\\d{1,4}[-/.]\\d{1,2}[-/.]\\d{1,4}\\b", "confidence": 0.8, "replacement": "[DOB]"},
    "postal_address": {"pattern": "\\b\\d{1,6}\\s+[A-Z][A-Za-z]+(?:\\s+[A-Z][A-Za-z]+)*\\s+(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Boulevard|Blvd)\\b", "confidence": 0.65, "replacement": "[ADDRESS]"},
    "passport_generic": {"pattern": "\\b(?:passport|PPN)[:\\s]*[A-Z0-9]{6,9}\\b", "confidence": 0.7, "replacement": "[PASSPORT]"},
    "medical_record": {"pattern": "\\b(?:MRN|patient id)[:\\s]*[A-Z0-9-]{4,12}\\b", "confidence": 0.7, "replacement": "[MRN]"},
    "mac_address": {"pattern": "\\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\\b", "confidence": 0.9, "replacement": "[MAC]"},
    "uuid": {"pattern": "\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b", "confidence": 0.6, "replacement": "[UUID]"}
  },
  "secrets": {
    "aws_access_key_id": {"pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "confidence": 0.95, "severity": "critical"},
    "github_token": {"pattern": "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b", "confidence": 0.95, "severity": "critical"},
    "slack_token": {"pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}\\b", "confidence": 0.9, "severity": "critical"},
    "google_api_key": {"pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "confidence": 0.9, "severity": "critical"},
    "stripe_key": {"pattern": "\\b(?:sk|pk)_(?:live|test)_[0-9A-Za-z]{16,}\\b", "confidence": 0.9, "severity": "critical"},
    "private_key_block": {"pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "confidence": 0.99, "severity": "critical"},
    "jwt": {"pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}\\b", "confidence": 0.85, "severity": "high"},
    "connection_string": {"pattern": "(?:mongodb|postgres(?:ql)?|mysql|redis|amqp)://[^\\s:/@]+:[^\\s@]+@[^\\s]+", "confidence": 0.9, "severity": "critical"},
    "password_assignment": {"pattern": "(?i)\\b(?:password|passwd|pwd|secret|api[_ -]?key|token)\\b\\s*[:=]\\s*[\"']?[^\\s\"']{4,}", "confidence": 0.7, "severity": "high"},
    "bearer_token": {"pattern": "(?i)\\bauthorization\\s*:\\s*bearer\\s+[A-Za-z0-9._-]{8,}", "confidence": 0.85, "severity": "high"}
  },
  "injection": {
    "instruction_override": {"pattern": "(?i)\\b(ignore|disregard|forget)\\b[^\\n]{0,40}\\b(previous|prior|above|earlier|all)\\b[^\\n]{0,20}\\b(instruction|prompt|rule|direction)s?\\b", "confidence": 0.9},
    "role_hijack": {"pattern": "(?i)\\b(you are now|from now on you|act as)\\b[^\\n]{0,40}\\b(admin|root|developer mode|dan|unrestricted)\\b", "confidence": 0.85},
    "system_prompt_probe": {"pattern": "(?i)\\b(reveal|print|show|repeat|output)\\b[^\\n]{0,30}\\b(system prompt|initial instruction|hidden rule)s?\\b", "confidence": 0.85},
    "exfiltration_request": {"pattern": "(?i)\\b(send|post|upload|email|forward)\\b[^\\n]{0,40}\\b(to|at)\\b[^\\n]{0,20}(https?://|@)", "confidence": 0.7},
    "tool_invocation": {"pattern": "(?i)\\b(call|invoke|execute|run)\\b[^\\n]{0,20}\\b(tool|function|command|shell|bash)\\b", "confidence": 0.6},
    "encoded_payload": {"pattern": "\\b(?:base64|rot13|eval|exec)\\s*[(:=]\\s*[A-Za-z0-9+/=]{16,}", "confidence": 0.8},
    "urgency_pressure": {"pattern": "(?i)\\b(urgent|immediately|before it is too late|or else|final warning)\\b", "confidence": 0.4},
    "hidden_instruction_marker": {"pattern": "(?i)<!--[^>]{0,400}(instruction|ignore|system|prompt)[^>]{0,400}-->", "confidence": 0.75}
  },
  "steganography": {
    "zero_width": ["\u200b", "\u200c", "\u200d", "\u2060", "\ufeff"],
    "tag_characters": {"ranges": [[917504, 917631]], "name": "Unicode tag characters (U+E0000-E007F)"},
    "variation_selectors": {"ranges": [[65024, 65039], [917760, 917999]], "name": "variation selectors"},
    "bidi_controls": ["\u202a", "\u202b", "\u202c", "\u202d", "\u202e", "\u2066", "\u2067", "\u2068", "\u2069"]
  },
  "canonicalization": {
    "preferred": "NFC",
    "checks": [
      "is NFC form is True",
      "no zero-width or tag characters remain",
      "no bidi control characters outside an intended RTL run",
      "confusable ratio below the policy threshold",
      "line endings agreement"
    ]
  },
  "checksums": {
    "primary": "sha256",
    "secondary": ["sha1", "md5"],
    "note": "md5 and sha1 are provided for interoperability with legacy manifests only; they are not collision resistant."
  },
  "accessibility": {
    "reading_level_target": {"plain": 8.0, "general": 10.0, "technical": 14.0},
    "alt_text_max_chars": 125,
    "caption_line_chars": 42,
    "caption_max_lines": 2,
    "caption_rate_chars_per_second": 20
  },
  "recovery": {
    "mojibake_chain": ["utf-8", "cp1252", "latin-1"],
    "normalization_order": ["repair mojibake", "normalise newlines", "normalise unicode (NFC)", "then edit content"],
    "lossless_first": true
  }
}
