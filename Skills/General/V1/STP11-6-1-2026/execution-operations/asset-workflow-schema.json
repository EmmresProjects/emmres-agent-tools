{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-workflow-schema.json",
  "title": "Execution Operations workflow",
  "description": "Schema for a workflow executed by the orchestrate operation. A workflow is a directed acyclic graph of nodes. Exactly one of shell, argv, op, or noop must be given per node.",
  "type": "object",
  "required": [
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Free-form metadata copied into the report (correlation id, owner, ticket).",
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "workdir": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "checkpoint": {
          "type": "boolean"
        },
        "dialect": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "sh",
            "zsh",
            "cmd",
            "powershell"
          ]
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Shell command text. Interpreted by the dialect in 'dialect'."
        },
        "dialect": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "sh",
            "zsh",
            "cmd",
            "powershell"
          ],
          "description": "Shell dialect used for 'command'. Defaults to defaults.dialect, then auto."
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "op": {
          "type": "string",
          "description": "A nexuslib operation name, e.g. exec, validate, trace, estimate."
        },
        "op_args": {
          "type": "object",
          "additionalProperties": true
        },
        "noop": {
          "type": "boolean",
          "description": "Structural node used only to group dependencies."
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "workdir": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "checkpoint": {
          "type": "boolean",
          "description": "Mark node complete from a checkpoint file when resuming."
        },
        "requires_approval": {
          "type": "boolean",
          "description": "Force the approval gate for this node."
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths that must exist for the node to count as verified."
        },
        "success_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "continue_on_error": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "argv"
          ]
        },
        {
          "required": [
            "op"
          ]
        },
        {
          "required": [
            "noop"
          ]
        }
      ],
      "description": "One executable unit. Provide command (shell text), argv (direct exec), op (built-in operation), or noop (structural node)."
    }
  }
}
