{
  "version": "1.0.0",
  "profile": "default",
  "paths": {
    "work_root": ".",
    "state_dir": ".nexus/state",
    "run_dir": ".nexus/runs",
    "log_dir": ".nexus/logs"
  },
  "scope": {
    "allowed_roots": [],
    "denied_roots": [],
    "allow_outside_work_root": false
  },
  "execution": {
    "default_shell": "auto",
    "default_timeout_seconds": 120,
    "max_timeout_seconds": 3600,
    "stall_timeout_seconds": 300,
    "heartbeat_pattern": "^(\\[?heartbeat\\]?|PROGRESS|STEP|TICK|OK:)",
    "kill_grace_seconds": 5,
    "max_output_bytes": 200000,
    "max_output_lines": 400
  },
  "retry": {
    "max_attempts": 3,
    "base_delay_seconds": 0.5,
    "factor": 2.0,
    "max_delay_seconds": 20.0,
    "jitter_ratio": 0.25,
    "retry_on_states": ["retryable_failure", "transient_network", "resource_saturation"]
  },
  "orchestration": {
    "max_parallel": 4,
    "max_nodes": 200,
    "block_dependents_on_failure": true,
    "continue_on_error": false
  },
  "approval": {
    "required_levels": ["high", "critical"],
    "token_env": "NEXUS_APPROVAL_TOKEN",
    "require_reference": true,
    "audit_file": "audit.jsonl"
  },
  "network": {
    "allow_network": false,
    "allowed_hosts": [],
    "timeout_seconds": 15,
    "max_attempts": 2,
    "max_response_bytes": 100000
  },
  "data": {
    "max_rows": 100000,
    "default_format": "json"
  },
  "database": {
    "allowed_roots": [],
    "read_only_by_default": true,
    "max_rows": 5000
  },
  "limits": {
    "max_command_length": 8000,
    "max_workflow_bytes": 1048576,
    "max_log_records": 20000
  },
  "policy_file": "asset-policy-rules.json",
  "exit_codes_file": "asset-exit-codes.json",
  "shell_dialects_file": "asset-shell-dialects.json",
  "skill_map_file": "asset-skill-map.json",
  "workflow_schema_file": "asset-workflow-schema.json",
  "report_template_file": "asset-report-template.md"
}
