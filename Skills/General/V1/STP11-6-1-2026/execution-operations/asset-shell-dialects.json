    "bash": "chmod {1} {2}",
    "sh": "chmod {1} {2}",
    "zsh": "chmod {1} {2}"
   },
   "unsupported_targets": [
    "cmd",
    "powershell"
   ]
  },
  {
   "id": "command-chain",
   "from": {
    "bash": "[ \\t]*&&",
    "sh": "[ \\t]*&&",
    "zsh": "[ \\t]*&&"
   },
   "to": {
