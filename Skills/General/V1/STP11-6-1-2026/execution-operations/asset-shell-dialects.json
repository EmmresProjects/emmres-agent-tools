    "zsh": " &"
   },
   "approximate": true
  },
  {
   "id": "posix-relative-path",
   "from": {
    "bash": "(?<![\\w.])\\./(?=[\\w.-])",
    "sh": "(?<![\\w.])\\./(?=[\\w.-])",
