{
 "version": "1.1.0",
 "description": "Deterministic shell-dialect translation rules for the translate operation. Rules are applied in a single left-to-right pass so a rule never re-processes another rule's output. Command-anchored rules match at line start or after a shell operator (; & |). approximate warns that the target construct is not exactly equivalent; unsupported_targets emits an explicit unsupported comment instead of a silent translation.",
 "dialects": [
  "bash",
  "sh",
  "zsh",
  "cmd",
  "powershell"
 ],
 "aliases": {
  "posix": "sh",
  "sh": "sh",
  "bash": "bash",
  "zsh": "zsh",
  "cmd": "cmd",
  "cmd.exe": "cmd",
  "powershell": "powershell",
  "pwsh": "powershell",
  "posix-sh": "sh"
 },
 "rules": [
  {
   "id": "shebang",
   "from": {
    "bash": "^#!.*\\n?",
    "sh": "^#!.*\\n?",
    "zsh": "^#!.*\\n?"
   },
   "to": {
    "cmd": "",
    "powershell": "",
    "bash": "",
    "sh": "",
    "zsh": ""
   },
   "note": "Shebang removed; the target shell is chosen by the launcher."
  },
  {
   "id": "strict-mode",
   "from": {
    "bash": "^[ \\t]*set[ \\t]+-e(uo)?[ \\t]+pipefail[ \\t]*$",
    "sh": "^[ \\t]*set[ \\t]+-e(uo)?[ \\t]+pipefail[ \\t]*$",
    "zsh": "^[ \\t]*set[ \\t]+-e(uo)?[ \\t]+pipefail[ \\t]*$"
   },
   "to": {
    "cmd": "",
    "powershell": "$ErrorActionPreference = 'Stop'",
    "bash": "set -euo pipefail",
    "sh": "set -eu",
    "zsh": "set -euo pipefail"
   },
   "note": "Strict-mode semantics are best-effort on cmd."
  },
  {
   "id": "export-var",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*export[ \\t]+([A-Za-z_][A-Za-z0-9_]*)=(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s;]*)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*export[ \\t]+([A-Za-z_][A-Za-z0-9_]*)=(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s;]*)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*export[ \\t]+([A-Za-z_][A-Za-z0-9_]*)=(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s;]*)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "set {1}={2}",
    "powershell": "$env:{1} = {2}",
    "bash": "export {1}={2}",
    "sh": "export {1}={2}",
    "zsh": "export {1}={2}"
   }
  },
  {
   "id": "env-reference",
   "from": {
    "bash": "\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}|\\$([A-Za-z_][A-Za-z0-9_]*)",
    "sh": "\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}|\\$([A-Za-z_][A-Za-z0-9_]*)",
    "zsh": "\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}|\\$([A-Za-z_][A-Za-z0-9_]*)"
   },
   "to": {
    "cmd": "%{1}%",
    "powershell": "$env:{1}",
    "bash": "${1}",
    "sh": "${1}",
    "zsh": "${1}"
   },
   "note": "Brace and bare forms are normalized to a single capture group."
  },
  {
   "id": "exit-status",
   "from": {
    "bash": "\\$\\?",
    "sh": "\\$\\?",
    "zsh": "\\$\\?"
   },
   "to": {
    "cmd": "%ERRORLEVEL%",
    "powershell": "$LASTEXITCODE",
    "bash": "$?",
    "sh": "$?",
    "zsh": "$?"
   }
  },
  {
   "id": "null-device",
   "from": {
    "bash": "/dev/null",
    "sh": "/dev/null",
    "zsh": "/dev/null"
   },
   "to": {
    "cmd": "NUL",
    "powershell": "$null",
    "bash": "/dev/null",
    "sh": "/dev/null",
    "zsh": "/dev/null"
   }
  },
  {
   "id": "list-long",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*ls(?:[ \\t]+-[A-Za-z]+)?(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*ls(?:[ \\t]+-[A-Za-z]+)?(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*ls(?:[ \\t]+-[A-Za-z]+)?(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "dir /a",
    "powershell": "Get-ChildItem -Force",
    "bash": "ls -la",
    "sh": "ls -la",
    "zsh": "ls -la"
   }
  },
  {
   "id": "print-file",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*cat[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*cat[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*cat[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "type {1}",
    "powershell": "Get-Content {1}",
    "bash": "cat {1}",
    "sh": "cat {1}",
    "zsh": "cat {1}"
   }
  },
  {
   "id": "remove-recursive",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*rm[ \\t]+-[A-Za-z]*[rf][A-Za-z]*[ \\t]+(.+?)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*rm[ \\t]+-[A-Za-z]*[rf][A-Za-z]*[ \\t]+(.+?)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*rm[ \\t]+-[A-Za-z]*[rf][A-Za-z]*[ \\t]+(.+?)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "rmdir /s /q {1}",
    "powershell": "Remove-Item -Recurse -Force {1}",
    "bash": "rm -rf {1}",
    "sh": "rm -rf {1}",
    "zsh": "rm -rf {1}"
   },
   "note": "Destructive: the approval gate still applies on every platform."
  },
  {
   "id": "copy",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*cp[ \\t]+(?:-[A-Za-z]+[ \\t]+)?([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*cp[ \\t]+(?:-[A-Za-z]+[ \\t]+)?([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*cp[ \\t]+(?:-[A-Za-z]+[ \\t]+)?([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "xcopy {1} {2} /E /I /Y",
    "powershell": "Copy-Item -Recurse -Force {1} {2}",
    "bash": "cp -r {1} {2}",
    "sh": "cp -r {1} {2}",
    "zsh": "cp -r {1} {2}"
   },
   "approximate": true
  },
  {
   "id": "move",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*mv[ \\t]+([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*mv[ \\t]+([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*mv[ \\t]+([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "move /Y {1} {2}",
    "powershell": "Move-Item -Force {1} {2}",
    "bash": "mv {1} {2}",
    "sh": "mv {1} {2}",
    "zsh": "mv {1} {2}"
   }
  },
  {
   "id": "grep",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*grep[ \\t]+(?:-r[ \\t]+)?(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*grep[ \\t]+(?:-r[ \\t]+)?(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*grep[ \\t]+(?:-r[ \\t]+)?(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "findstr /S /N {1} {2}",
    "powershell": "Select-String -Pattern {1} -Path {2}",
    "bash": "grep {1} {2}",
    "sh": "grep {1} {2}",
    "zsh": "grep {1} {2}"
   },
   "approximate": true
  },
  {
   "id": "which",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*(?:which|command -v)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*(?:which|command -v)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*(?:which|command -v)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "where {1}",
    "powershell": "Get-Command {1}",
    "bash": "which {1}",
    "sh": "command -v {1}",
    "zsh": "which {1}"
   }
  },
  {
   "id": "process-list",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*ps(?:[ \\t]+(?:aux|-ef))?(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*ps(?:[ \\t]+(?:aux|-ef))?(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*ps(?:[ \\t]+(?:aux|-ef))?(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "tasklist",
    "powershell": "Get-Process",
    "bash": "ps aux",
    "sh": "ps -ef",
    "zsh": "ps aux"
   }
  },
  {
   "id": "kill",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*kill[ \\t]+(?:-(?:9|KILL)[ \\t]+)?(\\d+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*kill[ \\t]+(?:-(?:9|KILL)[ \\t]+)?(\\d+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*kill[ \\t]+(?:-(?:9|KILL)[ \\t]+)?(\\d+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "taskkill /PID {1} /F",
    "powershell": "Stop-Process -Id {1} -Force",
    "bash": "kill -9 {1}",
    "sh": "kill -9 {1}",
    "zsh": "kill -9 {1}"
   }
  },
  {
   "id": "working-directory",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*pwd(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*pwd(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*pwd(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "cd",
    "powershell": "Get-Location",
    "bash": "pwd",
    "sh": "pwd",
    "zsh": "pwd"
   }
  },
  {
   "id": "make-dir",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*mkdir[ \\t]+-p[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*mkdir[ \\t]+-p[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*mkdir[ \\t]+-p[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "if not exist \"{1}\" mkdir \"{1}\"",
    "powershell": "New-Item -ItemType Directory -Force -Path {1} | Out-Null",
    "bash": "mkdir -p {1}",
    "sh": "mkdir -p {1}",
    "zsh": "mkdir -p {1}"
   },
   "approximate": true
  },
  {
   "id": "chmod",
   "from": {
    "bash": "(?:(?<=^)|(?<=[;&|]))[ \\t]*chmod[ \\t]+([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "sh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*chmod[ \\t]+([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))",
    "zsh": "(?:(?<=^)|(?<=[;&|]))[ \\t]*chmod[ \\t]+([^\\s;]+)[ \\t]+([^\\s;]+)(?=\\s*(?:[;&|]|$))"
   },
   "to": {
    "cmd": "REM unsupported: no POSIX mode bits on cmd",
